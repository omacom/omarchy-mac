#!/bin/bash
# Stage only this independently buildable directory. Never activate services.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for file in bin/*; do install -Dm755 "$file" "$destination/usr/bin/${file##*/}"; done
# The runtime links every command into its tree; the legacy alias keeps that path.
install -d "$destination/usr/share/omarchy/bin"
ln -sfn /usr/bin/omarchy-hw-apple "$destination/usr/share/omarchy/bin/omarchy-hw-apple"
for file in lib/*; do install -Dm755 "$file" "$destination/usr/lib/omarchy-mac/${file##*/}"; done
for file in entrypoints/*; do install -Dm755 "$file" "$destination/usr/lib/omarchy/mac/${file##*/}"; done
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type f -print0)
# Vendor enablement links (a wants link turns a user service on for everyone).
while IFS= read -r -d '' file; do
  install -d "$destination/usr/lib/$(dirname "${file#vendor/}")"
  ln -sfn "$(readlink "$file")" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type l -print0)
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/$file"
done < <(find share -type f -print0)
# A runtime older than the fixed platform root reads these from its own tree.
# Regular copies, not links: both runtimes load only regular files.
while read -r file legacy; do
  install -Dm644 "share/omarchy-platform/$file" "$destination/usr/share/omarchy/default/$legacy"
done <<'LEGACY'
hypr/defaults/apple.lua hypr/platform/defaults/apple.lua
hypr/settings/apple.lua hypr/platform/settings/apple.lua
hypr/gestures/apple-gestures.lua hypr/platform/apple-gestures.lua
key-names omarchy/platform/key-names
display-cutouts.json shell/platform/display-cutouts.json
LEGACY
for file in legacy/*; do install -Dm644 "$file" "$destination/usr/share/omarchy-mac/legacy/${file##*/}"; done
install -Dm644 LICENSE "$destination/usr/share/licenses/omarchy-mac/LICENSE"
install -Dm644 version "$destination/usr/share/omarchy-mac/version"
