#!/bin/bash
# omarchy:summary=Set up package-owned Apple Silicon services
# omarchy:hidden=true
# Optional root permits offline provisioning on the target hardware.
set -euo pipefail
root=${1:-/}
root=${root%/}
[[ -z $root || $root == /* ]] || exit 2
# A detector failure stops setup rather than reading as another platform.
platform=$(omarchy-hw-platform)
[[ $platform == "apple-silicon" ]] || exit 0
share="$root/usr/share/omarchy-mac"

# Retire only byte-identical generated files, never links (including masks).
retire() {
  local file=$1 original=$2
  if [[ -f $file && ! -L $file ]] && cmp -s "$file" "$original"; then
    if [[ -e $file.omarchy-mac-retired || -L $file.omarchy-mac-retired ]]; then
      if ! cmp -s "$file" "$file.omarchy-mac-retired"; then
        echo "Error: $file.omarchy-mac-retired differs from $file; move it aside and rerun." >&2
        return 1
      fi
      rm -- "$file"
    else
      mv -- "$file" "$file.omarchy-mac-retired"
    fi
  fi
}

retire "$root/etc/NetworkManager/conf.d/wifi_backend.conf" "$share/legacy/wifi_backend.conf"
retire "$root/etc/modprobe.d/asahi-notch.conf" "$share/legacy/asahi-notch.conf"

# The Intel Mac Broadcom quirk breaks Apple Silicon Wi-Fi, but a runtime without
# its Apple guard (migration 1786391100) appended it here. Only its exact line
# goes, with the comment block and blank line that migration wrote right above
# it; every other line stays, and a file left with only blank lines goes.
# The initramfs rebuild it owes is recorded first, under the marker the
# runtime's cleanup migration and the migration engine rebuild from.
quirk="options brcmfmac feature_disable=0x82000"
brcmfmac="$root/etc/modprobe.d/brcmfmac.conf"
if [[ -L $brcmfmac ]]; then
  if grep -Fxq -- "$quirk" "$brcmfmac" 2>/dev/null; then
    echo "Leaving $brcmfmac alone: it is a link. Remove the line \"$quirk\" where it points, then reboot." >&2
  fi
elif [[ -f $brcmfmac ]] && grep -Fxq -- "$quirk" "$brcmfmac"; then
  install -Dm644 /dev/null "$root/var/lib/omarchy/migrations/1789172112-initramfs-pending"
  kept=$(mktemp "$root/etc/modprobe.d/.brcmfmac.conf.XXXXXX")
  awk -v quirk="$quirk" \
    -v c1="# Broadcom's firmware supplicant and authenticator fail the WPA four-way" \
    -v c2="# handshake on Apple hardware, which surfaces as a rejected password. Disable" \
    -v c3="# both so wpa_supplicant performs the handshake instead." '
    { line[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        if (line[i] != quirk) continue
        drop[i] = 1
        if (i > 3 && line[i - 3] == c1 && line[i - 2] == c2 && line[i - 1] == c3) {
          drop[i - 1] = drop[i - 2] = drop[i - 3] = 1
          if (i > 4 && line[i - 4] == "") drop[i - 4] = 1
        }
      }
      for (i = 1; i <= NR; i++) if (!drop[i]) print line[i]
    }' "$brcmfmac" >"$kept" || { rm -f -- "$kept"; exit 1; }
  if grep -q '[^[:space:]]' "$kept"; then
    chown --reference="$brcmfmac" "$kept"
    chmod --reference="$brcmfmac" "$kept"
    mv -- "$kept" "$brcmfmac"
  else
    rm -f -- "$kept" "$brcmfmac"
  fi
  echo "Removed the Intel Mac Broadcom quirk from $brcmfmac; it stops applying at the next reboot"
fi

unit=omarchy-wifi-resume-fix.service
retire "$root/etc/systemd/system/$unit" "$share/legacy/$unit"
# Generated enablement links still point into /etc after the fragment retires.
# Repair only those exact links; masks and custom links remain authoritative.
if [[ ! -e $root/etc/systemd/system/$unit && ! -L $root/etc/systemd/system/$unit ]] &&
  cmp -s "$root/etc/systemd/system/$unit.omarchy-mac-retired" "$share/legacy/$unit"; then
  for target in suspend hibernate hybrid-sleep suspend-then-hibernate; do
    link="$root/etc/systemd/system/$target.target.wants/$unit"
    if [[ -L $link && $(readlink "$link") == "/etc/systemd/system/$unit" ]]; then
      ln -sfn "/usr/lib/systemd/system/$unit" "$link"
    fi
  done
fi
marker="$root/var/lib/omarchy-mac/wifi-configured"
if "$root/usr/lib/omarchy-mac/wifi-supported" && [[ ! -f $marker ]]; then
  if [[ -e $root/etc/systemd/system/$unit || -L $root/etc/systemd/system/$unit || -e $root/run/systemd/system/$unit || -L $root/run/systemd/system/$unit ]]; then
    echo "Preserving Wi-Fi unit override: $root/etc/systemd/system/$unit"
  else
    systemctl --root="${root:-/}" enable "$unit"
    install -Dm644 /dev/null "$marker"
  fi
fi

# The kernel keeps the speakers muted until speakersafetyd runs. This package is
# its only enabler: apply the vendor preset once, so earlier-sorting or
# same-name /etc presets, masks and later explicit disables stay the
# administrator's choice.
safety=speakersafetyd.service
safety_marker="$root/var/lib/omarchy-mac/speaker-safety-configured"
if [[ ! -f $safety_marker ]]; then
  if [[ ! -f $root/usr/lib/systemd/system/$safety ]]; then
    echo "Deferring speaker safety: speakersafetyd is not installed"
  elif [[ $(systemctl --root="${root:-/}" is-enabled "$safety" 2>/dev/null) == masked* ]]; then
    echo "Preserving masked speaker safety unit: $safety"
  else
    systemctl --root="${root:-/}" preset "$safety"
    install -Dm644 /dev/null "$safety_marker"
  fi
fi

if [[ -z $root && -d /run/systemd/system ]]; then
  systemctl daemon-reload
  # cat exits nonzero for an intentional mask; report it without failing setup.
  systemctl cat "$unit" || true
  NetworkManager --print-config
  modprobe --showconfig | grep -E '^options appledrm ' || true
  # A start-limit-hit after bad IV-sense data leaves the speakers locked at -100 dB.
  if systemctl is-enabled --quiet "$safety" && ! systemctl is-active --quiet "$safety"; then
    systemctl reset-failed "$safety" || true
    systemctl start "$safety" || echo "Warning: speakersafetyd did not start; the speakers stay muted." >&2
  fi
fi

# The Electron launchers and Steam's FEX launcher are the live machine's, so a
# staging root skips them. Last, so a failure here leaves the services done.
if [[ -z $root ]]; then
  "$root/usr/lib/omarchy-mac/electron-launchers"
  "$root/usr/lib/omarchy-mac/steam-launcher"
fi
