[Unit]
Description=Restart audio when it stops responding
# uwsm imports OMARCHY_PATH into the user manager before it reaches
# graphical-session.target, but pulls this unit in earlier with the session.
After=graphical-session.target pipewire.service pipewire-pulse.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecCondition=/usr/bin/omarchy-hw-apple-silicon
ExecStart=/usr/bin/omarchy-audio-watchdog --watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
