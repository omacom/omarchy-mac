#!/bin/bash
# simpledrm registers a DRM card about 0.1 s into boot and Apple's display
# controller replaces it about 3 s later. A greeter compositor that starts in
# between binds to simpledrm's connector and keeps drawing to an output that no
# longer scans out: the password field never fills in, though typing still
# reaches it and Enter still logs in. Wait for the controller's card, at most
# 10 s, and never fail the greeter.
omarchy-hw-apple-silicon || exit 0
proc=/proc
dev=/dev
if (( EUID != 0 )); then
  proc=${OMARCHY_PROC_ROOT:-/proc}
  dev=${OMARCHY_DEV_ROOT:-/dev}
fi
# Connectors are no test: simpledrm has one, and so does the GPU's own card.
# The display subsystem sits under /soc on M1-M4 and at the root on the MacBook
# Neo (A18 Pro); its card's by-path name follows the node's parent.
node=
for candidate in soc/display-subsystem display-subsystem; do
  [[ -e $proc/device-tree/$candidate ]] && { node=$candidate; break; }
done
[[ -n $node ]] || exit 0
card=$dev/dri/by-path/platform-${node//\//:}-card
for _ in {1..200}; do
  [[ -e $card ]] && break
  sleep 0.05
done
exit 0
