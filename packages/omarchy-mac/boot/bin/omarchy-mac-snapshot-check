#!/bin/bash

# omarchy:summary=Refuse to restore a snapshot the Apple Silicon boot files do not match
# omarchy:args=[<snapshot root>]
# omarchy:hidden=true
# omarchy:requires-sudo=true

# The kernel and initramfs on the ext4 boot partition, and m1n1, the device
# trees and U-Boot on the system ESP, are outside every snapshot: a restored
# root boots with the ones installed now. A snapshot is restored only when
# they match it. Nothing here writes anything but its own markers in /run.
#
# With a snapshot root it checks that the snapshot carries the kernel on /boot,
# for the subvolume swap (omarchy-system-snapshot-restore) on a Mac that still
# boots GRUB.
#
# With no argument it is limine-snapper-sync's restore hook, and acts only on a
# restore, which HOOK_CMDLINE names. It is linked twice, and the directory it
# runs from says which half it is:
#
# - /etc/boot/hooks/pre.d/04-omarchy-mac-snapshot-check, before the restore. A
#   Limine Mac restores from a snapshot it booted from the Limine menu; that
#   running root, and the kernel Limine saved with it, must pass
#   omarchy-apple-silicon-boot-check --boot-chain against the live boot files.
#   Status 100 stops the restore before it changes anything. It sorts before
#   05-omarchy-mac-limine-gate so a GRUB Mac is told why.
# - /etc/boot/hooks/post.d/99-omarchy-mac-snapshot-check, after it and after
#   limine-snapper-sync's own post hooks.
#   limine-snapper-restore's own list can put back a snapshot other than the one
#   booted, so the restored @ must hold the running root's boot files, and the
#   UKI the restore put on the ESP its kernel. Status 100 keeps the restore from
#   offering the reboot, and the message says how to undo it. Undoing it means
#   restoring again from a boot whose ESP now holds another root's boot files,
#   so the pre hook lets that restore through when the booted root fails its
#   check, and this hook checks its result. A restored root that cannot be read
#   is reported unchecked and arms no undo.

set -uo pipefail

root=${OMARCHY_BOOT_CHECK_ROOT:-}
boot_dir=${OMARCHY_BOOT_DIR:-/boot}
snapshots_dir=${OMARCHY_SNAPSHOTS_DIR:-/.snapshots}
cmdline_file=${OMARCHY_CMDLINE:-/proc/cmdline}
limine_default=${OMARCHY_LIMINE_DEFAULT:-/etc/default/limine}
# limine-snapper-sync 1.32 keeps it in /run/lock, 1.30 in /tmp.
if [[ -n ${OMARCHY_SNAPSHOT_RESTORE_LOCK:-} ]]; then
  restore_locks=("$OMARCHY_SNAPSHOT_RESTORE_LOCK")
else
  restore_locks=(/run/lock/limine-snapper-restore.lock /tmp/limine-snapper-restore.lock)
fi
top=${OMARCHY_SNAPSHOT_TOP:-}
top_parent=${OMARCHY_SNAPSHOT_TOP_DIR:-/run}
top_mounted=""
# started: when the pre hook let a restore through. undo: the backup to pick
# after a restore this Mac's boot files do not match.
state=${OMARCHY_SNAPSHOT_CHECK_STATE:-/run/omarchy-mac-snapshot-check}
boot_kver=""

why_outside() {
  cat >&2 <<'MESSAGE'

A snapshot holds the root file system only. The kernel and initramfs on the
boot partition, and m1n1, the device trees, U-Boot and Limine on the EFI system
partition, stay as they are, so a restored snapshot would boot with boot files
that do not match it. This happens when the snapshot was taken before a kernel,
boot firmware or Limine update.
MESSAGE
}

# The snapshot at $1 carries the kernel on /boot: a module tree of the
# installed Apple kernel package whose image is the one on /boot. Sets
# boot_kver to its release.
carries_boot_kernel() {
  local tree=$1 label=$2 kernel image dir found=0
  local -a versions=()
  if ! kernel=$(omarchy-mac-kernel); then
    echo "Cannot tell which Apple kernel is installed, so $label cannot be checked against the boot partition." >&2
    return 1
  fi
  image=$boot_dir/vmlinuz-$kernel
  if [[ ! -f $image ]]; then
    echo "$image is missing, so $label cannot be checked against the boot partition." >&2
    return 1
  fi
  for dir in "$tree"/usr/lib/modules/*/; do
    [[ -f $dir/pkgbase && $(<"$dir/pkgbase") == "$kernel" ]] || continue
    dir=${dir%/}
    versions+=("${dir##*/}")
    if [[ -f $dir/modules.dep ]] && cmp -s "$dir/vmlinuz" "$image"; then
      found=1
      boot_kver=${dir##*/}
    fi
  done
  (( found )) && return 0

  if (( ${#versions[@]} )); then
    echo "$label has $kernel ${versions[*]}, not the $kernel kernel on the boot partition." >&2
  else
    echo "$label has no $kernel kernel, the kernel on the boot partition." >&2
  fi
  return 1
}

# The btrfs top level, read-only: the restored @ and every snapshot are there,
# even from a snapshot boot, whose /.snapshots is an empty directory.
mount_top() {
  local uuid
  [[ -z $top ]] || return 0
  uuid=$(grep -Eo '(^|[[:space:]])root=UUID=[^[:space:]]+' "$cmdline_file" 2>/dev/null | tail -n 1 | sed 's/.*root=UUID=//')
  [[ -n $uuid ]] || return 1
  top=$(mktemp -d "$top_parent/omarchy-snapshot-top.XXXXXX") || return 1
  if ! mount -o ro,subvolid=5 "/dev/disk/by-uuid/$uuid" "$top"; then
    rmdir "$top"
    top=""
    return 1
  fi
  top_mounted=$top
  trap unmount_top EXIT
}

unmount_top() {
  if [[ -n $top_mounted ]]; then
    umount "$top_mounted" && rmdir "$top_mounted"
  fi
}

# A refused restore aborts, and a terminal opened for it closes: keep the
# explanation on screen until it has been read.
refuse() {
  if [[ -t 0 ]]; then
    read -r -t 300 -p "Press Enter to close. " _ || true
  fi
  exit 100
}

# The snapshot the running system booted, from rootflags=subvol=...
booted_snapshot() {
  local word flag
  local -a words=() flags
  [[ -r $cmdline_file ]] || return 1
  read -r -a words <"$cmdline_file" || true
  for word in "${words[@]}"; do
    [[ $word == rootflags=* ]] || continue
    IFS=, read -r -a flags <<<"${word#rootflags=}"
    for flag in "${flags[@]}"; do
      if [[ $flag =~ ^subvol=.*/\.snapshots/([0-9]+)/snapshot/?$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
      fi
    done
  done
  return 1
}

# The kernel, boot firmware and Limine packages installed in the running root.
boot_packages() {
  pacman -Q 2>/dev/null | awk '$1 ~ /^(linux-aurora|linux-asahi|m1n1-aurora|m1n1|uboot-asahi|limine)$/ { print "  " $0 }'
}

# restore, kernels <id> or nothing, from limine-snapper-sync's arguments.
restore_mode() {
  local word want_id=0 mode=""
  local -a words
  read -r -a words <<<"${HOOK_CMDLINE:-}"
  for word in "${words[@]}"; do
    if (( want_id )); then
      mode="kernels $word"
      want_id=0
      continue
    fi
    case $word in
      --restore) mode=restore ;;
      --restore-kernels)
        mode=kernels
        want_id=1
        ;;
    esac
  done
  printf '%s\n' "$mode"
}

# Only a Mac's restores are this hook's to check. A root from before the
# platform detector has only omarchy-hw-apple-silicon. Anything but a clear
# answer returns 2: the platform cannot be told, which is not waved through.
on_a_mac() {
  local platform status
  if command -v omarchy-hw-platform >/dev/null 2>&1; then
    if platform=$(omarchy-hw-platform); then
      [[ $platform == apple-silicon ]]
      return
    fi
  else
    omarchy-hw-apple-silicon
    status=$?
    (( status > 1 )) || return "$status"
  fi
  return 2
}

# Lets the restore through, noting when, so the post hook can tell the backup
# the restore makes from older snapshots.
let_through() {
  mkdir -p "$state" 2>/dev/null && : >"$state/started"
  exit 0
}

before_restore() {
  local mode number reason packages tree id platform=0 backup
  mode=$(restore_mode)
  [[ -n $mode ]] || exit 0
  on_a_mac || platform=$?
  if (( platform == 2 )); then
    echo "Cannot tell which platform this is, so the restore cannot be checked against its boot files; not restoring." >&2
    refuse
  fi
  (( platform == 0 )) || exit 0

  # Kernel files alone (snapper rollback's plugin): the snapshot's kernel must
  # be the one on /boot, or the root would boot a kernel it has no modules for.
  if [[ $mode == kernels* ]]; then
    id=${mode#kernels}
    id=${id# }
    if [[ ! $id =~ ^[0-9]+$ ]]; then
      echo "limine-snapper-sync --restore-kernels names no snapshot; not restoring kernel files on this Mac." >&2
      refuse
    fi
    tree=$snapshots_dir/$id/snapshot
    if [[ ! -d $tree/usr ]]; then
      mount_top && tree=$top/@/.snapshots/$id/snapshot
    fi
    if [[ ! -d $tree/usr ]]; then
      echo "Cannot read snapshot $id, so its kernel cannot be checked against the boot partition; not restoring its kernel files." >&2
      refuse
    fi
    if ! carries_boot_kernel "$tree" "Snapshot $id"; then
      why_outside
      refuse
    fi
    exit 0
  fi

  if ! number=$(booted_snapshot); then
    if omarchy-mac-limine-active; then
      cat >&2 <<'MESSAGE'
On a Mac, restore a snapshot from the snapshot itself: restart, open Snapshots
in the Limine menu, pick the snapshot, and run omarchy-snapshot restore once it
is up. The restore then checks that snapshot against this Mac's boot files
before it changes anything.

Snapshots taken before Limine was activated on this Mac cannot be restored.
Limine saved no kernel for most of them, so they are not in that menu, and one
that is gets refused. limine-snapper-list shows the snapshots the menu offers.
MESSAGE
    else
      cat >&2 <<'MESSAGE'
This Mac boots GRUB, so limine-snapper-restore does not apply. Restore with
omarchy-snapshot restore, which swaps the root subvolume.
MESSAGE
    fi
    refuse
  fi

  # A root from before the Limine activation would put GRUB's boot setup back
  # under Limine.
  if ! omarchy-mac-limine-active; then
    cat >&2 <<MESSAGE
Snapshot $number was taken before Limine was activated on this Mac. Restoring
it would bring back a system that boots through GRUB, so it cannot be restored.
MESSAGE
    refuse
  fi

  # Only what the next boot reads, as update-verify checks it: LUKS keyslots
  # and package file drift are not boot coherence. The running kernel is the
  # one Limine saved with the snapshot, which the restore puts back: it must be
  # the snapshot's installed kernel too, so no pending reboot is allowed.
  echo "Checking snapshot $number against this Mac's boot files"
  if ! reason=$(omarchy-apple-silicon-boot-check --boot-chain 2>&1 >/dev/null); then
    # Undoing a restore the post hook refused: the ESP holds the boot files of
    # the root it refused, so the booted root fails here too. The post hook
    # checks what this restore puts back.
    if [[ -f $state/undo ]]; then
      backup=$(<"$state/undo")
      if [[ -n $backup ]] && mount_top && [[ ! -d $top/@/.snapshots/$backup ]]; then
        backup=""
      fi
      cat <<MESSAGE
The last restore put back a root this Mac's boot files do not match, so this
one is let through to put the previous root back.
Press l and pick ${backup:+snapshot $backup, }the backup that restore made.
It is checked afterwards.
MESSAGE
      let_through
    fi
    {
      echo "Snapshot $number does not match this Mac's boot files, so it is not restored:"
      sed 's/^/  /' <<<"${reason:-omarchy-apple-silicon-boot-check failed}"
    } >&2
    why_outside
    packages=$(boot_packages)
    cat >&2 <<'MESSAGE'
Reboot into the current system, or restore a snapshot taken since that update.
To restore this one, first install its kernel, boot firmware and Limine
packages on the current system, then boot the snapshot again and restore it.
MESSAGE
    if [[ -n $packages ]]; then
      echo "This snapshot has:" >&2
      printf '%s\n' "$packages" >&2
    fi
    refuse
  fi
  echo "Snapshot $number matches this Mac's boot files"
  let_through
}

# The ESP a Limine defaults file names.
esp_path() {
  sed -n -E 's/^[[:space:]]*ESP_PATH=("([^"]*)"|'\''([^'\'']*)'\''|([^[:space:]#"'\'']*)).*/\2\3\4/p' "$1" 2>/dev/null | tail -n 1
}

# fstab's root row, also as omarchy-mac-snapshot-overlay leaves it commented out
# in a snapshot boot: device, type and options.
fstab_root() {
  awk '{ sub(/^# omarchy-mac-snapshot-overlay: /, "") } $1 !~ /^#/ && $2 == "/" { print $1, $3, $4; exit }' "$1" 2>/dev/null
}

# The first way the restored root at $1 does not boot with the live boot files,
# which the running root was checked against before the restore.
restored_mismatch() {
  local restored=$1 kernel esp uki size linux
  # As the pre hook refuses a booted root from before the Limine activation.
  if [[ ! -f $restored/var/lib/omarchy/limine.enabled || ! -f $restored/etc/default/limine || ! -x $restored/usr/bin/limine-update ]]; then
    echo "The restored root is from before Limine was activated on this Mac; it would bring back a system that boots through GRUB."
    return 0
  fi
  esp=$(esp_path "$limine_default")
  if [[ $(esp_path "$restored/etc/default/limine") != "$esp" ]]; then
    echo "The restored root's Limine writes to another ESP than the one this Mac boots."
    return 0
  fi
  carries_boot_kernel "$restored" "The restored root" 2>&1 || return 0
  # The boot check held the booted root's crypttab and root mount against the
  # Limine command line; a root from before encryption differs here.
  if [[ -e $root/etc/crypttab || -e $restored/etc/crypttab ]] && ! cmp -s "$root/etc/crypttab" "$restored/etc/crypttab"; then
    echo "The restored root's /etc/crypttab is not the one the Limine command line unlocks."
    return 0
  fi
  if [[ $(fstab_root "$root/etc/fstab") != "$(fstab_root "$restored/etc/fstab")" ]]; then
    echo "The restored root mounts / differently from the root the Limine command line boots."
    return 0
  fi
  if ! diff -rq "$root/usr/lib/modules/$boot_kver/dtbs" "$restored/usr/lib/modules/$boot_kver/dtbs" >/dev/null 2>&1; then
    echo "The restored root's $boot_kver device trees are not the ones in m1n1 on the ESP."
    return 0
  fi
  if ! diff -rq "$root/usr/lib/asahi-boot" "$restored/usr/lib/asahi-boot" >/dev/null 2>&1; then
    echo "The restored root's m1n1 or U-Boot is not the one on the ESP."
    return 0
  fi
  if ! cmp -s "$root/usr/share/limine/BOOTAA64.EFI" "$restored/usr/share/limine/BOOTAA64.EFI"; then
    echo "The restored root's Limine is not the one on the ESP."
    return 0
  fi
  if ! kernel=$(omarchy-mac-kernel 2>/dev/null); then
    echo "Cannot tell which Apple kernel is installed."
    return 0
  fi
  uki=$root$esp/EFI/Linux/omarchy_$kernel.efi
  if [[ -z $esp || ! -f $uki ]]; then
    echo "The restore left no Limine UKI at ${esp:-the ESP}/EFI/Linux/omarchy_$kernel.efi."
    return 0
  fi
  if ! linux=$(mktemp); then
    echo "Cannot make a scratch file to read the restored UKI."
    return 0
  fi
  size=$(stat -c %s "$boot_dir/vmlinuz-$kernel")
  if ! objcopy -O binary --only-section=.linux "$uki" "$linux" 2>/dev/null ||
    (( $(stat -c %s "$linux") < size )) || ! cmp -s -n "$size" "$boot_dir/vmlinuz-$kernel" "$linux"; then
    echo "The UKI the restore put on the ESP does not carry the restored root's $boot_kver kernel."
    rm -f "$linux"
    return 0
  fi
  rm -f "$linux"
  return 1
}

after_restore() {
  local lock restored="" reason="" unchecked="" backup="" platform=0
  [[ $(restore_mode) == restore ]] || exit 0
  # Only a lock the hook's own user owns: /tmp is anyone's.
  for lock in "${restore_locks[@]}"; do
    if [[ -f $lock && -O $lock && $(<"$lock") == restored ]]; then
      restored=1
    fi
  done
  [[ -n $restored ]] || exit 0
  on_a_mac || platform=$?
  (( platform != 1 )) || exit 0

  if (( platform == 2 )); then
    unchecked="Cannot tell which platform this is."
  elif ! mount_top; then
    unchecked="Cannot read the btrfs top level the restored root is on."
  elif [[ ! -d $top/@/usr ]]; then
    unchecked="The restore left no root subvolume @ to read."
  else
    reason=$(restored_mismatch "$top/@")
  fi

  # Only a root found not to match arms the undo: one that could not be read
  # must not let the next restore skip its check.
  if [[ -n $unchecked ]]; then
    {
      echo "The restored root was not checked against this Mac's boot files:"
      printf '  %s\n' "$unchecked"
    } >&2
    cat >&2 <<'MESSAGE'
Nothing proves it boots with the boot files outside it. If the Mac does not
boot it, pick the backup this restore made under Snapshots in the Limine menu,
and restore that.
MESSAGE
    exit 100
  fi
  if [[ -z $reason ]]; then
    rm -f "$state/undo"
    echo "The restored root matches this Mac's boot files"
    exit 0
  fi

  # The backup is the snapshot the restore wrote since the pre hook let it through.
  if [[ -f $state/started && -n $top ]]; then
    backup=$(find "$top/@/.snapshots" -mindepth 2 -maxdepth 2 -name info.xml -newer "$state/started" -printf '%h\n' 2>/dev/null |
      sed 's|.*/||' | grep -E '^[0-9]+$' | sort -n | tail -n 1)
  fi
  mkdir -p "$state" 2>/dev/null && printf '%s\n' "$backup" >"$state/undo"
  {
    echo "The restore put back a root this Mac's boot files do not match:"
    printf '  %s\n' "$reason"
  } >&2
  why_outside
  cat >&2 <<MESSAGE
Do not reboot yet. Only the snapshot booted from the Limine menu is checked
before a restore, and this one was picked from the restore's own list.
To put the previous root back, run omarchy-snapshot restore again, press l,
and pick ${backup:+snapshot $backup, }the backup this restore just made.
To restore another snapshot, boot it from the Limine menu and restore it there.
Ignore the "Please reboot manually" that limine-snapper-restore prints next.
MESSAGE
  exit 100
}

case $# in
  0)
    case ${0%/*} in
      */post.d) after_restore ;;
      *) before_restore ;;
    esac
    ;;
  1)
    case $1 in
      -h | --help)
        echo "Usage: omarchy-mac-snapshot-check [<snapshot root>]"
        exit 0
        ;;
    esac
    if ! carries_boot_kernel "$1" "This snapshot"; then
      why_outside
      cat >&2 <<'MESSAGE'
Restore a snapshot taken with the current kernel. To restore this one, first
install its kernel package on the current system, then restore it.
MESSAGE
      exit 1
    fi
    ;;
  *)
    echo "Usage: omarchy-mac-snapshot-check [<snapshot root>]" >&2
    exit 2
    ;;
esac
