#!/bin/bash -p

# omarchy-lifecycle-dispatch provision-verify. Succeeds only when this Mac's
# boot chain can no longer unlock the root with the staged install key: no key
# on the boot partition, no rd.luks.key= for the loader, and encrypt.state
# finished (or declined, or absent). Read-only.

set -euo pipefail

# Root reads only the live system and a fixed PATH; unprivileged tests may
# stage the package under a fixture root.
MAC_BOOT_ROOT=""
if (( EUID == 0 )); then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
else
  MAC_BOOT_ROOT=${OMARCHY_MAC_BOOT_ROOT:-}
fi
source "$MAC_BOOT_ROOT/usr/lib/omarchy-mac/boot/provision.sh"
provision_verify
