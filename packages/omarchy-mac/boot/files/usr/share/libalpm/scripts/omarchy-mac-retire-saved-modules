#!/bin/bash
# 11-omarchy-mac-saved-modules.hook, right after kernel-modules-hook's
# 10-linux-modules-post.hook. That hook puts the running kernel's modules back
# in /usr/lib/modules, owned by no package, until linux-modules-cleanup moves
# them to /usr/lib/modules/.old at the next boot. After a downgrade (a channel
# move, a reinstall from the cache, a migration to an older kernel) that copy
# is the newest -ARCH directory, so update-m1n1's ALARM default, which
# 95-m1n1-install.hook runs later in this transaction, would build m1n1 stage
# 2 with the running kernel's device trees and the boot check would refuse the
# reboot. Exactly then, this makes the cleanup's move now; anything else is
# left for the boot check to judge. pacman holds its lock for the whole
# transaction, so nothing reinstalls that kernel in between.

set -uo pipefail

modules=/usr/lib/modules

# Fixtures give an unprivileged caller another root; as root, which pacman
# hooks always are, the live system decides.
root=""
pacman_args=()
if (( EUID != 0 )) && [[ -n ${OMARCHY_SAVED_MODULES_ROOT:-} ]]; then
  root=${OMARCHY_SAVED_MODULES_ROOT%/}
  pacman_args=(--root "$root" --dbpath "$root/var/lib/pacman/")
fi

# pacman writes the targets to a pipe and fails the write if the hook has gone.
installed=()
while IFS= read -r target; do
  [[ ! $target =~ ^usr/lib/modules/([^/]+)/vmlinuz$ ]] || installed+=("${BASH_REMATCH[1]}")
done

running=$(uname -r) || exit 0
[[ $running =~ ^[A-Za-z0-9._+-]+$ ]] || exit 0
saved=$modules/$running
[[ -d $root$saved && ! -L $root$saved ]] || exit 0
pacman "${pacman_args[@]}" -Qq kernel-modules-hook >/dev/null 2>&1 || exit 0

# The directory update-m1n1's default picks is the running kernel's, and the
# one this transaction installed is what it picks once that is gone.
mapfile -t newest < <(
  for match in "$root$modules"/*-ARCH; do
    [[ ! -e $match && ! -L $match ]] || printf '%s\n' "${match##*/}"
  done | sort -rV
)
(( ${#newest[@]} >= 2 )) && [[ ${newest[0]} == "$running" && " ${installed[*]} " == *" ${newest[1]} "* ]] || exit 0
owner=$(LC_ALL=C pacman "${pacman_args[@]}" -Qqo "$root$saved" 2>&1) && exit 0
[[ $owner == *"No package owns"* ]] || exit 0

# Only when update-m1n1 takes its device trees from that default.
script=$root/usr/bin/update-m1n1
[[ -r $script ]] && grep -Eq '^[[:space:]]*:[[:space:]]+\$\{DTBS:=.*/modules/\*-ARCH' "$script" || exit 0
config=$root/etc/default/update-m1n1
if [[ -e $config ]]; then
  configured=$(env -i PATH=/usr/bin:/bin bash --noprofile --norc -c '
    unset DTBS M1N1_UPDATE_DISABLED
    . "$1" >/dev/null 2>&1 || exit 1
    printf "%s" "${DTBS-}${M1N1_UPDATE_DISABLED-}"
  ' _ "$config") || exit 0
  [[ -z $configured ]] || exit 0
fi

echo "Moving the running kernel's saved modules ($running) to $modules/.old, as linux-modules-cleanup does at boot, so m1n1 carries the device trees of ${newest[1]}. Reboot soon: until then the running kernel cannot load modules it has not loaded yet."
rsync -AHXal "$root$saved" "$root$modules/.old/" || {
  echo "Could not copy $saved to $modules/.old; nothing was removed, and m1n1 will carry the running kernel's device trees until the reboot" >&2
  exit 1
}
rm -rf "$root$saved" || {
  echo "Could not remove $saved after copying it to $modules/.old" >&2
  exit 1
}
