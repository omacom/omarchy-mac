#!/bin/bash

# omarchy:summary=Set or show the Apple Silicon battery charge limit
# omarchy:args=[80|100]
# omarchy:examples=omarchy battery charge limit | omarchy battery charge limit 80 | omarchy battery charge limit 100

set -euo pipefail

battery_path="/sys/class/power_supply/macsmc-battery"
start_file="$battery_path/charge_control_start_threshold"
end_file="$battery_path/charge_control_end_threshold"
# asahi-scripts saves and restores the limit through this same file, so both
# mechanisms agree on one saved value.
saved_file="/etc/udev/macsmc-battery.conf"

usage() {
  echo "Usage: omarchy battery charge limit [80|100]" >&2
  exit 2
}

write_as_root() {
  if (( EUID == 0 )); then
    /usr/bin/tee "$1" >/dev/null
  else
    sudo /usr/bin/tee "$1" >/dev/null
  fi
}

(( $# <= 1 )) || usage
limit="${1:-status}"
case "$limit" in
  status | 80 | 100) ;;
  *) usage ;;
esac

if ! platform=$(omarchy-hw-platform) || [[ $platform != "apple-silicon" ]]; then
  echo "The battery charge limit is only available on Apple Silicon Macs." >&2
  exit 1
fi

if [[ ! -r $start_file || ! -r $end_file ]]; then
  echo "Apple Silicon charge thresholds are not available on this system." >&2
  exit 1
fi

if [[ $limit == "status" ]]; then
  printf 'Charge limit: %s%% (restart charging at %s%%)\n' "$(<"$end_file")" "$(<"$start_file")"
else
  if [[ $limit == "80" ]]; then
    expected_start=75
  else
    expected_start=100
  fi

  # The driver derives the start threshold from the end threshold and ignores
  # writes to the start threshold.
  printf '%s\n' "$limit" | write_as_root "$end_file"

  actual_start=$(<"$start_file")
  actual_end=$(<"$end_file")
  if [[ $actual_start != $expected_start || $actual_end != $limit ]]; then
    echo "Charge threshold update did not stick; the SMC reports ${actual_start}%/${actual_end}%." >&2
    exit 1
  fi

  if ! printf 'CHARGE_CONTROL_END_THRESHOLD=%s\n' "$limit" | write_as_root "$saved_file"; then
    echo "Charge limit set to ${limit}%, but it could not be saved for the next boot." >&2
    exit 1
  fi

  printf 'Charge limit set to %s%% (restart charging at %s%%).\n' "$actual_end" "$actual_start"
fi
