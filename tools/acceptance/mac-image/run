#!/bin/bash
# Boot a built Mac image in a KVM guest and prove its first boots.
#
# The image is what the installer app writes to a Mac: an ESP tree, boot.img
# (ext4, GRUB + kernel + initramfs) and root.img (btrfs). This harness assembles
# them into one GPT disk and boots it twice over:
#
#   plain      install.conf encrypt=0 on the ESP: first boot finishes without
#              touching the root and hands off to owner provisioning
#   encrypted  no install.conf (the app's default, encrypt=1): the initrd unit
#              converts the root to LUKS2 in place, regenerates GRUB and the
#              initramfs, continues into /dev/mapper/root and finishes first
#              boot; a second boot unlocks through sd-encrypt with the key the
#              GRUB cmdline names
#
# The Aurora kernel has no PL011 console, generic PCI host or ACPI, so it cannot
# run on QEMU's virt machine. The guest boots a generic Arch Linux ARM kernel
# instead, with an initramfs built inside the image's own root from the image's
# own mkinitcpio configuration (asahi, omarchy-vendorfw, omarchy-mac-encrypt,
# sd-encrypt hooks): the units under test are the image's, the kernel is not.
# GRUB itself and the Apple hardware are qualified on a real Mac.
#
# Runs on an aarch64 Linux host with /dev/kvm, qemu-system-aarch64, losetup,
# btrfs-progs, dosfstools, gptfdisk, overlayfs and passwordless sudo.
#
#   test/vm/mac-image/run --release mac-image-10-rc-… [--repo maralcbr/omarchy-pkgs]
#   test/vm/mac-image/run --payload omarchy-….zip --lane rc
#
# Evidence goes to ~/vm-evidence/mac-image-<run-id>/ (run.txt, serial logs).

set -euo pipefail

root=$(cd "$(dirname "$0")/../../.." && pwd)
repo=${OMARCHY_VM_IMAGE_REPO:-maralcbr/omarchy-pkgs}
release=""
image_file=""
payload=""
lane=""
keep=0
only=""
run_id=${OMARCHY_VM_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}
state=${OMARCHY_VM_IMAGE_STATE_DIR:-$HOME/vm-mac-image}
evidence_root=${OMARCHY_VM_EVIDENCE_DIR:-$HOME/vm-evidence}
alarm_mirror=${OMARCHY_VM_ALARM_MIRROR:-'https://downloads.aicodelabs.com.au/mirror/alarm/20260906/$repo/os/$arch'}
signing_key=${OMARCHY_VM_IMAGE_KEY_FILE:-$root/default/omarchy-arm-repository.asc}
vm_memory_mb=${OMARCHY_VM_MEMORY_MB:-8192}
vm_cpus=${OMARCHY_VM_CPUS:-8}
boot_timeout=${OMARCHY_VM_IMAGE_BOOT_TIMEOUT:-900}
disk_gib=${OMARCHY_VM_IMAGE_DISK_GIB:-35}
ESP_UUID=4F4D-5801
BOOT_UUID=4f4d5801-424f-4f54-8000-000000000001
ROOT_UUID=4f4d5801-524f-4f54-8000-000000000001

while (($#)); do
  case "$1" in
    --release) (($# >= 2)) || { echo "--release needs a tag" >&2; exit 1; }; release=$2; shift ;;
    --repo) (($# >= 2)) || { echo "--repo needs owner/name" >&2; exit 1; }; repo=$2; shift ;;
    --payload) (($# >= 2)) || { echo "--payload needs a zip" >&2; exit 1; }; payload=$2; shift ;;
    --lane) (($# >= 2)) || { echo "--lane needs edge, rc or stable" >&2; exit 1; }; lane=$2; shift ;;
    --only) (($# >= 2)) || { echo "--only needs plain or encrypted" >&2; exit 1; }; only=$2; shift ;;
    --keep) keep=1 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

fail() { echo "not ok - $*" >&2; exit 1; }
say() { echo "==> $*"; }
ok() { echo "ok - $*"; echo "ok - $*" >>"$evidence_dir/run.txt"; }

[[ -n $release || -n $payload ]] || fail "give --release TAG or --payload ZIP"
[[ -z $release || -z $payload ]] || fail "--release and --payload are exclusive"
[[ -z $only || $only == plain || $only == encrypted ]] || fail "--only takes plain or encrypted"
[[ $run_id =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || fail "OMARCHY_VM_RUN_ID must be 1-64 letters, digits, dots, dashes or underscores"
[[ $vm_cpus =~ ^[1-9][0-9]*$ && $vm_memory_mb =~ ^[1-9][0-9]*$ && $boot_timeout =~ ^[1-9][0-9]*$ && $disk_gib =~ ^[1-9][0-9]*$ ]] ||
  fail "OMARCHY_VM_CPUS, OMARCHY_VM_MEMORY_MB, OMARCHY_VM_IMAGE_BOOT_TIMEOUT and OMARCHY_VM_IMAGE_DISK_GIB must be positive integers"
[[ $alarm_mirror == https://* && $alarm_mirror == *'$repo'* && $alarm_mirror == *'$arch'* ]] ||
  fail 'OMARCHY_VM_ALARM_MIRROR must be an https URL containing $repo and $arch'
[[ $(uname -m) == aarch64 ]] || fail "this harness boots aarch64 guests on an aarch64 KVM host"
[[ -r /dev/kvm ]] || fail "/dev/kvm is not readable"
for tool in qemu-system-aarch64 sgdisk mkfs.vfat losetup btrfs bsdtar sha256sum gpg curl awk sed mount umount chroot lsinitcpio \
    truncate stat dd blkid tee realpath; do
  command -v "$tool" >/dev/null || fail "missing tool: $tool"
done
[[ -z $release ]] || command -v gh >/dev/null || fail "missing tool: gh (needed for --release)"
sudo -n true 2>/dev/null || fail "passwordless sudo is required (losetup, mounts, chroot)"
[[ -f $signing_key ]] || fail "signing key $signing_key is missing"

# A failed run's directory is kept and a passing one's deleted, so evidence
# must never live beneath the state directory.
state_real=$(realpath -m -- "$state")
evidence_root=$(realpath -m -- "$evidence_root")
[[ $evidence_root != "$state_real" && $evidence_root != "$state_real"/* ]] ||
  fail "the evidence directory $evidence_root is inside the state directory $state_real"
work=$state/runs/$run_id
evidence_dir=$evidence_root/mac-image-$run_id
mkdir -p "$work" "$evidence_dir"
: >"$evidence_dir/run.txt"
loops=()
mounts=()
qemu_pid=""

cleanup() {
  local status=$?
  [[ -z $qemu_pid ]] || kill "$qemu_pid" 2>/dev/null || true
  local m
  for ((i = ${#mounts[@]} - 1; i >= 0; i--)); do
    m=${mounts[$i]}
    sudo umount -R "$m" 2>/dev/null || sudo umount "$m" 2>/dev/null || true
  done
  for l in "${loops[@]+"${loops[@]}"}"; do
    sudo losetup -d "$l" 2>/dev/null || true
  done
  if ((status == 0 && keep == 0)); then
    sudo rm -rf "$work"
  else
    echo "run directory kept: $work" >&2
  fi
}
trap cleanup EXIT

# ── the image ────────────────────────────────────────────────────────────────
fetch_release() {
  say "fetching $release from $repo"
  mkdir -p "$work/release"
  gh release download "$release" -R "$repo" --dir "$work/release" --pattern 'IMAGE' --pattern 'IMAGE.sig' \
    --pattern 'PROVENANCE' --pattern 'installer_data.json' --pattern '*.zip' --pattern '*.zip.part*' ||
    fail "could not download $release"
  local home
  home=$(mktemp -d)
  gpg --batch --homedir "$home" --import "$signing_key" 2>/dev/null
  gpg --batch --homedir "$home" --verify "$work/release/IMAGE.sig" "$work/release/IMAGE" 2>/dev/null ||
    fail "IMAGE.sig does not verify with $signing_key"
  rm -rf "$home"
  image_file=$work/release/IMAGE
  lane=$(sed -n 's/^lane=//p' "$image_file")
  [[ $lane == edge || $lane == rc || $lane == stable ]] || fail "IMAGE names no lane"
  local name size digest line
  line=$(sed -n 's/^payload=//p' "$work/release/PROVENANCE")
  [[ -n $line ]] || fail "PROVENANCE has no payload line"
  IFS='|' read -r name size digest <<<"$line"
  [[ $name =~ ^omarchy-[0-9]{4}\.[0-9]{2}\.[0-9]{2}-aarch64-apple-silicon-mac-$lane-os-package\.zip$ && $size =~ ^[1-9][0-9]*$ && $digest =~ ^[0-9a-f]{64}$ ]] ||
    fail "PROVENANCE names no $lane Mac image payload"
  payload=$work/release/$name
  if [[ ! -f $payload ]]; then
    local parts=()
    for part in "$payload".part[0-9][0-9]; do [[ -f $part ]] && parts+=("$part"); done
    ((${#parts[@]} >= 2)) || fail "$release holds neither $name nor its parts"
    cat "${parts[@]}" >"$payload"
    rm -f "${parts[@]}"
  fi
  [[ $(stat -c %s "$payload") == "$size" ]] || fail "$name is $(stat -c %s "$payload") bytes, PROVENANCE says $size"
  [[ $(sha256sum "$payload" | awk '{ print $1 }') == "$digest" ]] || fail "$name does not match the PROVENANCE digest"
  ok "$release: IMAGE signed by the repository key; $name matches PROVENANCE ($size bytes); members checked against IMAGE after unpacking"
}

# IMAGE (the signed file) digests every payload member; PROVENANCE does not
# sign anything, so the unpacked members are held to IMAGE.
verify_members() {
  local line path digest count=0
  while IFS= read -r line; do
    IFS='|' read -r path digest <<<"$line"
    [[ $path == boot.img || $path == root.img || $path == omarchy-volume.icns || $path == esp/* ]] || fail "IMAGE names an unexpected member $path"
    [[ -f $work/payload/$path ]] || fail "payload lacks $path, which IMAGE names"
    [[ $(sha256sum "$work/payload/$path" | awk '{ print $1 }') == "$digest" ]] || fail "$path does not match IMAGE"
    count=$((count + 1))
  done < <(sed -n 's/^image_sha256=//p' "$image_file")
  ((count >= 4)) || fail "IMAGE digests fewer than four members"
  local input_digest
  input_digest=$(sed -n 's/^input_digest=//p' "$image_file")
  [[ $input_digest =~ ^[0-9a-f]{64}$ ]] || fail "IMAGE has no input_digest"
  echo "input_digest=$input_digest" >>"$evidence_dir/run.txt"
  ok "every member IMAGE names matches its digest ($count members)"
}

unpack_payload() {
  [[ -f $payload ]] || fail "payload $payload is missing"
  if [[ -z $lane ]]; then
    [[ ${payload##*/} =~ -mac-(edge|rc|stable)-os-package\.zip$ ]] && lane=${BASH_REMATCH[1]} || fail "--lane is needed for $payload"
  fi
  say "unpacking ${payload##*/} (lane $lane)"
  mkdir -p "$work/payload"
  (cd "$work/payload" && bsdtar -xf "$payload") || fail "could not unpack the payload"
  for f in esp/EFI/BOOT/BOOTAA64.EFI esp/m1n1/boot.bin boot.img root.img; do
    [[ -f $work/payload/$f ]] || fail "payload lacks $f"
  done
  [[ $(sudo blkid -c /dev/null -o value -s UUID "$work/payload/boot.img") == "$BOOT_UUID" ]] || fail "boot.img UUID"
  [[ $(sudo blkid -c /dev/null -o value -s UUID "$work/payload/root.img") == "$ROOT_UUID" ]] || fail "root.img UUID"
  echo "payload_sha256=$(sha256sum "$payload" | awk '{ print $1 }')" >>"$evidence_dir/run.txt"
  ok "payload unpacked: ESP tree, boot.img ($BOOT_UUID), root.img ($ROOT_UUID)"
  [[ -z $image_file ]] || verify_members
}

# ── the generic kernel and the image's own initramfs ────────────────────────
# Sets ATTACHED; a command substitution would lose the bookkeeping.
attach() {
  ATTACHED=$(sudo losetup -f --show "$@") || fail "losetup $*"
  loops+=("$ATTACHED")
}

detach_last() {
  ((${#loops[@]})) || return 0
  sudo losetup -d "${loops[-1]}" || fail "losetup -d ${loops[-1]}"
  unset 'loops[-1]'
}

mount_tracked() {
  sudo mount "$@" || fail "mount $*"
  mounts+=("${@: -1}")
}

umount_last() {
  ((${#mounts[@]})) || return 0
  sudo umount -R "${mounts[-1]}" 2>/dev/null || sudo umount "${mounts[-1]}" || fail "umount ${mounts[-1]}"
  unset 'mounts[-1]'
}

build_generic_kernel() {
  say "building the generic ALARM kernel and an initramfs from the image's mkinitcpio hooks"
  mkdir -p "$work/generic" "$work/dl"
  local db_url pkg
  db_url=${alarm_mirror//\$repo/core}; db_url=${db_url//\$arch/aarch64}
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --retry 3 -o "$work/dl/core.db" "$db_url/core.db" ||
    fail "could not fetch core.db from the snapshot"
  pkg=$({ bsdtar -xOf "$work/dl/core.db" --include='linux-aarch64-[0-9]*/desc' 2>/dev/null || true; } |
    awk '/%FILENAME%/ { getline; print; exit }')
  [[ $pkg == linux-aarch64-*.pkg.tar.* ]] || fail "the snapshot's core.db lists no linux-aarch64"
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --retry 3 -o "$work/dl/$pkg" "$db_url/$pkg" ||
    fail "could not fetch $pkg"
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --retry 3 -o "$work/dl/$pkg.sig" "$db_url/$pkg.sig" ||
    fail "could not fetch $pkg.sig"
  local home
  home=$(mktemp -d)
  # The snapshot's packages carry Arch Linux ARM's builder signature; the keyring
  # package inside the image root holds the same keys.
  local rootdev lower=$work/lower merged=$work/merged
  attach -r "$work/payload/root.img"; rootdev=$ATTACHED
  mkdir -p "$lower" "$merged" "$work/upper" "$work/overlay-work"
  mount_tracked -o ro,subvol=@ "$rootdev" "$lower"
  mount_tracked -t overlay overlay -o "lowerdir=$lower,upperdir=$work/upper,workdir=$work/overlay-work" "$merged"
  gpg --batch --homedir "$home" --import "$lower"/usr/share/pacman/keyrings/archlinuxarm.gpg 2>/dev/null ||
    fail "the image root has no archlinuxarm keyring"
  gpg --batch --homedir "$home" --trust-model always --verify "$work/dl/$pkg.sig" "$work/dl/$pkg" 2>/dev/null ||
    fail "$pkg is not signed by an Arch Linux ARM key"
  rm -rf "$home"
  for d in dev proc sys; do
    sudo mount --rbind "/$d" "$merged/$d" && sudo mount --make-rslave "$merged/$d" || fail "bind /$d"
    mounts+=("$merged/$d")
  done
  mount_tracked -t tmpfs tmpfs "$merged/tmp"
  sudo cp "$work/dl/$pkg" "$merged/tmp/kernel.pkg.tar.xz"
  local image_kernel
  image_kernel=$(ls "$lower/usr/lib/modules")
  [[ $(wc -l <<<"$image_kernel") == 1 ]] || fail "the image root holds more than one kernel: $image_kernel"
  sudo chroot "$merged" bash -euo pipefail -c '
    bsdtar -xf /tmp/kernel.pkg.tar.xz -C / --exclude=.PKGINFO --exclude=.MTREE --exclude=.BUILDINFO --exclude=.INSTALL
    ver=$(ls /usr/lib/modules | grep -vx "$1" | head -n 1)
    [[ -n $ver ]] || { echo "no generic kernel version" >&2; exit 1; }
    depmod "$ver"
    mkinitcpio -k "$ver" -S autodetect -g /tmp/initramfs-generic.img >/tmp/mkinitcpio.log 2>&1 ||
      { tail -n 30 /tmp/mkinitcpio.log >&2; exit 1; }
    grep -q "Running build hook: \[omarchy-mac-encrypt\]" /tmp/mkinitcpio.log
    grep -q "Running build hook: \[asahi\]" /tmp/mkinitcpio.log
    cp /boot/Image /tmp/Image-generic
    printf "%s\n" "$ver" >/tmp/generic.version
  ' bash "$image_kernel" || fail "the generic initramfs did not build inside the image root"
  sudo cp "$merged/tmp/Image-generic" "$merged/tmp/initramfs-generic.img" "$merged/tmp/generic.version" "$merged/tmp/mkinitcpio.log" "$work/generic/"
  sudo chown "$(id -u):$(id -g)" "$work/generic"/*
  local hook_files
  hook_files=$(lsinitcpio "$work/generic/initramfs-generic.img" | grep -c 'omarchy-mac-encrypt') || true
  ((hook_files >= 3)) || fail "the generic initramfs carries no omarchy-mac-encrypt unit"
  lsinitcpio "$work/generic/initramfs-generic.img" | grep -q 'keydev\\x2droot.mount.d' ||
    fail "the generic initramfs lacks the sd-encrypt key-mount ordering drop-in"
  cp "$work/generic/mkinitcpio.log" "$evidence_dir/"
  while ((${#mounts[@]})); do umount_last; done
  detach_last
  ok "generic kernel $(cat "$work/generic/generic.version") + initramfs from the image's hooks (image kernel $image_kernel)"
}

# ── the disk ─────────────────────────────────────────────────────────────────
make_disk() {
  local disk=$1 install_conf=${2:-}
  say "assembling $disk"
  rm -f "$disk"
  truncate -s "${disk_gib}G" "$disk"
  sgdisk -o -n1:0:+512M -t1:ef00 -c1:EFI -n2:0:+2G -t2:8300 -c2:BOOT -n3:0:0 -t3:8300 -c3:ROOT "$disk" >/dev/null ||
    fail "sgdisk"
  local dev
  attach -P "$disk"; dev=$ATTACHED
  sudo mkfs.vfat -F 32 -i "${ESP_UUID/-/}" -n OMARCHY_EFI "${dev}p1" >/dev/null || fail "mkfs.vfat"
  mkdir -p "$work/esp-mnt"
  mount_tracked "${dev}p1" "$work/esp-mnt"
  sudo cp -r "$work/payload/esp/." "$work/esp-mnt/"
  sudo mkdir -p "$work/esp-mnt/omarchy"
  if [[ -n $install_conf ]]; then
    printf '%s' "$install_conf" | sudo tee "$work/esp-mnt/omarchy/install.conf" >/dev/null
  fi
  umount_last
  sudo dd if="$work/payload/boot.img" of="${dev}p2" bs=4M conv=sparse,fsync status=none || fail "dd boot.img"
  sudo dd if="$work/payload/root.img" of="${dev}p3" bs=4M conv=sparse,fsync status=none || fail "dd root.img"
  detach_last
}

# ── the guest ────────────────────────────────────────────────────────────────
boot_guest() {
  local disk=$1 log=$2 append=$3
  rm -f "$log"
  qemu-system-aarch64 -M virt,accel=kvm,gic-version=host -cpu host -m "$vm_memory_mb" -smp "$vm_cpus" \
    -kernel "$work/generic/Image-generic" -initrd "$work/generic/initramfs-generic.img" \
    -append "$append console=ttyAMA0,115200 loglevel=7 systemd.journald.forward_to_console=1 zswap.enabled=0" \
    -drive "file=$disk,format=raw,if=none,id=d0,cache=writeback" -device virtio-blk-pci,drive=d0,romfile= \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0,romfile= \
    -device virtio-rng-pci -device qemu-xhci -device usb-kbd \
    -display none -serial "file:$log" -monitor none -pidfile "$work/qemu.pid" &
  qemu_pid=$!
}

wait_serial() {
  local log=$1 pattern=$2 what=$3 waited=0
  until grep -aq -- "$pattern" "$log" 2>/dev/null; do
    kill -0 "$qemu_pid" 2>/dev/null || fail "$what: the guest exited (see $log)"
    ((waited < boot_timeout)) || fail "$what: not seen within ${boot_timeout}s (see $log)"
    sleep 5; waited=$((waited + 5))
  done
}

# First boot removes install.conf from the vfat ESP without a sync (a persisted
# copy on the root already won, and a retry deletes it again), so the unlink
# sits in the page cache until writeback. Give it the writeback interval
# before the guest is stopped.
settle_guest() {
  local waited=0
  while ((waited < 40)); do
    kill -0 "$qemu_pid" 2>/dev/null || fail "the guest exited while settling"
    sleep 5; waited=$((waited + 5))
  done
}

stop_guest() {
  kill "$qemu_pid" 2>/dev/null || true
  wait "$qemu_pid" 2>/dev/null || true
  qemu_pid=""
}

root_append="root=UUID=$ROOT_UUID rw rootflags=subvol=@ rootfstype=btrfs"

# The guest is stopped with SIGTERM (owner provisioning holds tty1, so a
# power-key shutdown never completes), which leaves ext4 and btrfs journals to
# replay. The units fsync what they record, and on btrfs an fsync lands in the
# tree-log: only a replay makes it visible. The disks are therefore attached
# read-write and mounted read-only, which lets the kernel replay both journals.
# ── plain first boot ─────────────────────────────────────────────────────────
plain_boot() {
  local disk=$work/plain.img log=$evidence_dir/plain-serial.log
  make_disk "$disk" $'format=1\nencrypt=0\nlane='"$lane"$'\n'
  say "plain first boot"
  boot_guest "$disk" "$log" "$root_append"
  wait_serial "$log" "install.conf sets encrypt=0" "plain: the encrypt unit read install.conf"
  wait_serial "$log" "Finished Omarchy first boot" "plain: first boot"
  wait_serial "$log" "Starting Omarchy provisioning first-boot user setup" "plain: owner provisioning"
  ! grep -aq "Failed to start Omarchy first boot" "$log" || fail "plain: first boot reported a failure"
  settle_guest
  stop_guest
  local dev
  attach -P "$disk"; dev=$ATTACHED
  mkdir -p "$work/mnt"
  [[ $(sudo blkid -c /dev/null -o value -s TYPE "${dev}p3") == btrfs ]] || fail "plain: the root is no longer plain btrfs"
  mount_tracked -o ro,subvol=@ "${dev}p3" "$work/mnt"
  local st=$work/mnt/var/lib/omarchy/mac-first-boot
  sudo test ! -e "$st/pending" || fail "plain: first boot left its pending marker"
  sudo test -f "$st/install.conf" && sudo grep -qx 'encrypt=0' "$st/install.conf" || fail "plain: install.conf was not persisted"
  sudo grep -q '^master=[0-9A-F]\{40\}$' "$st/keyring" || fail "plain: no per-Mac pacman master key recorded"
  sudo test -f "$work/mnt/var/lib/omarchy/provisioning/pending" || fail "plain: owner provisioning is not armed"
  sudo test ! -e "$st/last-error" || fail "plain: $(sudo cat "$st/last-error")"
  umount_last
  mount_tracked -o ro "${dev}p1" "$work/mnt"
  sudo test ! -e "$work/mnt/omarchy/install.conf" || fail "plain: install.conf is still on the ESP"
  umount_last
  mount_tracked -o ro "${dev}p2" "$work/mnt"
  sudo grep -q 'phase=declined' "$work/mnt/omarchy/encrypt.state" || fail "plain: encrypt.state does not record the decline"
  umount_last
  detach_last
  ok "plain first boot: install.conf consumed, root left plain (phase=declined), keyring made, owner provisioning armed"
}

# ── encrypted first boot and the boot after it ───────────────────────────────
encrypted_boot() {
  local disk=$work/encrypted.img log=$evidence_dir/encrypted-serial.log
  make_disk "$disk" ""
  say "encrypted first boot (no install.conf)"
  boot_guest "$disk" "$log" "$root_append"
  wait_serial "$log" "encrypting in place" "encrypted: conversion start"
  wait_serial "$log" "conversion finished" "encrypted: conversion"
  wait_serial "$log" "sysroot.mount drop-in What=/dev/mapper/root" "encrypted: sysroot repointed"
  wait_serial "$log" "Finished Omarchy first boot" "encrypted: first boot"
  wait_serial "$log" "Starting Omarchy provisioning first-boot user setup" "encrypted: owner provisioning"
  ! grep -aq "Failed to start Encrypt the Omarchy Mac root\|update-grub failed\|mkinitcpio -P failed" "$log" ||
    fail "encrypted: the encrypt unit reported a failure"
  settle_guest
  stop_guest
  local dev luks
  attach -P "$disk"; dev=$ATTACHED
  mkdir -p "$work/mnt"
  [[ $(sudo blkid -c /dev/null -o value -s TYPE "${dev}p3") == crypto_LUKS ]] || fail "encrypted: the root is not crypto_LUKS"
  luks=$(sudo blkid -c /dev/null -o value -s UUID "${dev}p3")
  mount_tracked -o ro "${dev}p2" "$work/mnt"
  sudo grep -q 'phase=configured' "$work/mnt/omarchy/encrypt.state" || fail "encrypted: encrypt.state is not phase=configured"
  sudo grep -q "luks_uuid=$luks" "$work/mnt/omarchy/encrypt.state" || fail "encrypted: encrypt.state names another LUKS UUID"
  [[ $(sudo stat -c '%s %a' "$work/mnt/omarchy/luks-key") == "64 600" ]] || fail "encrypted: the throwaway key is not 64 bytes 0600"
  sudo grep -q "rd.luks.name=$luks=root rd.luks.key=$luks=/omarchy/luks-key:UUID=$BOOT_UUID" "$work/mnt/grub/grub.cfg" ||
    fail "encrypted: grub.cfg does not unlock through the Boot key"
  umount_last
  detach_last
  local conversion
  conversion=$(grep -a -o 'conversion finished in [0-9]*s ([0-9]* MiB/s)' "$log" | tail -n 1)
  ok "encrypted first boot: root converted to LUKS2 ($conversion), GRUB and initramfs regenerated, first boot finished on /dev/mapper/root"

  say "second boot through sd-encrypt"
  local log2=$evidence_dir/encrypted-second-serial.log
  boot_guest "$disk" "$log2" "root=/dev/mapper/root rw rootflags=subvol=@ rootfstype=btrfs rd.luks.name=$luks=root rd.luks.key=$luks=/omarchy/luks-key:UUID=$BOOT_UUID"
  wait_serial "$log2" "Volume root already active\|Set up cryptsetup for root\|Finished Cryptography Setup for root" "second boot: unlock"
  wait_serial "$log2" "login:" "second boot: login prompt"
  ! grep -aq "Emergency Mode\|Failed to mount /run/systemd/cryptsetup/keydev-root\|Failed to start Encrypt the Omarchy Mac root" "$log2" ||
    fail "second boot: emergency mode or a failed unlock"
  stop_guest
  ok "second boot: sd-encrypt unlocked with the Boot key after the encrypt unit, no emergency mode, login reached"
}

if [[ -n $release ]]; then fetch_release; fi
unpack_payload
build_generic_kernel
[[ $only == encrypted ]] || plain_boot
[[ $only == plain ]] || encrypted_boot
{
  echo "run_id=$run_id"
  echo "lane=$lane"
  [[ -z $release ]] || echo "release=$release"
  echo "generic_kernel=$(cat "$work/generic/generic.version")"
  echo "alarm_mirror=$alarm_mirror"
  echo "host=$(uname -n) $(uname -r)"
} >>"$evidence_dir/run.txt"
say "evidence in $evidence_dir"
