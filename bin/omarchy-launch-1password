#!/bin/bash

# omarchy:summary=Launch 1Password or start its installer when missing.
# omarchy:args=[1password-args...]

set -e

# 1Password's authorization prompt is a fixed-size window. As a native Wayland
# client its content outgrows that size and the Authorize button is clipped;
# under XWayland the prompt grows to fit. Electron only switches on the flag,
# it ignores ELECTRON_OZONE_PLATFORM_HINT.
#
# With xwayland:force_zero_scaling, Hyprland leaves X11 clients unscaled, so
# 1Password must scale itself to the focused monitor. Without it, Hyprland
# scales X11 clients itself and any factor above 1 would apply twice.
device_scale() {
  local zero_scaling scale

  zero_scaling=$(hyprctl getoption xwayland:force_zero_scaling -j 2>/dev/null | jq -r '.bool // .int' 2>/dev/null) || true
  if [[ $zero_scaling == "true" || $zero_scaling == "1" ]]; then
    scale=$(hyprctl monitors -j 2>/dev/null | jq -r 'first(.[] | select(.focused == true) | .scale) // empty' 2>/dev/null) || true
    if [[ $scale =~ ^[0-9]+([.][0-9]+)?$ && ! $scale =~ ^0+([.]0*)?$ ]]; then
      echo "$scale"
      return
    fi
  fi

  echo 1
}

if omarchy-cmd-present 1password; then
  if [[ -n ${DISPLAY:-} ]]; then
    scale=$(device_scale)
    exec setsid uwsm-app -- 1password --ozone-platform=x11 --force-device-scale-factor="$scale" "$@"
  else
    # XWayland is disabled, so there is no X11 display to run on.
    exec setsid uwsm-app -- 1password "$@"
  fi
else
  exec omarchy-launch-floating-terminal-with-presentation omarchy-install-service-1password
fi
