#!/usr/bin/python3
# omarchy:summary=Reconcile the Asahi microphone stereo mapping
# omarchy:group=audio
# omarchy:args=[--watch|--save-state]
# omarchy:hidden=true

import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import tempfile
import time
import uuid

# The mapping is a virtual source. It used to be a null sink whose monitor was
# the default input, but pipewire-pulse clients that name no device (parecord,
# and most apps) are then linked by WirePlumber to the default *sink's* monitor
# instead, and record silence (#672). A virtual source routes like any
# microphone, and it can never become the default output (#700).
MAPPING = 'omarchy_asahi_mic'
LEGACY_MONITOR = MAPPING + '.monitor'
OWNER = 'omarchy.asahi-mic.owner'
MEDIA_CLASS = 'Audio/Source/Virtual'
DSP = re.compile(r'effect_output\.j[0-9]+-mic')
MODEL = Path('/proc/device-tree/model')


class Deferred(Exception):
    pass


class Audio:
    def run(self, *args):
        try:
            return subprocess.run(args, check=True, capture_output=True, text=True, timeout=5,
                                  env=dict(os.environ, LC_ALL='C')).stdout.strip()
        except subprocess.CalledProcessError as error:
            raise RuntimeError(' '.join(args[:2]) + ': ' + error.stderr.strip()) from error

    def objects(self, kind):
        result = json.loads(self.run('pactl', '--format=json', 'list', kind))
        if not isinstance(result, list):
            raise ValueError('Invalid PulseAudio object list')
        return result

    def modules(self):
        # PipeWire's pactl JSON module rows omit the numeric index. The short
        # format retains the load-module identity needed for scoped rollback.
        # A multi-line module argument (module-rt from asahi-audio's PipeWire
        # config) continues on lines without an index; they are not modules.
        result = []
        for line in self.run('pactl', 'list', 'short', 'modules').splitlines():
            fields = line.split('\t')
            if len(fields) < 3 or not fields[0].isdecimal():
                continue
            result.append(dict(index=fields[0], name=fields[1], argument=fields[2]))
        return result

    def graph(self):
        result = json.loads(self.run('pw-dump'))
        if not isinstance(result, list):
            raise ValueError('Invalid PipeWire graph')
        return result

    def pause(self):
        time.sleep(0.1)


def port(graph, node_name, port_name):
    nodes = {obj['id'] for obj in graph if obj.get('type', '').endswith(':Node')
             and obj.get('info', {}).get('props', {}).get('node.name') == node_name}
    matches = [obj['id'] for obj in graph if obj.get('type', '').endswith(':Port')
               and obj.get('info', {}).get('props', {}).get('node.id') in nodes
               and obj['info']['props'].get('port.name') == port_name]
    if len(matches) != 1:
        return None
    return matches[0]


def links(graph, output, input_):
    return [obj for obj in graph if obj.get('type', '').endswith(':Link')
            and obj.get('info', {}).get('output-port-id') == output
            and obj['info'].get('input-port-id') == input_
            and obj['info'].get('state') in ('active', 'paused')]


def gain(obj):
    values = [channel['value'] for channel in obj['volume'].values()]
    if len(values) != 2 or any(type(value) is not int or not 0 <= value < 2**32 - 1 for value in values) or type(obj['mute']) is not bool:
        raise ValueError('Invalid stereo mapping gain state')
    return dict(volume=values, mute=obj['mute'])


def legacy_gain(sink, monitor):
    # The null-sink mapping applied its sink gain and its monitor gain in turn;
    # the product is what apps heard, so that is what the source inherits.
    return dict(volume=[min(a * b // 65536, 2**31 - 1) for a, b in zip(sink['volume'], monitor['volume'])],
                mute=sink['mute'] or monitor['mute'])


def description():
    # The name apps show for the microphone, as macOS words it: the family, not
    # the board code asahi-audio puts in its own nodes.
    try:
        model = MODEL.read_bytes().decode(errors='replace')
    except OSError:
        model = ''
    return ('MacBook' if 'MacBook' in model else 'Built-in') + ' Microphone'


def find_dsp(sources):
    return next((obj['name'] for obj in sources if DSP.fullmatch(obj['name'])), None)


def mapping_source(audio):
    return next((obj for obj in audio.objects('sources') if obj['name'] == MAPPING), None)


def write_state(path, state):
    data = json.dumps(dict(source=state), sort_keys=True)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text() == data:
        return
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as temporary:
        temporary.write(data)
    os.replace(temporary.name, path)


def save_state(audio, path):
    source = mapping_source(audio)
    if source is None:
        return
    write_state(path, gain(source))


def load_state(path):
    # A state file this service cannot read is treated as absent: the mapping
    # matters more than a remembered gain, and the next save replaces it.
    if not path.exists():
        return None

    def validated(state):
        # Validate persisted values before using them as pactl arguments.
        return gain(dict(volume={str(i): {'value': value} for i, value in enumerate(state['volume'])}, mute=state['mute']))
    try:
        saved = json.loads(path.read_text())
        if 'source' in saved:
            return validated(saved['source'])
        return legacy_gain(validated(saved['sink']), validated(saved['monitor']))
    except (ValueError, KeyError, TypeError, AttributeError) as error:
        print('Ignoring unreadable microphone mapping state ' + str(path) + ': ' + str(error), file=sys.stderr)
        return None


def restore_gain(audio, path):
    state = load_state(path)
    if state is None:
        return
    audio.run('pactl', 'set-source-volume', MAPPING, *(str(value) for value in state['volume']))
    audio.run('pactl', 'set-source-mute', MAPPING, '1' if state['mute'] else '0')


def owned(module, media_class=None):
    argument = module.get('argument', '')
    return (module.get('name') == 'module-null-sink' and 'sink_name=' + MAPPING + ' ' in argument + ' '
            and OWNER + '=' in argument and (media_class is None or ('media.class=' + media_class) in argument))


def retire_legacy(audio, state, dsp):
    # An earlier version mapped into a null sink. Keep its gain and mute, then
    # remove it: its sink could become the default output and its monitor fails
    # untargeted captures. Returns whether it was the selected input, which the
    # new mapping then takes over. No default is written here: WirePlumber
    # falls back by priority on its own, and its configured default keeps the
    # monitor's name, which the adopt rule recognises on every retry.
    sinks = {obj['name']: obj for obj in audio.objects('sinks')}
    if MAPPING not in sinks:
        return False
    modules = [module for module in audio.modules() if owned(module) and 'media.class=' + MEDIA_CLASS not in module['argument']]
    if len(modules) != 1:
        raise RuntimeError(MAPPING + ' is a sink this service does not own; not replacing it')
    sources = {obj['name']: obj for obj in audio.objects('sources')}
    if LEGACY_MONITOR in sources:
        write_state(state, legacy_gain(gain(sinks[MAPPING]), gain(sources[LEGACY_MONITOR])))
    selected = audio.run('pactl', 'get-default-source') == LEGACY_MONITOR
    audio.run('pactl', 'unload-module', modules[0]['index'])
    return selected


def configured_source(audio):
    # The input somebody chose, as WirePlumber remembers it (pactl
    # set-default-source and the audio panel both write it). Empty when the
    # default is only WirePlumber's own pick by priority, which is what a fresh
    # session has: that pick is the DSP, and the mapping may take it over. A
    # DSP the user chose on purpose is left alone.
    try:
        text = audio.run('pw-metadata', '-n', 'default', '0', 'default.configured.audio.source')
    except Exception:
        return ''
    match = re.search(r"value:'(.*)' type:", text)
    if not match:
        return ''
    try:
        value = json.loads(match.group(1))
    except ValueError:
        return ''
    return value.get('name', '') if isinstance(value, dict) else ''


def reconcile(audio, state, save_only=False):
    if save_only:
        save_state(audio, state)
        return
    sources = audio.objects('sources')
    dsp = find_dsp(sources)
    if not dsp:
        raise Deferred('No Asahi DSP microphone is present; user service will retry if an array appears')
    # Read before anything here writes a default of its own, which WirePlumber
    # would remember as a choice: a retried mapping must still take over.
    configured = configured_source(audio)
    legacy_selected = retire_legacy(audio, state, dsp)
    sources = audio.objects('sources')
    original_input = audio.run('pactl', 'get-default-source')
    # The mapping takes over an unset default, the legacy monitor's place, the
    # mapping's own place (WirePlumber fell back while it was missing), or a
    # DSP that only WirePlumber picked; a DSP somebody chose stays.
    # Never rewritten when it already is the default: pactl set-default-source
    # raises a server event, which is what wakes this watcher.
    adopt = original_input != MAPPING and (legacy_selected or original_input == '' or configured in (MAPPING, LEGACY_MONITOR)
                                           or (original_input == dsp and configured != dsp))
    owner = uuid.uuid4().hex
    module = None
    changed_input = False

    def restore_input():
        # A mapping WirePlumber re-selected because it is the configured
        # default is the choice being honoured, not a temporary one.
        if configured == MAPPING:
            return
        if original_input and audio.run('pactl', 'get-default-source') == MAPPING:
            if original_input in {obj['name'] for obj in audio.objects('sources')}:
                if audio.run('pactl', 'get-default-source') == MAPPING:
                    audio.run('pactl', 'set-default-source', original_input)
    try:
        if not any(obj['name'] == MAPPING for obj in sources):
            # The value is quoted whole so the description keeps its space.
            module = audio.run('pactl', 'load-module', 'module-null-sink', 'media.class=' + MEDIA_CLASS,
                               'sink_name=' + MAPPING, 'channels=2', 'channel_map=front-left,front-right',
                               'sink_properties="device.description=\'' + description() + '\' node.virtual=true priority.session=1 ' + OWNER + '=' + owner + '"')
            if not module.isdecimal():
                raise RuntimeError('PulseAudio did not return a module identity')
            # Some policy managers auto-select a newly created source. Undo
            # only that owned temporary choice before waiting for its links.
            restore_input()
        for attempt in range(30):
            graph = audio.graph()
            output = port(graph, dsp, 'capture_AUX0')
            inputs = [port(graph, MAPPING, 'input_' + channel) for channel in ('FL', 'FR')]
            mapping_exists = any(obj['name'] == MAPPING for obj in audio.objects('sources'))
            if output is not None and all(value is not None for value in inputs) and mapping_exists:
                break
            audio.pause()
        else:
            raise RuntimeError('Asahi AUX0 and both stereo mapping ports must be ready')
        if module is not None:
            restore_gain(audio, state)

        def validate_endpoints(graph):
            if port(graph, dsp, 'capture_AUX0') != output or [
                port(graph, MAPPING, 'input_' + channel) for channel in ('FL', 'FR')
            ] != inputs:
                raise RuntimeError('Asahi microphone endpoints changed during mapping')
        for input_ in inputs:
            graph = audio.graph()
            validate_endpoints(graph)
            if not links(graph, output, input_):
                audio.run('pw-link', '-L', '-w', '-p', json.dumps({OWNER: owner}), str(output), str(input_))
                graph = audio.graph()
        for attempt in range(30):
            graph = audio.graph()
            validate_endpoints(graph)
            if all(links(graph, output, input_) for input_ in inputs):
                break
            audio.pause()
        else:
            raise RuntimeError('Asahi microphone stereo links did not become ready')
        graph = audio.graph()
        validate_endpoints(graph)
        if not all(links(graph, output, input_) for input_ in inputs):
            raise RuntimeError('Asahi microphone links changed before selecting input')
        # Read the user's choice after the final graph query so a device change
        # during that query is not overwritten. Pulse has no atomic compare/set.
        current_input = audio.run('pactl', 'get-default-source')
        if adopt and current_input == original_input:
            changed_input = True
            audio.run('pactl', 'set-default-source', MAPPING)
        # Existing DSP and user device gain/mute are never reset. Save only the
        # owned mapping so a new module after daemon restart can recover it.
        save_state(audio, state)
    except Exception:
        def cleanup(action):
            try:
                action()
            except Exception as error:
                print('Asahi microphone rollback incomplete: ' + str(error), file=sys.stderr)

        def restore_changed_input():
            if changed_input or module is not None:
                restore_input()

        def remove_links():
            for obj in audio.graph():
                if obj.get('type', '').endswith(':Link') and obj.get('info', {}).get('props', {}).get(OWNER) == owner:
                    audio.run('pw-link', '-d', str(obj['id']))

        def remove_module():
            if module is not None:
                for obj in audio.modules():
                    if str(obj['index']) == module and obj.get('name') == 'module-null-sink' and OWNER + '=' + owner in obj.get('argument', ''):
                        audio.run('pactl', 'unload-module', module)
        # A dead PipeWire graph must not prevent removing a module still owned
        # by PulseAudio, or restoring a default that this invocation changed.
        for action in (restore_changed_input, remove_links, remove_module):
            cleanup(action)
        raise


@contextlib.contextmanager
def mapping_lock(runtime):
    with (runtime / 'omarchy-asahi-mic.lock').open('a') as lock:
        deadline = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('Another Asahi microphone repair is still running')
                time.sleep(0.1)
        yield


def run_once(audio, runtime, state, save_only=False):
    if not os.environ.get('PULSE_SERVER') and not os.environ.get('PIPEWIRE_REMOTE') and not any((runtime / path).exists() for path in ('pulse/native', 'pipewire-0')):
        raise Deferred('No audio session endpoints; microphone mapping deferred to the user service')
    with mapping_lock(runtime):
        reconcile(audio, state, save_only)


class Subscription:
    # Wakes the supervisor when the mapping may need repair: a sink, source,
    # card or module appeared or vanished, a card or module changed, or the
    # server did (pipewire-pulse restart, default device switch). Sink and
    # source 'change' events are deliberately not watched: every stream start
    # and stop emits them, and the mapping only depends on node existence,
    # links and defaults. Client and stream events are ignored outright. A
    # burst settles for a quiet interval so a hot-plug repairs once, a cap
    # keeps a steady stream from starving repair, and a slow backstop keeps
    # the eventually-consistent guarantee that polling every two seconds gave
    # (it is also what persists a gain change made between other events).
    EVENT = re.compile(rb"^Event '(new|remove)' on (sink|source|card|module) #|^Event 'change' on (card|module|server) #")

    def __init__(self, command=('pactl', 'subscribe'), quiet=0.5, settle=5.0, backstop=600.0, retry=2.0):
        self.command = list(command)
        self.quiet, self.settle, self.backstop, self.retry = quiet, settle, backstop, retry
        self.process = None
        self.buffer = b''

    def start(self):
        try:
            self.process = subprocess.Popen(self.command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
        except OSError:
            self.process = None
        self.buffer = b''
        return self.process is not None

    def stop(self):
        process, self.process = self.process, None
        if process is None:
            return
        process.stdout.close()
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()

    def lines(self):
        chunk = os.read(self.process.stdout.fileno(), 4096)
        if not chunk:
            return None
        self.buffer += chunk
        *complete, self.buffer = self.buffer.split(b'\n')
        return complete

    def wait(self):
        if self.process is None and not self.start():
            time.sleep(self.retry)
            return
        started = time.monotonic()
        due = None
        latest = None
        while True:
            now = time.monotonic()
            deadline = started + self.backstop if due is None else min(due, latest)
            if deadline <= now:
                return
            ready, _, _ = select.select([self.process.stdout], [], [], deadline - now)
            if not ready:
                return
            lines = self.lines()
            if lines is None:
                # The subscription ended: pipewire-pulse went away or is not up
                # yet. Repair now, then resubscribe after a pause.
                self.stop()
                time.sleep(self.retry)
                return
            if any(self.EVENT.match(line) for line in lines):
                now = time.monotonic()
                due = now + self.quiet
                if latest is None:
                    latest = now + self.settle


def supervise(operation, wait=None):
    subscription = Subscription() if wait is None else None
    if subscription is not None:
        wait = subscription.wait
    previous_error = None
    try:
        while True:
            try:
                operation()
                previous_error = None
            except Exception as error:
                message = str(error)
                if message != previous_error:
                    print(message, file=sys.stderr, flush=True)
                    previous_error = message
            wait()
    finally:
        if subscription is not None:
            subscription.stop()


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--watch', action='store_true')
    mode.add_argument('--save-state', action='store_true')
    args = parser.parse_args()
    if subprocess.run(['omarchy-hw-apple']).returncode:
        return 0
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid())))
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'omarchy/asahi-mic-gain.json'
    operation = lambda: run_once(Audio(), runtime, state, args.save_state)
    if args.watch:
        # Let a service stop unwind through supervise so the subscriber exits too.
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        supervise(operation)
    else:
        try:
            operation()
        except Deferred as error:
            print(error, file=sys.stderr)
            return 75
        except Exception as error:
            print('Asahi microphone mapping failed: ' + str(error), file=sys.stderr)
            return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
