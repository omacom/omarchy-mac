#!/usr/bin/python3
# omarchy:summary=Reconcile the Asahi microphone stereo mapping
# omarchy:group=audio
# omarchy:args=[--watch|--save-state]
# omarchy:hidden=true

import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import tempfile
import time
import uuid

SINK = 'omarchy_asahi_mic'
MONITOR = SINK + '.monitor'
OWNER = 'omarchy.asahi-mic.owner'


class Deferred(Exception):
    pass


class Audio:
    def run(self, *args):
        try:
            return subprocess.run(args, check=True, capture_output=True, text=True, timeout=5).stdout.strip()
        except subprocess.CalledProcessError as error:
            raise RuntimeError(' '.join(args[:2]) + ': ' + error.stderr.strip()) from error

    def objects(self, kind):
        result = json.loads(self.run('pactl', '--format=json', 'list', kind))
        if not isinstance(result, list):
            raise ValueError('Invalid PulseAudio object list')
        return result

    def modules(self):
        # PipeWire's pactl JSON module rows omit the numeric index. The short
        # format retains the load-module identity needed for scoped rollback.
        result = []
        for line in self.run('pactl', 'list', 'short', 'modules').splitlines():
            fields = line.split('\t')
            if len(fields) < 3 or not fields[0].isdecimal():
                raise ValueError('Invalid PulseAudio module identity')
            result.append(dict(index=fields[0], name=fields[1], argument=fields[2]))
        return result

    def graph(self):
        result = json.loads(self.run('pw-dump'))
        if not isinstance(result, list):
            raise ValueError('Invalid PipeWire graph')
        return result

    def pause(self):
        time.sleep(0.1)



J456_SOURCE = 'omarchy_j456_microphone'
J456_CAPTURE = 'capture.omarchy-j456-microphone'


def j456_raw(graph):
    # ALSA's card identity restricts this fallback to the tested four-port M1
    # iMac. Instance names and card numbers change across boots/hot-plug.
    candidates = []
    for obj in graph:
        props = obj.get('info', {}).get('props', {})
        if (obj.get('type', '').endswith(':Node')
                and props.get('media.class') == 'Audio/Source'
                and props.get('alsa.id') == 'AppleJ456HPAI'
                and props.get('api.alsa.pcm.stream') == 'capture'
                and props.get('alsa.driver_name') == 'snd_soc_aop'
                and props.get('audio.channels') == 3
                and props.get('object.serial') is not None):
            channels = {item.get('info', {}).get('props', {}).get('audio.channel')
                        for item in graph if item.get('type', '').endswith(':Port')
                        and item.get('info', {}).get('props', {}).get('node.id') == obj['id']
                        and item.get('info', {}).get('props', {}).get('port.direction') == 'out'}
            if channels == {'AUX0', 'AUX1', 'AUX2'}:
                candidates.append(obj)
    return candidates[0] if len(candidates) == 1 else None


def save_j456_state(audio, path):
    source = next((obj for obj in audio.objects('sources') if obj['name'] == J456_SOURCE), None)
    if source is None:
        return
    saved = json.dumps(gain(source, channels=1), sort_keys=True)
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.exists() or path.read_text() != saved:
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as temporary:
            temporary.write(saved)
        os.replace(temporary.name, path)


class J456Fallback:
    # The watch service owns the filter process, not a persistent global
    # PipeWire config. Stopping it or gaining native DSP removes the fallback.
    def __init__(self, runtime, state):
        self.runtime = runtime
        self.state = state
        self.process = None
        self.target = None

    def stop(self):
        process, self.process = self.process, None
        self.target = None
        if process is not None:
            if process.poll() is None:
                process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()

    def start(self, serial):
        template = Path(os.environ['OMARCHY_PATH']) / 'default/pipewire/j456-microphone.conf'
        config = template.read_text().replace('@TARGET@', json.dumps(str(serial)))
        # Keep the private configuration until the child exits: it reads the
        # path asynchronously, and can load it again on connection recovery.
        self.config = tempfile.TemporaryDirectory(prefix='omarchy-j456-', dir=self.runtime)
        path = Path(self.config.name) / 'filter.conf'
        path.write_text(config)
        try:
            self.process = subprocess.Popen(['pipewire', '-c', str(path)], stdin=subprocess.DEVNULL)
            self.target = serial
        except Exception:
            self.config.cleanup()
            raise

    def save(self, audio):
        if self.process is not None:
            save_j456_state(audio, self.state)

    def close(self):
        self.stop()
        if hasattr(self, 'config'):
            self.config.cleanup()

    def reconcile(self, audio, sources, dsp):
        if dsp:
            self.save(audio)
            selected = audio.run('pactl', 'get-default-source')
            # Switch away only from our running fallback; never touch an
            # independently created node with the same name.
            if self.process is not None and selected == J456_SOURCE:
                audio.run('pactl', 'set-default-source', dsp)
            self.close()
            return False
        graph = audio.graph()
        raw = j456_raw(graph)
        if raw is None:
            self.save(audio)
            self.close()
            return False
        props = raw['info']['props']
        serial, name = props['object.serial'], props['node.name']
        owned = self.process is not None
        if self.process is not None and (self.process.poll() is not None or self.target != serial):
            if self.process.poll() is None:
                self.save(audio)
            self.close()
        names = {obj['name'] for obj in sources}
        if not owned and J456_SOURCE in names:
            raise Deferred('An independent J456 microphone source already exists; leaving it unchanged')
        original = audio.run('pactl', 'get-default-source')
        try:
            started = self.process is None
            if started:
                self.start(serial)
            for attempt in range(30):
                graph = audio.graph()
                current_raw = j456_raw(graph)
                if current_raw is None or current_raw['info']['props']['object.serial'] != serial:
                    raise RuntimeError('J456 microphone changed while starting its filter')
                if self.process.poll() is not None:
                    raise RuntimeError('J456 microphone filter exited')
                output = port(graph, name, 'capture_AUX2')
                input_ = port(graph, J456_CAPTURE, 'input_AUX2')
                connected = output is not None and input_ is not None and links(graph, output, input_)
                if connected and any(obj['name'] == J456_SOURCE for obj in audio.objects('sources')):
                    break
                audio.pause()
            else:
                raise RuntimeError('J456 microphone filter did not become ready')
            if started and self.state.exists():
                saved = json.loads(self.state.read_text())
                values = gain(dict(volume={str(i): {'value': value} for i, value in enumerate(saved['volume'])}, mute=saved['mute']), channels=1)
                audio.run('pactl', 'set-source-volume', J456_SOURCE, str(values['volume'][0]))
                audio.run('pactl', 'set-source-mute', J456_SOURCE, '1' if values['mute'] else '0')
            current = audio.run('pactl', 'get-default-source')
            if original == name and current == original:
                audio.run('pactl', 'set-default-source', J456_SOURCE)
            elif original and original not in (name, J456_SOURCE) and current == J456_SOURCE:
                # Undo policy auto-selection when registering a new source.
                if original in {obj['name'] for obj in audio.objects('sources')}:
                    if audio.run('pactl', 'get-default-source') == J456_SOURCE:
                        audio.run('pactl', 'set-default-source', original)
            self.save(audio)
            return True
        except Exception:
            try:
                if original and original != J456_SOURCE and audio.run('pactl', 'get-default-source') == J456_SOURCE:
                    if original in {obj['name'] for obj in audio.objects('sources')}:
                        if audio.run('pactl', 'get-default-source') == J456_SOURCE:
                            audio.run('pactl', 'set-default-source', original)
            finally:
                self.close()
            raise


def port(graph, node_name, port_name):
    nodes = {obj['id'] for obj in graph if obj.get('type', '').endswith(':Node')
             and obj.get('info', {}).get('props', {}).get('node.name') == node_name}
    matches = [obj['id'] for obj in graph if obj.get('type', '').endswith(':Port')
               and obj.get('info', {}).get('props', {}).get('node.id') in nodes
               and obj['info']['props'].get('port.name') == port_name]
    if len(matches) != 1:
        return None
    return matches[0]


def links(graph, output, input_):
    return [obj for obj in graph if obj.get('type', '').endswith(':Link')
            and obj.get('info', {}).get('output-port-id') == output
            and obj['info'].get('input-port-id') == input_
            and obj['info'].get('state') in ('active', 'paused')]


def gain(obj, channels=2):
    values = [channel['value'] for channel in obj['volume'].values()]
    if len(values) != channels or any(type(value) is not int or not 0 <= value < 2**32 - 1 for value in values) or type(obj['mute']) is not bool:
        raise ValueError('Invalid microphone mapping gain state')
    return dict(volume=values, mute=obj['mute'])


def save_state(audio, path):
    sinks = {obj['name']: obj for obj in audio.objects('sinks')}
    sources = {obj['name']: obj for obj in audio.objects('sources')}
    if SINK not in sinks or MONITOR not in sources:
        return
    data = json.dumps(dict(sink=gain(sinks[SINK]), monitor=gain(sources[MONITOR])), sort_keys=True)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text() == data:
        return
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as temporary:
        temporary.write(data)
    os.replace(temporary.name, path)


def restore_gain(audio, path):
    if not path.exists():
        return
    saved = json.loads(path.read_text())
    for kind, name, key in (('sink', SINK, 'sink'), ('source', MONITOR, 'monitor')):
        state = saved[key]
        # Validate persisted values before using them as pactl arguments.
        validated = gain(dict(volume={str(i): {'value': value} for i, value in enumerate(state['volume'])}, mute=state['mute']))
        audio.run('pactl', 'set-' + kind + '-volume', name, *(str(value) for value in validated['volume']))
        audio.run('pactl', 'set-' + kind + '-mute', name, '1' if validated['mute'] else '0')


def restore_output(audio, previous):
    if previous and previous != SINK and audio.run('pactl', 'get-default-sink') == SINK:
        if previous in {obj['name'] for obj in audio.objects('sinks')}:
            # Check again immediately before changing a default the module took.
            if audio.run('pactl', 'get-default-sink') == SINK:
                audio.run('pactl', 'set-default-sink', previous)


def reconcile(audio, state, save_only=False, fallback=None):
    if save_only:
        save_state(audio, state)
        save_j456_state(audio, state.with_name('j456-mic-gain.json'))
        return
    sources = audio.objects('sources')
    original_input = audio.run('pactl', 'get-default-source')
    original_output = audio.run('pactl', 'get-default-sink')
    dsp = next((obj['name'] for obj in sources if re.fullmatch(r'effect_output\.j[0-9]+-mic', obj['name'])), None)
    if fallback is not None:
        if fallback.reconcile(audio, sources, dsp):
            return
        # Native DSP takeover may have moved the owned fallback selection.
        original_input = audio.run('pactl', 'get-default-source')
    if not dsp:
        raise Deferred('No Asahi DSP microphone is present; user service will retry if an array appears')
    sinks = audio.objects('sinks')
    owner = uuid.uuid4().hex
    module = None
    changed_input = False
    def restore_input():
        if original_input and audio.run('pactl', 'get-default-source') == MONITOR:
            if original_input in {obj['name'] for obj in audio.objects('sources')}:
                if audio.run('pactl', 'get-default-source') == MONITOR:
                    audio.run('pactl', 'set-default-source', original_input)
    try:
        if not any(obj['name'] == SINK for obj in sinks):
            module = audio.run('pactl', 'load-module', 'module-null-sink', 'sink_name=' + SINK,
                               'channels=2', 'channel_map=front-left,front-right',
                               'sink_properties=device.description=AsahiMicrophone node.virtual=true priority.session=1 ' + OWNER + '=' + owner)
            if not module.isdecimal():
                raise RuntimeError('PulseAudio did not return a module identity')
            # Some policy managers auto-select a newly created monitor. Undo
            # only that owned temporary choice before waiting for its links.
            restore_input()
        for attempt in range(30):
            graph = audio.graph()
            output = port(graph, dsp, 'capture_AUX0')
            inputs = [port(graph, SINK, 'playback_' + channel) for channel in ('FL', 'FR')]
            monitor_exists = any(obj['name'] == MONITOR for obj in audio.objects('sources'))
            if output is not None and all(value is not None for value in inputs) and monitor_exists:
                break
            audio.pause()
        else:
            raise RuntimeError('Asahi AUX0 and both stereo mapping ports must be ready')
        if module is not None:
            restore_gain(audio, state)
        def validate_endpoints(graph):
            if port(graph, dsp, 'capture_AUX0') != output or [
                port(graph, SINK, 'playback_' + channel) for channel in ('FL', 'FR')
            ] != inputs:
                raise RuntimeError('Asahi microphone endpoints changed during mapping')
        for input_ in inputs:
            graph = audio.graph()
            validate_endpoints(graph)
            if not links(graph, output, input_):
                audio.run('pw-link', '-L', '-w', '-p', json.dumps({OWNER: owner}), str(output), str(input_))
                graph = audio.graph()
        for attempt in range(30):
            graph = audio.graph()
            validate_endpoints(graph)
            if all(links(graph, output, input_) for input_ in inputs):
                break
            audio.pause()
        else:
            raise RuntimeError('Asahi microphone stereo links did not become ready')
        restore_output(audio, original_output)
        graph = audio.graph()
        validate_endpoints(graph)
        if not all(links(graph, output, input_) for input_ in inputs):
            raise RuntimeError('Asahi microphone links changed before selecting input')
        # Read the user's choice after the final graph query so a device change
        # during that query is not overwritten. Pulse has no atomic compare/set.
        current_input = audio.run('pactl', 'get-default-source')
        if original_input in ('', dsp) and current_input == original_input:
            changed_input = True
            audio.run('pactl', 'set-default-source', MONITOR)
        # Existing DSP, monitor and sink gain/mute are never reset. Save only
        # the owned mapping so a new module after daemon restart can recover it.
        save_state(audio, state)
    except Exception:
        def cleanup(action):
            try:
                action()
            except Exception as error:
                print('Asahi microphone rollback incomplete: ' + str(error), file=sys.stderr)
        def restore_changed_input():
            if changed_input or module is not None:
                restore_input()
        def remove_links():
            for obj in audio.graph():
                if obj.get('type', '').endswith(':Link') and obj.get('info', {}).get('props', {}).get(OWNER) == owner:
                    audio.run('pw-link', '-d', str(obj['id']))
        def remove_module():
            if module is not None:
                for obj in audio.modules():
                    if str(obj['index']) == module and obj.get('name') == 'module-null-sink' and OWNER + '=' + owner in obj.get('argument', ''):
                        audio.run('pactl', 'unload-module', module)
        # A dead PipeWire graph must not prevent removing a module still owned
        # by PulseAudio, or restoring a default that this invocation changed.
        for action in (restore_changed_input, lambda: restore_output(audio, original_output), remove_links, remove_module):
            cleanup(action)
        raise


@contextlib.contextmanager
def mapping_lock(runtime):
    with (runtime / 'omarchy-asahi-mic.lock').open('a') as lock:
        deadline = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('Another Asahi microphone repair is still running')
                time.sleep(0.1)
        yield


def run_once(audio, runtime, state, save_only=False, fallback=None):
    if not os.environ.get('PULSE_SERVER') and not os.environ.get('PIPEWIRE_REMOTE') and not any((runtime / path).exists() for path in ('pulse/native', 'pipewire-0')):
        raise Deferred('No audio session endpoints; microphone mapping deferred to the user service')
    with mapping_lock(runtime):
        reconcile(audio, state, save_only, fallback)


class Subscription:
    # Wakes the supervisor when the mapping may need repair: a sink, source,
    # card or module appeared or vanished, a card or module changed, or the
    # server did (pipewire-pulse restart, default device switch). Sink and
    # source 'change' events are deliberately not watched: every stream start
    # and stop emits them, and the mapping only depends on node existence,
    # links and defaults. Client and stream events are ignored outright. A
    # burst settles for a quiet interval so a hot-plug repairs once, a cap
    # keeps a steady stream from starving repair, and a slow backstop keeps
    # the eventually-consistent guarantee that polling every two seconds gave
    # (it is also what persists a gain change made between other events).
    EVENT = re.compile(rb"^Event '(new|remove)' on (sink|source|card|module) #|^Event 'change' on (card|module|server) #")

    def __init__(self, command=('pactl', 'subscribe'), quiet=0.5, settle=5.0, backstop=600.0, retry=2.0):
        self.command = list(command)
        self.quiet, self.settle, self.backstop, self.retry = quiet, settle, backstop, retry
        self.process = None
        self.buffer = b''

    def start(self):
        try:
            self.process = subprocess.Popen(self.command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
        except OSError:
            self.process = None
        self.buffer = b''
        return self.process is not None

    def stop(self):
        process, self.process = self.process, None
        if process is None:
            return
        process.stdout.close()
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()

    def lines(self):
        chunk = os.read(self.process.stdout.fileno(), 4096)
        if not chunk:
            return None
        self.buffer += chunk
        *complete, self.buffer = self.buffer.split(b'\n')
        return complete

    def wait(self):
        if self.process is None and not self.start():
            time.sleep(self.retry)
            return
        started = time.monotonic()
        due = None
        latest = None
        while True:
            now = time.monotonic()
            deadline = started + self.backstop if due is None else min(due, latest)
            if deadline <= now:
                return
            ready, _, _ = select.select([self.process.stdout], [], [], deadline - now)
            if not ready:
                return
            lines = self.lines()
            if lines is None:
                # The subscription ended: pipewire-pulse went away or is not up
                # yet. Repair now, then resubscribe after a pause.
                self.stop()
                time.sleep(self.retry)
                return
            if any(self.EVENT.match(line) for line in lines):
                now = time.monotonic()
                due = now + self.quiet
                if latest is None:
                    latest = now + self.settle


def supervise(operation, wait=None):
    subscription = Subscription() if wait is None else None
    if subscription is not None:
        wait = subscription.wait
    previous_error = None
    try:
        while True:
            try:
                operation()
                previous_error = None
            except Exception as error:
                message = str(error)
                if message != previous_error:
                    print(message, file=sys.stderr, flush=True)
                    previous_error = message
            wait()
    finally:
        if subscription is not None:
            subscription.stop()


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--watch', action='store_true')
    mode.add_argument('--save-state', action='store_true')
    args = parser.parse_args()
    if subprocess.run(['omarchy-hw-apple']).returncode:
        return 0
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid())))
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'omarchy/asahi-mic-gain.json'
    fallback = J456Fallback(runtime, state.with_name('j456-mic-gain.json')) if args.watch else None
    operation = lambda: run_once(Audio(), runtime, state, args.save_state, fallback)
    if args.watch:
        # Let a service stop unwind through supervise so the subscriber exits too.
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        try:
            supervise(operation)
        finally:
            try:
                fallback.save(Audio())
            finally:
                fallback.close()
    else:
        try:
            operation()
        except Deferred as error:
            print(error, file=sys.stderr)
            return 75
        except Exception as error:
            print('Asahi microphone mapping failed: ' + str(error), file=sys.stderr)
            return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
