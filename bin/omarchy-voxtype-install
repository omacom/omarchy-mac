#!/bin/bash

# omarchy:summary=Install and configure Voxtype dictation
# omarchy:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  # Mac fork: voxtype-bin ships x86_64-only prebuilt binaries; on Apple Silicon
  # build the source package instead (voxtype, arch includes aarch64) via the AUR
  # helper. wtype is in the repos on both.
  if [[ "$(uname -m)" == "aarch64" ]]; then
    omarchy-pkg-add wtype
    omarchy-pkg-aur-add voxtype
  else
    omarchy-pkg-add wtype voxtype-bin
  fi

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  cp "$OMARCHY_PATH/default/voxtype/config.toml" ~/.config/voxtype/

  voxtype setup --download --no-post-install
  if omarchy-hw-vulkan; then
    voxtype setup gpu --enable || true
  fi
  voxtype setup systemd

  hyprctl reload >/dev/null
  omarchy-restart-shell
  dictation_shortcut=$(omarchy-keybinding-label --m1-air 'F5' 'F9')
  dictation_toggle_shortcut=$(omarchy-keybinding-label 'Super + Ctrl + X')
  if [[ $dictation_shortcut == "F5" ]]; then
    dictation_hint="Press $dictation_shortcut to toggle dictation (or use $dictation_toggle_shortcut)."
  else
    dictation_hint="Hold $dictation_shortcut to dictate (or toggle with $dictation_toggle_shortcut)."
  fi
  omarchy-notification-send -g  "Voxtype Dictation Ready" "$dictation_hint" -t 10000
fi
