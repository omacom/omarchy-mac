#!/usr/bin/python3
# omarchy:summary=Report default keyring lock state as JSON
# omarchy:group=secrets
"""Print the default Secret Service collection's lock state.

Emits one JSON object: {"collection": <name|null>, "locked": <bool>}. Read-only;
it never prompts or unlocks, so callers can distinguish "empty" from "locked"
before surfacing either to the user.
"""

import json
import sys

try:
    import gi

    gi.require_version("Secret", "1")
    from gi.repository import GLib, Secret
except (ImportError, ValueError):
    sys.exit("error: python-gobject is required (pacman -S python-gobject)")


def main():
    try:
        svc = Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
        coll = Secret.Collection.for_alias_sync(
            svc, Secret.COLLECTION_DEFAULT, Secret.CollectionFlags.NONE, None
        )
        locked = bool(coll.get_locked()) if coll is not None else False
        print(json.dumps({"collection": "default", "locked": locked}))
    except GLib.Error as e:
        sys.exit(f"error: {e.message}")


if __name__ == "__main__":
    main()
