#!/usr/bin/python3
# omarchy:summary=Unlock the default Secret Service keyring
# omarchy:group=secrets
"""Unlock the default collection via the desktop's prompter.

Blocks while the prompter runs: exit 0 when the collection ends unlocked
(already-unlocked is a no-op success), nonzero when the user dismisses or the
service errors. Callers that must not hide the prompt — e.g. overlay panels
with an exclusive keyboard grab — should get out of the way before invoking
this.
"""

import sys

try:
    import gi

    gi.require_version("Secret", "1")
    from gi.repository import GLib, Secret
except (ImportError, ValueError):
    sys.exit("error: python-gobject is required (pacman -S python-gobject)")


def main():
    try:
        svc = Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
        coll = Secret.Collection.for_alias_sync(
            svc, Secret.COLLECTION_DEFAULT, Secret.CollectionFlags.NONE, None
        )
        if coll is None:
            sys.exit("error: no default collection")
        if coll.get_locked():
            Secret.Service.unlock_sync(svc, [coll], None)
        if coll.get_locked():
            sys.exit("error: unlock dismissed")
        print("unlocked")
    except GLib.Error as e:
        sys.exit(f"error: {e.message}")


if __name__ == "__main__":
    main()
