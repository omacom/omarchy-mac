#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

[[ $OMARCHY_PATH != "/usr/share/omarchy" ]] || exit 0

echo -e "\e[33m\nOmarchy Mac is no longer maintained, so this checkout is not updated."
echo -e "Reinstall with the official Omarchy for Apple Silicon: https://omarchy.org/manual/mac-support/\e[0m"
