#!/bin/bash

# omarchy:summary=Print the directory holding a theme, preferring a user-installed copy
# omarchy:args=<theme-name>
# omarchy:examples=omarchy theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: omarchy-theme-dir <theme-name>" >&2
  exit 1
fi

# theme current/list print Title Case names; directories are kebab-case slugs.
# Same conversion omarchy-theme-set uses so the three commands agree.
theme=$(echo "$theme" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ -z $theme || $theme == .* || $theme == */* ]]; then
  echo "Invalid theme name: $1" >&2
  exit 1
fi

if [[ -d $HOME/.config/omarchy/themes/$theme ]]; then
  echo "$HOME/.config/omarchy/themes/$theme"
elif [[ -d ${OMARCHY_PATH:-}/themes/$theme ]]; then
  echo "$OMARCHY_PATH/themes/$theme"
else
  echo "Theme '$theme' does not exist" >&2
  exit 1
fi
