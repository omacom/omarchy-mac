#!/usr/bin/python3
# omarchy:summary=List stored secrets as JSON lines
# omarchy:group=secrets
"""List items in the default Secret Service keyring as JSON lines.

One object per item: service, account, label, created, modified, app. Items stored
by applications that use different attribute names (for example browsers or
seahorse entries) appear with null service/account; secret values are never
loaded or printed.
"""

import json
import sys

try:
    import gi

    gi.require_version("Secret", "1")
    from gi.repository import GLib, Secret
except (ImportError, ValueError):
    sys.exit("error: python-gobject is required (pacman -S python-gobject)")


def main():
    try:
        svc = Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
        items = (
            Secret.Service.search_sync(
                svc,
                None,  # no schema: enumerate every item in the collection
                {},
                Secret.SearchFlags.ALL | Secret.SearchFlags.UNLOCK,
                None,
            )
            or []
        )
        rows = [
            {
                "service": attrs.get("service"),
                "account": attrs.get("account"),
                "label": item.get_label(),
                "created": item.get_created(),
                "modified": item.get_modified(),
                "app": attrs.get("app"),
            }
            for item in items
            for attrs in [dict(item.get_attributes())]
        ]
        rows.sort(key=lambda r: (r["service"] or "", r["account"] or "", r["label"] or ""))
        for row in rows:
            print(json.dumps(row))
    except GLib.Error as e:
        sys.exit(f"error: {e.message}")


if __name__ == "__main__":
    main()
