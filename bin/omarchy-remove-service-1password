#!/bin/bash

# omarchy:summary=Remove 1Password and its Chromium extension.
# omarchy:requires-sudo=true

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
EXTENSION_FILE="/usr/share/chromium/extensions/$EXTENSION_ID.json"

sudo rm -f "$EXTENSION_FILE"

# On aarch64 the app is not a package: omarchy-install-1password unpacks the
# official arm64 tarball into /opt/1Password and links it into place, so
# omarchy-pkg-drop has nothing to remove and the app would survive its own
# uninstall.
if [[ -d /opt/1Password ]]; then
  sudo rm -rf /opt/1Password
  sudo rm -f /usr/local/bin/1password \
    /usr/share/applications/1password.desktop \
    /usr/share/polkit-1/actions/com.1password.1Password.policy
  sudo find /usr/share/icons/hicolor -name '1password.png' -delete 2>/dev/null || true
fi

omarchy-pkg-drop 1password 1password-cli

# Only the entry omarchy-install-service-1password installed; a custom one is
# the user's to keep.
desktop="$HOME/.local/share/applications/1password.desktop"
if [[ -f $desktop && ! -L $desktop ]] && grep -q '^Exec=omarchy-launch-1password' "$desktop"; then
  rm -f "$desktop"
  update-desktop-database "${desktop%/*}" 2>/dev/null || true
fi

echo ""
echo "1Password has been removed."
