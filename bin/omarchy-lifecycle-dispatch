#!/bin/bash -p

# omarchy:summary=Run a fixed boot lifecycle operation through the platform's boot package
# omarchy:args=[--resolve] <operation> [arguments...]
# omarchy:requires-sudo=true
# omarchy:hidden=true

# Provisioning, factory reset, update and boot rebuild call a fixed set of
# operations here. A platform whose boot chain needs its own handling registers
# a directory of root-owned entrypoints below; on every other platform each
# operation is a no-op and the caller keeps its generic path. The contract is
# docs/lifecycle-dispatch.md.
#
# --resolve prints the entrypoint an operation would run, or nothing when it is
# a no-op here, so a caller can choose between a platform implementation and
# its own generic path.
#
# Root runs this from provisioning, factory reset and update, and it decides
# what runs as root. -p keeps a root caller's environment from running code in
# this shell before the first line (bash then ignores BASH_ENV and exported
# functions), so a launch without it is refused.
if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

set -euo pipefail

operations=(
  provision-prepare provision-commit provision-verify
  reset-prepare reset-verify reset-commit reset-rollback
  update-preflight update-verify
  boot-rebuild
  luks-slots
)

usage() {
  echo "Usage: omarchy-lifecycle-dispatch [--resolve] <operation> [arguments...]" >&2
  echo "Operations: ${operations[*]}" >&2
  exit 2
}

listed() {
  local item=$1 candidate
  shift
  for candidate in "$@"; do
    [[ $candidate == "$item" ]] && return 0
  done
  return 1
}

resolve=0
if [[ ${1:-} == "--resolve" ]]; then
  resolve=1
  shift
fi
operation=${1:-}
[[ -n $operation ]] || usage
shift
listed "$operation" "${operations[@]}" || usage

# A privileged caller must not let its environment choose what runs as root:
# root resolves only the fixed paths below, and the detector beside this file
# ignores its fixture roots. Fixture roots exist for unprivileged tests.
fixed_path=/usr/local/sbin:/usr/local/bin:/usr/bin
detect=("$(PATH=$fixed_path dirname -- "${BASH_SOURCE[0]}")/omarchy-hw-platform")
if (( EUID == 0 )); then
  export PATH=$fixed_path
  detect=(/usr/bin/env -i PATH="$fixed_path" "${detect[@]}")
  root=""
else
  root=${OMARCHY_LIFECYCLE_ROOT:-}
  root=${root%/}
  if [[ -n $root && $root != /* ]]; then
    echo "Error: OMARCHY_LIFECYCLE_ROOT must be an absolute path" >&2
    exit 1
  fi
fi

if ! platform=$("${detect[@]}"); then
  echo "Error: cannot determine the hardware platform for $operation" >&2
  exit 1
fi

# Generic, generic-aarch64 and Qualcomm machines have no registered boot
# package: every operation is a no-op there and callers keep their generic path.
# Apple Silicon's is omarchy-mac-boot (omacom/omarchy-mac). Provisioning and
# factory reset have no other path on a Mac, only update-verify checks what an
# update left in its boot chain, and its boot checks prove the kept LUKS slots
# that luks-slots records, so those operations are required. update-preflight
# is optional, and boot-rebuild stays optional until a platform ships it.
# Moving an operation to required also changes apple_optional in
# test/shell.d/lifecycle-dispatch-test.sh and the Apple column and registration
# table in docs/lifecycle-dispatch.md.
case $platform in
  apple-silicon)
    implementation=/usr/lib/omarchy/mac-boot
    package=omarchy-mac-boot
    required=(
      provision-prepare provision-commit provision-verify
      reset-prepare reset-verify reset-commit reset-rollback
      update-verify
      luks-slots
    )
    ;;
  *)
    exit 0
    ;;
esac

# Every path from the entrypoint up to / (or the fixture root) must be a real
# file or directory owned by root, or by the unprivileged caller inside a
# fixture root, and writable by nobody else.
trusted() {
  local path=$1 top=${root:-/} owner mode

  [[ -f $path && -x $path ]] || return 1
  while true; do
    [[ ! -L $path ]] || return 1
    read -r owner mode < <(stat -c '%u %a' -- "$path") || return 1
    if (( owner != 0 )); then
      [[ -n $root ]] && (( EUID != 0 && owner == EUID )) || return 1
    fi
    (( (8#$mode & 8#022) == 0 )) || return 1
    [[ $path != "$top" ]] || return 0
    [[ $path != "/" ]] || return 1
    path=$(dirname -- "$path")
  done
}

entrypoint=$root$implementation/$operation

# The package's own pacman record tells a machine without it from one whose
# copy predates the operation.
installed_version() {
  local record
  for record in "$root/var/lib/pacman/local/$package"-[0-9]*/; do
    [[ -d $record ]] || continue
    record=${record%/}
    printf '%s\n' "${record##*/"$package"-}"
    return 0
  done
  return 1
}

# 3 is a machine without the platform's boot package at all, which a caller may
# tell apart from a failure; 1 is everything else.
if [[ ! -e $entrypoint && ! -L $entrypoint ]]; then
  if listed "$operation" "${required[@]}"; then
    if version=$(installed_version); then
      echo "Error: $operation on $platform needs $implementation/$operation, which $package $version does not provide; update $package" >&2
      exit 1
    fi
    echo "Error: $operation on $platform needs $package, which provides $implementation/$operation; it is not installed" >&2
    exit 3
  fi
  exit 0
fi

if ! trusted "$entrypoint"; then
  echo "Error: refusing $implementation/$operation: it must be a root-owned executable file in root-owned directories, writable by no one else" >&2
  exit 1
fi

if (( resolve )); then
  printf '%s\n' "$entrypoint"
else
  exec /usr/bin/env -i PATH="$fixed_path" "$entrypoint" "$@"
fi
