#!/bin/bash

# omarchy:summary=Set a new encryption password for a drive selected.
# omarchy:requires-sudo=true

# Installation gives the login user, root and the disk holding / one password.
# Changing that disk's password keeps them together: the LUKS key changes first
# and must open the disk before either account changes. The journal records only
# the phase, device and key slot, so a change that stops part way is finished by
# the next run. Other encrypted drives change alone.

REKEY_STATE=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/drive-password.state
source "$OMARCHY_PATH/install/provisioning/luks-rekey.sh"

# The LUKS partition beneath /, when / is encrypted.
root_luks_device() {
  local root_source device
  root_source=$(findmnt -no SOURCE /) || return 0
  device=$(lsblk -nsrpo NAME,FSTYPE "${root_source%%[*}" 2>/dev/null | awk '$2 == "crypto_LUKS" { print $1; exit }')
  [[ -n $device ]] && readlink -f "$device"
}

# The key slot the password opens on the drive, or nothing.
drive_key_slot() {
  local -
  set +x
  local drive=$1 password=$2 out
  out=$(printf '%s' "$password" | sudo env LC_ALL=C cryptsetup open --test-passphrase --verbose --key-file - "$drive" 2>&1) || return 0
  grep -o 'Key slot [0-9]* unlocked' <<<"$out" | grep -o '[0-9]*' | head -1
}

login_user() {
  local user=${SUDO_USER:-$(id -un)}
  [[ -n $user && $user != "root" ]] || return 1
  printf '%s' "$user"
}

change_luks_password() {
  local -
  set +x
  local drive=$1 new_password=$2
  echo "Changing full-disk encryption password for $drive"
  # The new key travels over stdin and reaches cryptsetup as a keyfile via
  # <(cat), leaving the tty free for the current-passphrase prompt.
  printf "%s" "$new_password" | sudo bash -c 'exec cryptsetup luksChangeKey --pbkdf argon2id --iter-time 2000 "$1" <(cat) </dev/tty' bash "$drive"
}

sync_accounts() {
  local -
  set +x
  local user=$1 password=$2
  echo "Setting the login password for $user and root to match"
  printf '%s:%s\n' "$user" "$password" | sudo chpasswd || return 1
  printf 'root:%s\n' "$password" | sudo chpasswd
}

# Phase luks: the key change may or may not have landed. Phase accounts: the
# new key opens the recorded slot and the accounts still need it.
change_system_password() {
  local drive=$1 password=$2 user=$3 slot status=0

  mkdir -p "${REKEY_STATE%/*}" && rekey_state_put device "$drive" phase luks || return 1

  change_luks_password "$drive" "$password" || status=$?
  if (( status != 0 )); then
    rm -f "$REKEY_STATE"
    echo "The disk password did not change, so the login and root passwords did not either."
    return "$status"
  fi

  slot=$(drive_key_slot "$drive" "$password")
  if [[ -z $slot ]]; then
    echo "Could not confirm the new password opens $drive. Run omarchy-drive-password again to finish."
    return 1
  fi
  rekey_state_put slot "$slot" phase accounts || return 1

  if ! sync_accounts "$user" "$password"; then
    echo "The login and root passwords were not updated. Run omarchy-drive-password again to finish."
    return 1
  fi
  rm -f "$REKEY_STATE"
}

# A journal left on this system's disk by a change that stopped part way.
change_pending() {
  local phase drive
  phase=$(rekey_state_get phase) || return 1
  drive=$(rekey_state_get device)
  if [[ $phase == "luks" || $phase == "accounts" ]] && [[ -n $drive && $drive == "$root_drive" ]]; then
    return 0
  fi
  rm -f "$REKEY_STATE"
  return 1
}

# Match the accounts to whichever password opens the disk now. Once the change
# was confirmed only its own slot counts, so another key on the disk (such as a
# recovery passphrase) cannot become the login password.
finish_interrupted_change() {
  local phase drive slot opened password user header

  phase=$(rekey_state_get phase)
  drive=$(rekey_state_get device)
  slot=$(rekey_state_get slot)

  user=$(login_user) || { echo "Run omarchy-drive-password as the user who logs in to finish the last password change."; return 1; }

  echo "The last password change for $drive stopped before the login and root passwords matched it."
  if [[ $phase == "accounts" ]]; then
    header="New encryption password"
  else
    header="Encryption password that opens $drive now (the new one if the change went through)"
  fi
  password=$(gum input --password --header "$header") || return 1

  opened=$(drive_key_slot "$drive" "$password")
  if [[ -z $opened || ( $phase == "accounts" && $opened != "$slot" ) ]]; then
    echo "That password does not open $drive. Run omarchy-drive-password again to finish."
    return 1
  fi

  rekey_state_put slot "$opened" phase accounts || return 1
  sync_accounts "$user" "$password" || return 1
  rm -f "$REKEY_STATE"
  echo "The login and root passwords now match the disk password."
}

change_selected_drive() {
  local encrypted_drives drive_to_change login new_password confirmation system_drive=false

  encrypted_drives=$(blkid -t TYPE=crypto_LUKS -o device)
  if [[ -z $encrypted_drives ]]; then
    echo "No encrypted drives available."
    return 1
  fi

  if (( $(wc -l <<<"$encrypted_drives") == 1 )); then
    drive_to_change="$encrypted_drives"
  else
    drive_to_change="$(omarchy-drive-select "$encrypted_drives")"
  fi

  if [[ -z $drive_to_change ]]; then
    echo "No drive selected."
    return 0
  fi

  if [[ -n $root_drive && $(readlink -f "$drive_to_change") == "$root_drive" ]]; then
    system_drive=true
    login=$(login_user) || { echo "Run omarchy-drive-password as the user who logs in to change the system disk password."; return 1; }
    echo "$drive_to_change holds the system, so its new password also becomes the login password for $login and root."
  fi

  new_password=$(gum input --password --header "New encryption password") || return 1
  [[ -n $new_password ]] || { echo "Password cannot be empty."; return 1; }

  confirmation=$(gum input --password --header "Confirm new encryption password") || return 1
  [[ $new_password == "$confirmation" ]] || { echo "Passwords do not match."; return 1; }

  if [[ $system_drive == "true" ]]; then
    change_system_password "$root_drive" "$new_password" "$login"
  else
    change_luks_password "$drive_to_change" "$new_password"
  fi
}

root_drive=$(root_luks_device)

if change_pending; then
  finish_interrupted_change
else
  change_selected_drive
fi
