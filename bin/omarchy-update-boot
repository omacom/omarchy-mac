#!/bin/bash

# omarchy:summary=Run the platform's boot checks around the update's package changes
# omarchy:args=<preflight|verify>
# omarchy:hidden=true
# omarchy:requires-sudo=true

# preflight can refuse an update the platform could not boot afterwards, before
# any package changes. verify proves that the boot files the package steps left
# boot the updated system, and omarchy update neither finishes nor offers a
# reboot until it passes. Both are lifecycle dispatch operations: no-ops where
# the platform registers no boot package, x86 included, and the platform's own
# entrypoint says what failed.

set -e

case ${1:-} in
  preflight | verify) operation=update-$1 ;;
  *)
    echo "Usage: omarchy-update-boot <preflight|verify>" >&2
    exit 2
    ;;
esac

# Resolving as the user keeps sudo, and its password prompt, out of updates
# with nothing to run. A resolution that fails has said why, and fails the
# check. Root resolves again from its own fixed paths before anything runs.
entrypoint=$(omarchy-lifecycle-dispatch --resolve "$operation")
if [[ -n $entrypoint ]]; then
  sudo omarchy-lifecycle-dispatch "$operation"
fi
