#!/bin/bash

# omarchy:summary=Set the Omarchy package channel.
# omarchy:args=<stable|rc|edge|dev>
# omarchy:requires-sudo=true

set -euo pipefail

usage() { echo "Usage: omarchy-channel-set [stable|rc|edge|dev]"; }
fail() { echo "Error: $*" >&2; exit 1; }

confirm_dev() {
  cat <<'WARNING'

The dev channel links Omarchy directly to a checkout of the source in ~/omarchy.
It's exclusively intended for developers working on Omarchy itself.

WARNING

  gum confirm --default=false "Switch to dev channel?"
}

validate_dev_checkout() {
  local checkout="$1"

  if [[ -e $checkout && ! -d $checkout/.git ]]; then
    fail "$checkout already exists and is not a git checkout."
  fi

  if [[ -d $checkout/.git && ( ! -d $checkout/bin || ! -d $checkout/default || ! -d $checkout/shell ) ]]; then
    fail "$checkout is a git checkout, but it does not look like Omarchy."
  fi
}

prepare_dev_checkout() {
  local checkout="$1"
  [[ -d $checkout/.git ]] || git clone --branch quattro https://github.com/omarchy-mac/omarchy-mac.git "$checkout"

  [[ -f $checkout/install/helpers/arm-channel-manifest.py ]] ||
    fail "$checkout does not support isolated ARM channels yet; update its Mac source branch first."
}

(( $# > 0 )) || { usage; exit 1; }

dev_checkout=""
channel="$1"
leaving_dev=0

case "$channel" in
  stable)
    pacman_channel=stable
    packages=(omarchy omarchy-settings)
    ;;
  rc)
    pacman_channel=rc
    packages=(omarchy omarchy-settings)
    ;;
  edge)
    pacman_channel=edge
    packages=(omarchy-dev omarchy-settings-dev)
    ;;
  dev)
    confirm_dev || { echo "Cancelled."; exit 0; }
    dev_checkout="$HOME/omarchy"
    validate_dev_checkout "$dev_checkout"
    pacman_channel=edge
    packages=(omarchy-dev omarchy-settings-dev)
    ;;
  *)
    echo "Unknown channel: $channel" >&2
    usage >&2
    exit 1
    ;;
esac

# Do not link a checkout or replace configuration until the selected published
# snapshot is complete. dev intentionally consumes the edge package snapshot.
if [[ $(uname -m) == "aarch64" ]]; then
  source "$OMARCHY_PATH/install/helpers/arm-package-sources.sh"
  omarchy_arm_validate_channel "$pacman_channel" || exit 1
fi

if [[ -z $dev_checkout && $OMARCHY_PATH != "/usr/share/omarchy" ]]; then
  leaving_dev=1
fi

if [[ -n $dev_checkout ]]; then
  prepare_dev_checkout "$dev_checkout"
fi

omarchy-refresh-pacman "$pacman_channel"
# --ask 4 accepts omarchy <-> omarchy-dev replacement prompts without file overwrites.
sudo env OMARCHY_UPDATE_PACMAN=1 pacman -S --needed --noconfirm --ask 4 "${packages[@]}"

if [[ -n $dev_checkout ]]; then
  omarchy-dev-link "$dev_checkout" --no-reboot
  omarchy-state set reboot-required
  # The source link takes effect after reboot. Complete this transaction with
  # the channel-capable package code, not scripts from the newly cloned tree.
  export OMARCHY_PATH=/usr/share/omarchy
else
  omarchy-dev-unlink --no-reboot
  export OMARCHY_PATH=/usr/share/omarchy

  if (( leaving_dev )); then
    omarchy-state set reboot-required
  fi
fi

export PATH="/usr/share/omarchy/bin:$PATH"
/usr/share/omarchy/bin/omarchy-update -y
