#!/bin/bash

# omarchy:summary=Upgrade an Omarchy Mac 3.x install to the Quattro source-checkout layout
# omarchy:args=[--yes] [--reboot] [--ref BRANCH]
# omarchy:examples=omarchy upgrade to quattro mac
# omarchy:requires-sudo=true

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: omarchy-upgrade-to-quattro-mac [--yes] [--reboot] [--ref BRANCH]

Upgrade an Omarchy Mac 3.x install to Quattro (Omarchy 4). There are no
Omarchy packages for Apple Silicon, so unlike the upstream x86 upgrade this
keeps Omarchy running from the git checkout at ~/.local/share/omarchy and
wires that checkout into the places a packaged install would occupy.

This script is self-contained so 3.x users can run it directly:

  curl -fsSL https://raw.githubusercontent.com/omarchy-mac/omarchy-mac/quattro/bin/omarchy-upgrade-to-quattro-mac | bash

Options:
  -y, --yes      Do not prompt before upgrading
  --reboot       Reboot automatically after a successful upgrade
  --ref BRANCH   Check out BRANCH instead of quattro
  -h, --help     Show this help
USAGE
}

log() {
  printf '\033[32m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[33mWarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

confirm() {
  local question="$1"

  if command -v gum >/dev/null 2>&1; then
    gum confirm "$question" </dev/tty
  else
    local answer
    read -r -p "$question [y/N] " answer </dev/tty
    [[ $answer == "y" || $answer == "Y" ]]
  fi
}

checkout="$HOME/.local/share/omarchy"
upgrade_ref="${OMARCHY_UPGRADE_REF:-quattro}"
yes=0
auto_reboot=0

while (($#)); do
  case "$1" in
    -y|--yes)
      yes=1
      shift
      ;;
    --reboot)
      auto_reboot=1
      shift
      ;;
    --ref)
      upgrade_ref="${2:-}"
      [[ -n $upgrade_ref ]] || fail "--ref requires a branch name"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

(( EUID != 0 )) || fail "Run this as your regular user, not as root. It uses sudo where needed."
command -v sudo >/dev/null 2>&1 || fail "sudo is required."
command -v pacman >/dev/null 2>&1 || fail "This upgrade is only supported on Arch-based systems with pacman."
command -v yay >/dev/null 2>&1 || fail "yay is required to build AUR packages. Install it first."
[[ $(uname -m) == "aarch64" ]] || fail "This is the Apple Silicon upgrade. On x86 machines use omarchy-upgrade-to-quattro."
grep -qi apple /proc/device-tree/compatible 2>/dev/null || warn "This does not look like Apple hardware; continuing anyway."
[[ -d $checkout/.git ]] || fail "No Omarchy checkout found at $checkout. Is Omarchy Mac 3.x installed?"

if (( ! yes )); then
  cat <<EOF

Upgrading Omarchy Mac to Quattro is a one-way street!
You cannot downgrade to 3.x afterwards.
Make sure you have a backup.

The upgrade will:
  - switch $checkout to the '$upgrade_ref' branch
  - install the Quattro package set (Quickshell and friends; AUR builds take a while)
  - wire the checkout into /usr/share/omarchy, /etc, and /usr/bin
  - replace your Hyprland config (the old one is backed up, not deleted)
  - remove the retired Waybar/Walker/Mako desktop and switch to NetworkManager

EOF
  confirm "Continue with the upgrade?" || exit 0
fi

sudo -v
sudo_keepalive_pid=""
while true; do sudo -n true; sleep 60; done 2>/dev/null &
sudo_keepalive_pid=$!
trap '[[ -n $sudo_keepalive_pid ]] && kill "$sudo_keepalive_pid" 2>/dev/null || true' EXIT

backup_suffix=$(date +%Y%m%d%H%M%S)

backup_user_config() {
  log "Backing up ~/.config to ~/.config.omarchy3.$backup_suffix.bak"
  cp -a "$HOME/.config" "$HOME/.config.omarchy3.$backup_suffix.bak"
}

switch_checkout_to_quattro() {
  log "Switching $checkout to the '$upgrade_ref' branch"

  if [[ -n $(git -C "$checkout" status --porcelain) ]]; then
    fail "The checkout at $checkout has local changes. Commit, stash, or discard them first."
  fi

  git -C "$checkout" fetch origin "$upgrade_ref"
  git -C "$checkout" checkout "$upgrade_ref"
  git -C "$checkout" merge --ff-only "origin/$upgrade_ref"
}

# Refuses to continue unless the checked-out tree is Quattro. Without this a
# wrong ref (the old default was main) got as far as installing packages and
# writing under /usr and /etc before aborting on the first missing file.
validate_quattro_tree() {
  local path version

  version=$(cat "$checkout/version" 2>/dev/null || echo unknown)
  if [[ $version != 4.* ]]; then
    fail "The '$upgrade_ref' tree at $checkout is not Quattro (version: $version). Use --ref quattro or unset OMARCHY_UPGRADE_REF."
  fi

  for path in \
    etc/profile.d/omarchy.sh \
    default/uwsm/env.d/10-omarchy \
    default/environment.d/10-omarchy-fcitx.conf \
    install/omarchy-base.packages; do
    [[ -f $checkout/$path ]] ||
      fail "The '$upgrade_ref' tree at $checkout is missing $path; it does not have the Quattro layout."
  done

  for path in omarchy-apply-system omarchy-provision-user; do
    [[ -x $checkout/bin/$path ]] ||
      fail "The '$upgrade_ref' tree at $checkout is missing bin/$path; it does not have the Quattro layout."
  done

  load_system_path_manifest

  log "The '$upgrade_ref' tree at $checkout is Quattro ($version)"
}

system_path_sources=()
system_path_destinations=()
system_path_policies=()
system_path_source_paths=()
system_profile_source_path=""
system_command_names=()
system_command_source_paths=()
declare -A system_path_seen_destinations=()

# Read and validate the complete fixed-path manifest before wire_system_paths
# invokes sudo. The Mac checkout is user-owned by design, so accepting a path
# outside it or a destination with surprising syntax would turn a data file
# into a privileged command input.
load_system_path_manifest() {
  local manifest="$checkout/default/system-paths.tsv"
  local line line_number=0 source destination policy remainder source_path
  local resolved_checkout resolved_source resolved_profile resolved_command manifest_digest
  local profile_source command_path command_paths expected_rows=19 zram_rows=0
  local expected_manifest_sha256="a8fd68dfc45eddb3160db475874265e573b6cf0333f1e75f9fec840504144f05"
  local zram_source="default/systemd/zram-generator.conf.d/90-omarchy.conf"
  local zram_destination="/usr/lib/systemd/zram-generator.conf.d/90-omarchy.conf"

  [[ -f $manifest && ! -L $manifest ]] ||
    fail "The Quattro tree is missing default/system-paths.tsv."
  resolved_checkout=$(realpath -e -- "$checkout") ||
    fail "The Quattro checkout path cannot be resolved: $checkout"
  [[ -d $resolved_checkout ]] ||
    fail "The Quattro checkout path is not a directory: $checkout"

  system_path_sources=()
  system_path_destinations=()
  system_path_policies=()
  system_path_source_paths=()
  system_profile_source_path=""
  system_command_names=()
  system_command_source_paths=()
  system_path_seen_destinations=()

  while IFS= read -r line || [[ -n $line ]]; do
    ((line_number += 1))

    [[ -n $line ]] || fail "Invalid system path manifest row $line_number: blank rows are not allowed."
    [[ $line == \#* ]] && continue

    [[ $line == *$'\t'* ]] ||
      fail "Invalid system path manifest row $line_number: expected three tab-separated fields."
    source=${line%%$'\t'*}
    remainder=${line#*$'\t'}
    [[ $remainder == *$'\t'* ]] ||
      fail "Invalid system path manifest row $line_number: expected three tab-separated fields."
    destination=${remainder%%$'\t'*}
    policy=${remainder#*$'\t'}
    [[ $policy != *$'\t'* ]] ||
      fail "Invalid system path manifest row $line_number: extra fields are not allowed."

    [[ -n $source && -n $destination && -n $policy ]] ||
      fail "Invalid system path manifest row $line_number: fields cannot be empty."
    [[ $source != *[[:space:][:cntrl:]]* && $destination != *[[:space:][:cntrl:]]* ]] ||
      fail "Invalid system path manifest row $line_number: paths cannot contain whitespace or control characters."

    case "$source" in
      /*|*/|*//*|.|./*|*/./*|*/.|..|../*|*/../*)
        fail "Invalid system path manifest row $line_number: source is not canonical: $source"
        ;;
    esac
    case "$destination" in
      /|/*/|*//*|/./*|*/./*|*/.|/../*|*/..|*/../*)
        fail "Invalid system path manifest row $line_number: destination is not canonical: $destination"
        ;;
      /*) ;;
      *)
        fail "Invalid system path manifest row $line_number: destination is not absolute: $destination"
        ;;
    esac

    case "$policy" in
      copy|link) ;;
      *) fail "Invalid system path manifest row $line_number: unknown policy: $policy" ;;
    esac

    [[ -z ${system_path_seen_destinations[$destination]+seen} ]] ||
      fail "Invalid system path manifest row $line_number: duplicate destination: $destination"
    source_path="$checkout/$source"
    [[ -f $source_path && ! -L $source_path ]] ||
      fail "Invalid system path manifest row $line_number: source is not a regular file: $source"
    resolved_source=$(realpath -e -- "$source_path") ||
      fail "Invalid system path manifest row $line_number: source cannot be resolved: $source"
    [[ $resolved_source == "$resolved_checkout"/* ]] ||
      fail "Invalid system path manifest row $line_number: source resolves outside the checkout: $source"

    if [[ $source == "$zram_source" || $destination == "$zram_destination" ]]; then
      ((zram_rows += 1))
      [[ $source == "$zram_source" && $destination == "$zram_destination" && $policy == "copy" ]] ||
        fail "Invalid system path manifest row $line_number: zram drop-in must be the canonical copy row."
    fi

    system_path_sources+=("$source")
    system_path_destinations+=("$destination")
    system_path_policies+=("$policy")
    system_path_source_paths+=("$resolved_source")
    system_path_seen_destinations["$destination"]=1
  done <"$manifest"

  (( ${#system_path_sources[@]} == expected_rows )) ||
    fail "The system path manifest must contain exactly $expected_rows data rows."
  (( zram_rows == 1 )) || fail "The system path manifest must contain exactly one canonical zram drop-in row."
  manifest_digest=$(sha256sum -- "$manifest") ||
    fail "The system path manifest checksum could not be calculated."
  [[ ${manifest_digest%% *} == "$expected_manifest_sha256" ]] ||
    fail "The system path manifest does not match the canonical fixed-path contract."

  profile_source="$checkout/etc/profile.d/omarchy.sh"
  [[ -f $profile_source && ! -L $profile_source ]] ||
    fail "The Quattro tree profile source is not a regular file: etc/profile.d/omarchy.sh"
  resolved_profile=$(realpath -e -- "$profile_source") ||
    fail "The Quattro tree profile source cannot be resolved: etc/profile.d/omarchy.sh"
  [[ $resolved_profile == "$resolved_checkout"/* ]] ||
    fail "The Quattro tree profile source resolves outside the checkout: etc/profile.d/omarchy.sh"
  system_profile_source_path="$resolved_profile"

  command_paths=("$checkout/bin"/omarchy-*)
  [[ -e ${command_paths[0]} ]] ||
    fail "The Quattro tree has no bin/omarchy-* commands."
  for command_path in "${command_paths[@]}"; do
    [[ -e $command_path || -L $command_path ]] || continue
    if [[ ! -f $command_path || -L $command_path ]]; then
      fail "The Quattro tree command is not a regular file: ${command_path##*/}"
    fi
    resolved_command=$(realpath -e -- "$command_path") ||
      fail "The Quattro tree command cannot be resolved: ${command_path##*/}"
    [[ $resolved_command == "$resolved_checkout"/* ]] ||
      fail "The Quattro tree command resolves outside the checkout: ${command_path##*/}"
    system_command_names+=("${command_path##*/}")
    system_command_source_paths+=("$resolved_command")
  done
  (( ${#system_command_source_paths[@]} )) ||
    fail "The Quattro tree has no regular bin/omarchy-* command files."
}

# A 3.x machine's /etc/pacman.conf predates the [omarchy-aarch64] repo. Without
# it, every Quattro package that the ARM repo serves as a prebuilt binary
# resolves to an hours-long AUR build instead -- quickshell-git's build even
# fails outright on Wayland-only systems whose GL stack predates the upgrade
# (#208). Even when the stanza is already present, refresh it: an old sync db
# can still point at package files the ARM mirror has removed. Must run before
# install_quattro_packages.
ensure_arm_package_repo() {
  if ! grep -q '^\[omarchy-aarch64\]' /etc/pacman.conf; then
    local block
    block=$(sed -n '/^\[omarchy-aarch64\]/,/^Server[[:space:]]*=/p' \
      "$checkout/default/pacman/pacman-stable.conf")
    [[ -n $block ]] || fail "default/pacman/pacman-stable.conf has no [omarchy-aarch64] section."

    log "Adding the Omarchy ARM package repo"
    printf '\n%s\n' "$block" | sudo tee -a /etc/pacman.conf >/dev/null
  fi

  log "Refreshing package databases for ARM packages"
  if ! sudo pacman -Sy --noconfirm; then
    fail "Could not refresh package databases. Fix the network or mirror configuration and retry the Quattro upgrade."
  fi
}

# install.sh keeps the packages with no aarch64 build out of the set rather than
# spend hours on one that fails an architecture check. The upgrade reads the same
# list, so a 3.x machine is not the one path that still attempts them.
load_unavailable_packages() {
  local unavailable="$checkout/install/omarchy-aarch64-unavailable.packages" line

  unavailable_packages=()
  [[ -f $unavailable ]] || return 0

  while read -r line; do
    [[ -n $line ]] && unavailable_packages+=("$line")
  done < <(grep -vE '^[[:space:]]*(#|$)' "$unavailable")
}

package_is_unavailable_here() {
  local package="$1" candidate

  for candidate in ${unavailable_packages[@]+"${unavailable_packages[@]}"}; do
    [[ $candidate == "$package" ]] && return 0
  done

  return 1
}

install_quattro_packages() {
  local package skipped=() unbuildable=()

  load_unavailable_packages

  log "Installing the Quattro package set (this builds AUR packages and takes a while)"
  while read -r package; do
    # OMARCHY_TRY_UNAVAILABLE=1 attempts them anyway: an AUR package can gain
    # aarch64 support at any time, so a stale entry costs a flag, not a release.
    if [[ ${OMARCHY_TRY_UNAVAILABLE:-0} != "1" ]] && package_is_unavailable_here "$package"; then
      unbuildable+=("$package")
      continue
    fi
    if ! yay -S --needed --noconfirm "$package" </dev/null; then
      skipped+=("$package")
    fi
  done < <(grep -vE '^\s*(#|$)' "$checkout/install/omarchy-base.packages")

  # Apple GPUs cannot run gpu-screen-recorder; screen recording falls back to
  # wf-recorder. Keep this optional like the default package pass: a missing
  # recording backend must not leave the upgrade half-complete.
  yay -S --needed --noconfirm wf-recorder </dev/null || skipped+=("wf-recorder")

  if (( ${#unbuildable[@]} )); then
    log "No aarch64 build is known, so these were not attempted: ${unbuildable[*]}"
  fi

  if (( ${#skipped[@]} )); then
    warn "Skipped packages that would not install on aarch64: ${skipped[*]}"
  fi
}

wire_system_paths() {
  log "Wiring the checkout into /usr/share/omarchy, /etc, and /usr/bin"

  load_system_path_manifest

  sudo ln -sfnT "$checkout" /usr/share/omarchy
  printf 'export OMARCHY_PATH=%q\n' "$checkout" | sudo tee /etc/omarchy.conf >/dev/null

  sudo install -Dm644 -T "$system_profile_source_path" /etc/profile.d/omarchy.sh

  local index source destination policy source_path command command_source
  for index in "${!system_path_sources[@]}"; do
    source=${system_path_sources[$index]}
    destination=${system_path_destinations[$index]}
    policy=${system_path_policies[$index]}
    source_path=${system_path_source_paths[$index]}
    sudo install -d -m755 "$(dirname -- "$destination")"
    if [[ $policy == "copy" ]]; then
      sudo install -Dm644 -T "$source_path" "$destination"
    else
      sudo ln -sfnT "$source_path" "$destination"
    fi
  done

  # Omarchy's systemd units start commands by their /usr/bin/omarchy-* path,
  # which packaged installs provide. Symlink the checkout's commands there.
  for index in "${!system_command_names[@]}"; do
    command=${system_command_names[$index]}
    command_source=${system_command_source_paths[$index]}
    sudo ln -sfnT "$command_source" "/usr/bin/$command"
  done
}

update_bashrc() {
  local bashrc="$HOME/.bashrc" line replaced=0 rewritten

  if grep -q "env-bootstrap" "$bashrc" 2>/dev/null; then
    return 0
  fi

  log "Updating ~/.bashrc to the Quattro bootstrap"
  cp "$bashrc" "$bashrc.omarchy3.$backup_suffix.bak"

  rewritten=$(mktemp)
  while IFS= read -r line; do
    # Replace the 3.x line that sourced the checkout's bash rc directly.
    if [[ $line == *"share/omarchy/default/bash/rc"* && $line != \#* ]]; then
      if (( ! replaced )); then
        printf '%s\n' '[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap' >>"$rewritten"
        printf '%s\n' 'source "$OMARCHY_PATH/default/bash/rc"' >>"$rewritten"
        replaced=1
      fi
      continue
    fi
    printf '%s\n' "$line" >>"$rewritten"
  done <"$bashrc"

  if (( ! replaced )); then
    printf '%s\n' '[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap' >>"$rewritten"
    printf '%s\n' 'source "$OMARCHY_PATH/default/bash/rc"' >>"$rewritten"
  fi

  mv "$rewritten" "$bashrc"
}

replace_hyprland_config() {
  log "Replacing the Hyprland config with Quattro defaults"

  if [[ -d $HOME/.config/hypr ]]; then
    mv "$HOME/.config/hypr" "$HOME/.config/hypr.omarchy3.$backup_suffix.bak"
  fi
  mkdir -p "$HOME/.config/hypr" "$HOME/.config/omarchy"
  cp -R "$checkout/config/hypr/." "$HOME/.config/hypr/"
  cp -R "$checkout/config/omarchy/." "$HOME/.config/omarchy/"
}

run_quattro_setup() {
  log "Running Quattro system setup"
  sudo omarchy-apply-system --install-user "$USER" --upgrade

  log "Running Quattro user setup and migrations"
  export OMARCHY_PATH="$checkout"
  export PATH="$checkout/bin:$PATH"
  omarchy-provision-user --force
  omarchy-migrate
}

retire_legacy_packages() {
  local retired_packages=(
    waybar
    walker
    omarchy-walker
    elephant
    elephant-all
    elephant-bluetooth
    elephant-calc
    elephant-clipboard
    elephant-desktopapplications
    elephant-files
    elephant-menus
    elephant-providerlist
    elephant-runner
    elephant-symbols
    elephant-todo
    elephant-unicode
    elephant-websearch
    mako
    swayosd
    hypridle
    hyprlock
    satty
    swaybg
    polkit-gnome
  )

  log "Removing the retired 3.x desktop stack"
  local package
  for package in "${retired_packages[@]}"; do
    pacman -Q "$package" &>/dev/null || continue
    sudo pacman -Rns --noconfirm "$package" || warn "Could not remove '$package'; leaving it installed."
  done
}

switch_to_networkmanager() {
  if ! pacman -Q networkmanager &>/dev/null; then
    warn "NetworkManager is not installed; leaving iwd in charge of networking."
    return 0
  fi

  log "Switching networking from iwd to NetworkManager (takes effect after reboot)"
  sudo systemctl enable NetworkManager >/dev/null 2>&1 || true
  sudo systemctl disable iwd >/dev/null 2>&1 || true
}

# Everything that changes the system lives behind main, so a truncated
# curl | bash download cannot run half an upgrade.
main() {
  backup_user_config
  switch_checkout_to_quattro
  validate_quattro_tree
  ensure_arm_package_repo
  install_quattro_packages
  wire_system_paths
  update_bashrc
  replace_hyprland_config
  run_quattro_setup
  retire_legacy_packages
  switch_to_networkmanager

  log "Upgrade complete. Reboot to start the Quattro desktop."
  echo "After rebooting: pick your theme again with 'omarchy theme set <name>',"
  echo "and use 'omarchy update' for all future updates."

  if (( auto_reboot )); then
    sudo reboot
  elif (( ! yes )) && confirm "Reboot now?"; then
    sudo reboot
  fi
}

main
