#!/bin/bash

# omarchy:summary=Upgrade an Omarchy Mac 3.x install to the Quattro source-checkout layout
# omarchy:args=[--yes] [--reboot] [--ref BRANCH]
# omarchy:examples=omarchy upgrade to quattro mac
# omarchy:requires-sudo=true

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: omarchy-upgrade-to-quattro-mac [--yes] [--reboot] [--ref BRANCH]

Upgrade an Omarchy Mac 3.x install to Quattro (Omarchy 4). There are no
Omarchy packages for Apple Silicon, so unlike the upstream x86 upgrade this
keeps Omarchy running from the git checkout at ~/.local/share/omarchy and
wires that checkout into the places a packaged install would occupy.

This script is self-contained so 3.x users can run it directly:

  curl -fsSL https://raw.githubusercontent.com/omarchy-mac/omarchy-mac/quattro/bin/omarchy-upgrade-to-quattro-mac | bash

Options:
  -y, --yes      Do not prompt before upgrading
  --reboot       Reboot automatically after a successful upgrade
  --ref BRANCH   Check out BRANCH instead of quattro
  -h, --help     Show this help
USAGE
}

log() {
  printf '\033[32m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[33mWarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

confirm() {
  local question="$1"

  if command -v gum >/dev/null 2>&1; then
    gum confirm "$question" </dev/tty
  else
    local answer
    read -r -p "$question [y/N] " answer </dev/tty
    [[ $answer == "y" || $answer == "Y" ]]
  fi
}

checkout="$HOME/.local/share/omarchy"
upgrade_ref="${OMARCHY_UPGRADE_REF:-quattro}"
yes=0
auto_reboot=0

while (($#)); do
  case "$1" in
    -y|--yes)
      yes=1
      shift
      ;;
    --reboot)
      auto_reboot=1
      shift
      ;;
    --ref)
      upgrade_ref="${2:-}"
      [[ -n $upgrade_ref ]] || fail "--ref requires a branch name"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

(( EUID != 0 )) || fail "Run this as your regular user, not as root. It uses sudo where needed."
command -v sudo >/dev/null 2>&1 || fail "sudo is required."
command -v pacman >/dev/null 2>&1 || fail "This upgrade is only supported on Arch-based systems with pacman."
command -v yay >/dev/null 2>&1 || fail "yay is required to build AUR packages. Install it first."
[[ $(uname -m) == "aarch64" ]] || fail "This is the Apple Silicon upgrade. On x86 machines use omarchy-upgrade-to-quattro."
grep -qi apple /proc/device-tree/compatible 2>/dev/null || warn "This does not look like Apple hardware; continuing anyway."
[[ -d $checkout/.git ]] || fail "No Omarchy checkout found at $checkout. Is Omarchy Mac 3.x installed?"

if (( ! yes )); then
  cat <<EOF

Upgrading Omarchy Mac to Quattro is a one-way street!
You cannot downgrade to 3.x afterwards.
Make sure you have a backup.

The upgrade will:
  - switch $checkout to the '$upgrade_ref' branch
  - install the Quattro package set (Quickshell and friends; AUR builds take a while)
  - wire the checkout into /usr/share/omarchy, /etc, and /usr/bin
  - replace your Hyprland config (the old one is backed up, not deleted)
  - remove the retired Waybar/Walker/Mako desktop and switch to NetworkManager

EOF
  confirm "Continue with the upgrade?" || exit 0
fi

sudo -v
sudo_keepalive_pid=""
while true; do sudo -n true; sleep 60; done 2>/dev/null &
sudo_keepalive_pid=$!
trap '[[ -n $sudo_keepalive_pid ]] && kill "$sudo_keepalive_pid" 2>/dev/null || true' EXIT

backup_suffix=$(date +%Y%m%d%H%M%S)

backup_user_config() {
  log "Backing up ~/.config to ~/.config.omarchy3.$backup_suffix.bak"
  cp -a "$HOME/.config" "$HOME/.config.omarchy3.$backup_suffix.bak"
}

switch_checkout_to_quattro() {
  log "Switching $checkout to the '$upgrade_ref' branch"

  if [[ -n $(git -C "$checkout" status --porcelain) ]]; then
    fail "The checkout at $checkout has local changes. Commit, stash, or discard them first."
  fi

  git -C "$checkout" fetch origin "$upgrade_ref"
  git -C "$checkout" checkout "$upgrade_ref"
  git -C "$checkout" merge --ff-only "origin/$upgrade_ref"
}

# Refuses to continue unless the checked-out tree is Quattro. Without this a
# wrong ref (the old default was main) got as far as installing packages and
# writing under /usr and /etc before aborting on the first missing file.
validate_quattro_tree() {
  local path version

  version=$(cat "$checkout/version" 2>/dev/null || echo unknown)
  if [[ $version != 4.* ]]; then
    fail "The '$upgrade_ref' tree at $checkout is not Quattro (version: $version). Use --ref quattro or unset OMARCHY_UPGRADE_REF."
  fi

  for path in \
    etc/profile.d/omarchy.sh \
    default/uwsm/env.d/10-omarchy \
    default/environment.d/10-omarchy-fcitx.conf \
    install/omarchy-base.packages; do
    [[ -f $checkout/$path ]] ||
      fail "The '$upgrade_ref' tree at $checkout is missing $path; it does not have the Quattro layout."
  done

  for path in omarchy-apply-system omarchy-provision-user; do
    [[ -x $checkout/bin/$path ]] ||
      fail "The '$upgrade_ref' tree at $checkout is missing bin/$path; it does not have the Quattro layout."
  done

  log "The '$upgrade_ref' tree at $checkout is Quattro ($version)"
}

# A 3.x machine's /etc/pacman.conf predates the [omarchy-aarch64] repo. Without
# it, every Quattro package that the ARM repo serves as a prebuilt binary
# resolves to an hours-long AUR build instead -- quickshell-git's build even
# fails outright on Wayland-only systems whose GL stack predates the upgrade
# (#208). Even when the stanza is already present, refresh it: an old sync db
# can still point at package files the ARM mirror has removed. Must run before
# install_quattro_packages.
ensure_arm_package_repo() {
  if ! grep -q '^\[omarchy-aarch64\]' /etc/pacman.conf; then
    local block
    block=$(sed -n '/^\[omarchy-aarch64\]/,/^Server[[:space:]]*=/p' \
      "$checkout/default/pacman/pacman-stable.conf")
    [[ -n $block ]] || fail "default/pacman/pacman-stable.conf has no [omarchy-aarch64] section."

    log "Adding the Omarchy ARM package repo"
    printf '\n%s\n' "$block" | sudo tee -a /etc/pacman.conf >/dev/null
  fi

  log "Refreshing package databases for ARM packages"
  if ! sudo pacman -Sy --noconfirm; then
    fail "Could not refresh package databases. Fix the network or mirror configuration and retry the Quattro upgrade."
  fi
}

# install.sh keeps the packages with no aarch64 build out of the set rather than
# spend hours on one that fails an architecture check. The upgrade reads the same
# list, so a 3.x machine is not the one path that still attempts them.
load_unavailable_packages() {
  local unavailable="$checkout/install/omarchy-aarch64-unavailable.packages" line

  unavailable_packages=()
  [[ -f $unavailable ]] || return 0

  while read -r line; do
    [[ -n $line ]] && unavailable_packages+=("$line")
  done < <(grep -vE '^[[:space:]]*(#|$)' "$unavailable")
}

package_is_unavailable_here() {
  local package="$1" candidate

  for candidate in ${unavailable_packages[@]+"${unavailable_packages[@]}"}; do
    [[ $candidate == "$package" ]] && return 0
  done

  return 1
}

install_quattro_packages() {
  local package skipped=() unbuildable=()

  load_unavailable_packages

  log "Installing the Quattro package set (this builds AUR packages and takes a while)"
  while read -r package; do
    # OMARCHY_TRY_UNAVAILABLE=1 attempts them anyway: an AUR package can gain
    # aarch64 support at any time, so a stale entry costs a flag, not a release.
    if [[ ${OMARCHY_TRY_UNAVAILABLE:-0} != "1" ]] && package_is_unavailable_here "$package"; then
      unbuildable+=("$package")
      continue
    fi
    if ! yay -S --needed --noconfirm "$package" </dev/null; then
      skipped+=("$package")
    fi
  done < <(grep -vE '^\s*(#|$)' "$checkout/install/omarchy-base.packages")

  # Apple GPUs cannot run gpu-screen-recorder; screen recording falls back to
  # wf-recorder. Keep this optional like the default package pass: a missing
  # recording backend must not leave the upgrade half-complete.
  yay -S --needed --noconfirm wf-recorder </dev/null || skipped+=("wf-recorder")

  if (( ${#unbuildable[@]} )); then
    log "No aarch64 build is known, so these were not attempted: ${unbuildable[*]}"
  fi

  if (( ${#skipped[@]} )); then
    warn "Skipped packages that would not install on aarch64: ${skipped[*]}"
  fi
}

wire_system_paths() {
  log "Wiring the checkout into /usr/share/omarchy, /etc, and /usr/bin"

  sudo ln -sfn "$checkout" /usr/share/omarchy
  printf 'export OMARCHY_PATH="%s"\n' "$checkout" | sudo tee /etc/omarchy.conf >/dev/null

  sudo install -Dm644 "$checkout/etc/profile.d/omarchy.sh" /etc/profile.d/omarchy.sh
  sudo install -Dm644 "$checkout/default/uwsm/env.d/10-omarchy" /usr/share/uwsm/env.d/10-omarchy
  sudo install -Dm644 "$checkout/default/environment.d/10-omarchy-fcitx.conf" /usr/lib/environment.d/10-omarchy-fcitx.conf

  # Omarchy's systemd units start commands by their /usr/bin/omarchy-* path,
  # which packaged installs provide. Symlink the checkout's commands there.
  local command
  for command in "$checkout/bin"/omarchy-*; do
    sudo ln -sf "$command" "/usr/bin/$(basename "$command")"
  done
}

# These paths are deliberately narrow. The transition owns only the files it
# names here; unrelated SDDM/systemd configuration is left untouched.
sddm_alias=/etc/systemd/system/display-manager.service
sddm_dropin=/etc/systemd/system/sddm.service.d/wait-for-display.conf
seamless_unit=/etc/systemd/system/omarchy-seamless-login.service
seamless_unit_name=omarchy-seamless-login.service
seamless_dropin_dir=/etc/systemd/system/omarchy-seamless-login.service.d
seamless_dropin=/etc/systemd/system/omarchy-seamless-login.service.d/require-sddm.conf
seamless_wait_dropin=/etc/systemd/system/omarchy-seamless-login.service.d/wait-for-display.conf
sddm_autologin=/etc/sddm.conf.d/autologin.conf
sddm_system_conf_dir=/usr/lib/sddm/sddm.conf.d
sddm_admin_conf_dir=/etc/sddm.conf.d
sddm_conf=/etc/sddm.conf
seamless_graphical_link=/etc/systemd/system/graphical.target.wants/omarchy-seamless-login.service
seamless_multi_user_link=/etc/systemd/system/multi-user.target.wants/omarchy-seamless-login.service
seamless_default_link=/etc/systemd/system/default.target.wants/omarchy-seamless-login.service
legacy_seamless_helper=/usr/local/bin/seamless-login
legacy_wait_helper=/usr/local/bin/omarchy-wait-for-display
legacy_getty_dropin=/etc/systemd/system/getty@tty1.service.d/autologin.conf
legacy_plymouth_dropin=/etc/systemd/system/plymouth-quit.service.d/wait-for-graphical.conf
sddm_wayland_session_dir=/usr/share/wayland-sessions
sddm_local_wayland_session_dir=/usr/local/share/wayland-sessions
systemd_state_status=0
systemd_state_output=
autologin_user=
autologin_session=
sddm_session_dir=
login_cleanup_only=0
preserve_autologin=0

capture_systemd_state() {
  systemd_state_status=0
  systemd_state_output=$(sudo env LC_ALL=C systemctl is-enabled "$1" 2>&1) || systemd_state_status=$?
}

require_enabled_sddm() {
  capture_systemd_state sddm.service
  [[ $systemd_state_status == 0 && $systemd_state_output == "enabled" ]] ||
    fail "SDDM is not exactly enabled (status $systemd_state_status: $systemd_state_output)"
}

validate_sddm_alias() {
  local fragment alias_target
  if [[ ! -e $sddm_alias && ! -L $sddm_alias ]]; then
    return 0
  fi
  [[ -L $sddm_alias ]] || fail "Existing $sddm_alias is not a symlink"
  fragment=$(sudo env LC_ALL=C systemctl show -p FragmentPath --value sddm.service 2>&1) ||
    fail "Could not resolve SDDM FragmentPath: $fragment"
  [[ -f $fragment ]] || fail "SDDM FragmentPath is not a regular file: $fragment"
  alias_target=$(sudo readlink -f "$sddm_alias" 2>&1) ||
    fail "Could not resolve $sddm_alias: $alias_target"
  [[ $alias_target == "$fragment" ]] ||
    fail "$sddm_alias does not resolve to SDDM ($alias_target != $fragment)"
  capture_systemd_state sddm.service
  [[ $systemd_state_status == 0 && $systemd_state_output == "enabled" ]] ||
    fail "Existing SDDM alias is not backed by exactly enabled SDDM (status $systemd_state_status: $systemd_state_output)"
}

require_sddm_alias() {
  [[ -e $sddm_alias || -L $sddm_alias ]] || fail "SDDM display-manager alias is missing"
  validate_sddm_alias
}

inspect_sddm_config() {
  local file="$1" line section=
  [[ -r $file ]] || fail "Cannot read SDDM configuration: $file"
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z $line || ${line:0:1} == "#" || ${line:0:1} == ";" ]] && continue
    if [[ $line =~ ^\[([^]]+)\]$ ]]; then
      section=${BASH_REMATCH[1]}
    elif [[ $section == "Wayland" && $line =~ ^SessionDir[[:space:]]*=(.*)$ ]]; then
      sddm_session_dir=${BASH_REMATCH[1]}
      sddm_session_dir="${sddm_session_dir#"${sddm_session_dir%%[![:space:]]*}"}"
      sddm_session_dir="${sddm_session_dir%"${sddm_session_dir##*[![:space:]]}"}"
      if [[ ${sddm_session_dir:0:1} == "\"" && ${sddm_session_dir: -1} == "\"" ]] ||
         [[ ${sddm_session_dir:0:1} == "'" && ${sddm_session_dir: -1} == "'" ]]; then
        sddm_session_dir=${sddm_session_dir:1:${#sddm_session_dir}-2}
      fi
    fi
  done <"$file"
}

inspect_sddm_config_dir() {
  local dir="$1" file
  [[ ! -e $dir ]] && return 0
  [[ -d $dir && -r $dir ]] || fail "Cannot read SDDM configuration directory: $dir"
  while IFS= read -r file; do
    [[ -e $file ]] || continue
    inspect_sddm_config "$file"
  done < <(printf '%s\n' "$dir"/*.conf | LC_ALL=C sort)
}

validate_sddm_session_dir() {
  sddm_session_dir=
  inspect_sddm_config_dir "$sddm_system_conf_dir"
  inspect_sddm_config_dir "$sddm_admin_conf_dir"
  [[ ! -e $sddm_conf ]] || inspect_sddm_config "$sddm_conf"
  if [[ -n $sddm_session_dir && $sddm_session_dir != "/usr/share/wayland-sessions" &&
        $sddm_session_dir != "/usr/local/share/wayland-sessions" ]]; then
    fail "Unsupported effective SDDM Wayland SessionDir: $sddm_session_dir"
  fi
}

session_file_path() {
  local session="$1" dir
  [[ -n $session && $session != */* ]] || return 1
  for dir in "$sddm_wayland_session_dir" "$sddm_local_wayland_session_dir"; do
    if [[ -f $dir/$session ]]; then
      printf '%s\n' "$dir/$session"
      return 0
    fi
  done
  return 1
}

read_existing_autologin() {
  local line section='' value
  autologin_user=
  autologin_session=
  [[ -e $sddm_autologin ]] || return 1
  [[ -f $sddm_autologin && -r $sddm_autologin ]] || fail "Invalid SDDM autologin file: $sddm_autologin"
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z $line || ${line:0:1} == "#" || ${line:0:1} == ";" ]] && continue
    if [[ $line =~ ^\[([^]]+)\]$ ]]; then
      section=${BASH_REMATCH[1]}
    elif [[ $section == "Autologin" && $line =~ ^User[[:space:]]*=(.*)$ ]]; then
      value=${BASH_REMATCH[1]}
      autologin_user="${value#"${value%%[![:space:]]*}"}"
      autologin_user="${autologin_user%"${autologin_user##*[![:space:]]}"}"
    elif [[ $section == "Autologin" && $line =~ ^Session[[:space:]]*=(.*)$ ]]; then
      value=${BASH_REMATCH[1]}
      autologin_session="${value#"${value%%[![:space:]]*}"}"
      autologin_session="${autologin_session%"${autologin_session##*[![:space:]]}"}"
    fi
  done <"$sddm_autologin"
  [[ -n $autologin_user && -n $autologin_session ]] || fail "Malformed SDDM autologin file: $sddm_autologin"
  id "$autologin_user" >/dev/null 2>&1 || fail "SDDM autologin user does not exist: $autologin_user"
  session_file_path "$autologin_session" >/dev/null || fail "SDDM autologin Session is not installed: $autologin_session"
  return 0
}

write_root_file() {
  local destination="$1" contents="$2" temporary parent
  parent=$(dirname "$destination")
  temporary=$(sudo mktemp "$parent/.omarchy-login.XXXXXX")
  printf '%s\n' "$contents" | sudo tee "$temporary" >/dev/null
  sudo chmod 644 "$temporary"
  sudo mv -f "$temporary" "$destination"
}

install_login_interlock() {
  local dropin_dir
  dropin_dir=$(dirname "$seamless_dropin")
  sudo mkdir -p "$dropin_dir"
  write_root_file "$seamless_dropin" $'[Unit]\nConditionPathExists=!/etc/systemd/system/display-manager.service'
  sudo grep -Fx 'ConditionPathExists=!/etc/systemd/system/display-manager.service' "$seamless_dropin" >/dev/null ||
    fail "Seamless-login interlock drop-in is invalid"
}

install_sddm_display_guard() {
  local dropin_dir
  [[ -x $checkout/bin/omarchy-system-wait-for-display ]] || fail "Missing display guard in selected checkout"
  dropin_dir=$(dirname "$sddm_dropin")
  sudo mkdir -p "$dropin_dir"
  write_root_file "$sddm_dropin" $'[Service]\nExecStartPre=/usr/bin/omarchy-system-wait-for-display'
  sudo grep -Fx 'ExecStartPre=/usr/bin/omarchy-system-wait-for-display' "$sddm_dropin" >/dev/null ||
    fail "SDDM display guard drop-in is invalid"
  sudo test -x /usr/bin/omarchy-system-wait-for-display || fail "Display guard was not installed"
}

verify_login_interlock() {
  [[ -f $seamless_dropin ]] || fail "Seamless-login interlock is missing"
  sudo grep -Fx 'ConditionPathExists=!/etc/systemd/system/display-manager.service' "$seamless_dropin" >/dev/null ||
    fail "Seamless-login interlock is invalid"
}

verify_sddm_display_guard() {
  [[ -f $sddm_dropin ]] || fail "SDDM display guard drop-in is missing"
  sudo grep -Fx 'ExecStartPre=/usr/bin/omarchy-system-wait-for-display' "$sddm_dropin" >/dev/null ||
    fail "SDDM display guard drop-in is invalid"
  sudo test -x /usr/bin/omarchy-system-wait-for-display || fail "SDDM display guard is not executable"
}

prepare_login_transition() {
  local seamless_state preserve=0
  capture_systemd_state "$seamless_unit_name"
  if [[ $systemd_state_status == 0 && $systemd_state_output == "enabled" ]]; then
    seamless_state=enabled
  elif (( systemd_state_status != 0 )) &&
       [[ $systemd_state_output == "disabled" || $systemd_state_output == "not-found" ]]; then
    seamless_state=$systemd_state_output
  else
    fail "Cannot classify seamless-login state (status $systemd_state_status: $systemd_state_output)"
  fi
  if [[ ($seamless_state == "disabled" || $seamless_state == "not-found") ]] && legacy_artifacts_present; then
    require_sddm_alias
    login_cleanup_only=1
  fi
  validate_sddm_alias
  validate_sddm_session_dir
  if read_existing_autologin; then
    preserve=1
  fi
  preserve_autologin=$preserve
  if (( login_cleanup_only )); then
    install_sddm_display_guard
    return 0
  fi
  if [[ $seamless_state == enabled ]]; then
    preserve=1
    [[ -n $autologin_user ]] || autologin_user=$USER
  fi
  preserve_autologin=$preserve
  if [[ -f $seamless_unit ]]; then
    install_login_interlock
    sudo systemctl daemon-reload
    verify_login_interlock
  fi
  install_sddm_display_guard
  if (( preserve )); then
    [[ -n $autologin_user ]] || fail "Autologin preservation has no user"
    sudo env OMARCHY_PATH="$checkout" "$checkout/bin/omarchy-mac-setup" --autologin --user "$autologin_user"
    read_existing_autologin || fail "mac-setup did not produce valid SDDM autologin"
  fi
  sudo systemctl daemon-reload
}

legacy_artifacts_present() {
  local path
  for path in "$seamless_unit" "$seamless_dropin_dir" "$seamless_dropin" "$seamless_wait_dropin" \
    "$seamless_graphical_link" "$seamless_multi_user_link" "$seamless_default_link" \
    "$legacy_seamless_helper" "$legacy_wait_helper" "$legacy_getty_dropin" "$legacy_plymouth_dropin"; do
    [[ -e $path || -L $path ]] && return 0
  done
  return 1
}

remove_legacy_login_artifacts() {
  # Keep each mutation separate so interruption leaves an observable,
  # cleanup-pending state which the next invocation can safely resume.
  sudo rm -f "$seamless_unit"
  if [[ ${OMARCHY_LOGIN_TRANSITION_INTERRUPT_AFTER_UNIT:-0} == "1" ]]; then
    fail "Interrupted after removing seamless-login unit; rerun to resume cleanup"
  fi
  sudo rm -f "$seamless_dropin" "$seamless_wait_dropin"
  sudo rmdir "$seamless_dropin_dir" 2>/dev/null || true
  sudo rm -f "$seamless_graphical_link" "$seamless_multi_user_link" "$seamless_default_link"
  sudo rm -f "$legacy_seamless_helper" "$legacy_wait_helper"
  sudo rm -f "$legacy_getty_dropin" "$legacy_plymouth_dropin"
}

cleanup_login_transition() {
  local artifacts=0
  legacy_artifacts_present && artifacts=1 || true
  require_enabled_sddm
  require_sddm_alias
  capture_systemd_state "$seamless_unit_name"
  if [[ $systemd_state_status == 0 && $systemd_state_output == "enabled" ]]; then
    sudo systemctl disable omarchy-seamless-login.service
    capture_systemd_state "$seamless_unit_name"
    if (( systemd_state_status == 0 )) ||
       [[ $systemd_state_output != "disabled" && $systemd_state_output != "not-found" ]]; then
      fail "Disable did not leave a classified seamless-login state (status $systemd_state_status: $systemd_state_output)"
    fi
  elif (( systemd_state_status == 0 )) ||
       [[ $systemd_state_output != "disabled" && $systemd_state_output != "not-found" ]]; then
    fail "Cannot classify post-setup seamless-login state (status $systemd_state_status: $systemd_state_output)"
  fi
  if [[ $systemd_state_output == "not-found" && $artifacts == 1 ]]; then
    validate_sddm_alias
  fi
  remove_legacy_login_artifacts
  sudo systemctl daemon-reload
  require_enabled_sddm
  require_sddm_alias
  verify_sddm_display_guard
  capture_systemd_state "$seamless_unit_name"
  if (( systemd_state_status == 0 )) ||
     [[ $systemd_state_output != "disabled" && $systemd_state_output != "not-found" ]]; then
    fail "Final seamless-login state is not disabled or not-found (status $systemd_state_status: $systemd_state_output)"
  fi
  if (( preserve_autologin )); then
    read_existing_autologin || fail "Preserved SDDM autologin is no longer valid"
  fi
  legacy_artifacts_present && fail "Legacy login artifacts remain after cleanup" || true
}

update_bashrc() {
  local bashrc="$HOME/.bashrc" line replaced=0 rewritten

  if grep -q "env-bootstrap" "$bashrc" 2>/dev/null; then
    return 0
  fi

  log "Updating ~/.bashrc to the Quattro bootstrap"
  cp "$bashrc" "$bashrc.omarchy3.$backup_suffix.bak"

  rewritten=$(mktemp)
  while IFS= read -r line; do
    # Replace the 3.x line that sourced the checkout's bash rc directly.
    if [[ $line == *"share/omarchy/default/bash/rc"* && $line != \#* ]]; then
      if (( ! replaced )); then
        printf '%s\n' '[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap' >>"$rewritten"
        printf '%s\n' 'source "$OMARCHY_PATH/default/bash/rc"' >>"$rewritten"
        replaced=1
      fi
      continue
    fi
    printf '%s\n' "$line" >>"$rewritten"
  done <"$bashrc"

  if (( ! replaced )); then
    printf '%s\n' '[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap' >>"$rewritten"
    printf '%s\n' 'source "$OMARCHY_PATH/default/bash/rc"' >>"$rewritten"
  fi

  mv "$rewritten" "$bashrc"
}

replace_hyprland_config() {
  log "Replacing the Hyprland config with Quattro defaults"

  if [[ -d $HOME/.config/hypr ]]; then
    mv "$HOME/.config/hypr" "$HOME/.config/hypr.omarchy3.$backup_suffix.bak"
  fi
  mkdir -p "$HOME/.config/hypr" "$HOME/.config/omarchy"
  cp -R "$checkout/config/hypr/." "$HOME/.config/hypr/"
  cp -R "$checkout/config/omarchy/." "$HOME/.config/omarchy/"
}

run_quattro_setup() {
  log "Running Quattro system setup"
  sudo omarchy-apply-system --install-user "$USER" --upgrade

  log "Running Quattro user setup and migrations"
  export OMARCHY_PATH="$checkout"
  export PATH="$checkout/bin:$PATH"
  omarchy-provision-user --force
  omarchy-migrate
}

retire_legacy_packages() {
  local retired_packages=(
    waybar
    walker
    omarchy-walker
    elephant
    elephant-all
    elephant-bluetooth
    elephant-calc
    elephant-clipboard
    elephant-desktopapplications
    elephant-files
    elephant-menus
    elephant-providerlist
    elephant-runner
    elephant-symbols
    elephant-todo
    elephant-unicode
    elephant-websearch
    mako
    swayosd
    hypridle
    hyprlock
    satty
    swaybg
    polkit-gnome
  )

  log "Removing the retired 3.x desktop stack"
  local package
  for package in "${retired_packages[@]}"; do
    pacman -Q "$package" &>/dev/null || continue
    sudo pacman -Rns --noconfirm "$package" || warn "Could not remove '$package'; leaving it installed."
  done
}

switch_to_networkmanager() {
  if ! pacman -Q networkmanager &>/dev/null; then
    warn "NetworkManager is not installed; leaving iwd in charge of networking."
    return 0
  fi

  log "Switching networking from iwd to NetworkManager (takes effect after reboot)"
  sudo systemctl enable NetworkManager >/dev/null 2>&1 || true
  sudo systemctl disable iwd >/dev/null 2>&1 || true
}

# Everything that changes the system lives behind main, so a truncated
# curl | bash download cannot run half an upgrade.
main() {
  backup_user_config
  switch_checkout_to_quattro
  validate_quattro_tree
  ensure_arm_package_repo
  install_quattro_packages
  wire_system_paths
  prepare_login_transition
  if (( ! login_cleanup_only )); then
    update_bashrc
    replace_hyprland_config
    run_quattro_setup
  fi
  cleanup_login_transition
  retire_legacy_packages
  switch_to_networkmanager

  log "Upgrade complete. Reboot to start the Quattro desktop."
  echo "After rebooting: pick your theme again with 'omarchy theme set <name>',"
  echo "and use 'omarchy update' for all future updates."

  if (( auto_reboot )); then
    sudo reboot
  elif (( ! yes )) && confirm "Reboot now?"; then
    sudo reboot
  fi
}

main
