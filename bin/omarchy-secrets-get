#!/usr/bin/python3
# omarchy:summary=Print a stored secret to stdout
# omarchy:group=secrets
# omarchy:args=<service> <account>
"""Print a secret from the default Secret Service keyring.

The value is written to stdout with no trailing newline so it can be piped
into wl-copy or captured by a caller. When several items share the same
service/account attribute pair the first match is returned and a warning is
printed to stderr.
"""

import sys

try:
    import gi

    gi.require_version("Secret", "1")
    from gi.repository import GLib, Secret
except (ImportError, ValueError):
    sys.exit("error: python-gobject is required (pacman -S python-gobject)")

# DONT_MATCH_NAME keeps the schema out of matching: searches subset-match on
# the service/account attributes so items written by other tools (omaseal,
# keytar, seahorse) are still found.
SCHEMA = Secret.Schema.new(
    "org.freedesktop.Secret.Generic",
    Secret.SchemaFlags.DONT_MATCH_NAME,
    {"service": Secret.SchemaAttributeType.STRING, "account": Secret.SchemaAttributeType.STRING},
)


def main():
    if len(sys.argv) != 3:
        sys.exit("Usage: omarchy-secrets-get <service> <account>")
    service, account = sys.argv[1], sys.argv[2]

    try:
        svc = Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
        matches = (
            Secret.Service.search_sync(
                svc,
                SCHEMA,
                {"service": service, "account": account},
                Secret.SearchFlags.ALL
                | Secret.SearchFlags.UNLOCK
                | Secret.SearchFlags.LOAD_SECRETS,
                None,
            )
            or []
        )
        if not matches:
            sys.exit(f"error: no secret stored for {service} / {account}")
        if len(matches) > 1:
            print(
                f"warning: {len(matches)} items match {service} / {account}; returning the first",
                file=sys.stderr,
            )
        secret = matches[0].get_secret().get_text()
        if secret is None:
            sys.exit(f"error: could not read secret for {service} / {account}")
        sys.stdout.write(secret)
    except GLib.Error as e:
        sys.exit(f"error: {e.message}")


if __name__ == "__main__":
    main()
