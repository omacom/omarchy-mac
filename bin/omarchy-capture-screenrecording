#!/bin/bash

# omarchy:summary=Start or stop screen recording
# omarchy:group=capture
# omarchy:args=[--fullscreen] [--with-desktop-audio] [--with-microphone-audio] [--with-webcam] [--show-keystrokes] [--webcam-device=<device>] [--webcam-size=<small|medium|large>] [--resolution=<size>] [--stop-recording]
# omarchy:examples=omarchy screenrecord | omarchy capture screenrecording --with-desktop-audio
# omarchy:aliases=omarchy screenrecord
#
# Env: OMARCHY_SCREENRECORD_USE_PORTAL=true skips the built-in slurp picker and
# uses gpu-screen-recorder's xdg-desktop-portal capture backend instead. The
# portal backend was originally added (PR #3401) for HDR-aware capture, support
# for monitors driven by external GPUs, and window capture — enable it if any
# of those matter to you. Off by default because the portal path can fail EGL
# DMA-BUF modifier import on some configurations, leaving recording unable to
# start.
#
# Env: OMARCHY_SCREENRECORD_DEBUG=true appends the recorder's stderr (and the
# picker target it was launched with) to /tmp/omarchy-screenrecord.log so users
# can attach a log when reporting capture failures.
#
# Backend: gpu-screen-recorder everywhere, except Apple Silicon (Asahi), where
# it can't run — it only recognizes NVIDIA/AMD/Intel/Broadcom GPUs and aborts
# with "unknown gpu vendor: Mesa" during GL init, before capture ever starts.
# There we fall back to wf-recorder (CPU/libx264); Asahi exposes no supported
# hardware video encoder anyway, so software encoding is the only option. The
# picker, file naming, notifications and post-processing are shared; only the
# recorder invocation differs. wf-recorder captures one audio device, so
# --with-desktop-audio + --with-microphone-audio together are routed through a
# temporary null sink. Portal capture and the --resolution flag are
# gpu-screen-recorder-only and ignored on the wf-recorder backend.

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  omarchy-notification-send -u critical -t 3000 "Screen recording directory does not exist: $OUTPUT_DIR"
  exit 1
fi

DESKTOP_AUDIO="false"
MICROPHONE_AUDIO="false"
WEBCAM="false"
SHOW_KEYSTROKES="false"
WEBCAM_DEVICE=""
WEBCAM_SIZE="medium"
RESOLUTION=""
FULLSCREEN="false"
STOP_RECORDING="false"
RECORDING_FILE="/tmp/omarchy-screenrecord-filename"
REGION_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-screenrecord-region"
LOG_FILE=$([[ ${OMARCHY_SCREENRECORD_DEBUG:-false} == "true" ]] && echo "/tmp/omarchy-screenrecord.log" || echo "/dev/null")

# Matches whichever recorder backend is running, so stop/toggle/active checks
# work regardless of which one started the recording.
RECORDER_PROCESS_RE="^(gpu-screen-recorder|wf-recorder)"
# Records the PulseAudio module ids of a combined-audio null sink for cleanup.
PA_MODULES_FILE="/tmp/omarchy-screenrecord-pa-modules"
# Records the overlay and recorder process identities. PID plus start time lets
# cleanup and the detached watchdog leave unrelated or later instances alone.
KEYSTROKE_OVERLAY_STATE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-screenrecord-showmethekey.pid"
REC_PID=""
KEYSTROKE_OVERLAY_WATCHDOG=""
KEYSTROKE_OVERLAY_STARTUP_OWNED="false"

# gpu-screen-recorder can't initialize on Apple Silicon's Asahi GPU (see header),
# so use wf-recorder there. Elsewhere prefer gpu-screen-recorder, falling back to
# wf-recorder only if gpu-screen-recorder isn't installed.
select_recorder_backend() {
  if grep -qa apple /proc/device-tree/compatible 2>/dev/null; then
    echo "wf-recorder"
  elif omarchy-cmd-present gpu-screen-recorder; then
    echo "gpu-screen-recorder"
  elif omarchy-cmd-present wf-recorder; then
    echo "wf-recorder"
  else
    echo "gpu-screen-recorder"
  fi
}
RECORDER_BACKEND=$(select_recorder_backend)

for arg in "$@"; do
  case "$arg" in
  --with-desktop-audio) DESKTOP_AUDIO="true" ;;
  --with-microphone-audio) MICROPHONE_AUDIO="true" ;;
  --with-webcam) WEBCAM="true" ;;
  --show-keystrokes) SHOW_KEYSTROKES="true" ;;
  --webcam-device=*) WEBCAM_DEVICE="${arg#*=}" ;;
  --webcam-size=*) WEBCAM_SIZE="${arg#*=}" ;;
  --resolution=*) RESOLUTION="${arg#*=}" ;;
  --fullscreen) FULLSCREEN="true" ;;
  --stop-recording) STOP_RECORDING="true" ;;
  --keystroke-overlay-watchdog=*) KEYSTROKE_OVERLAY_WATCHDOG="${arg#*=}" ;;
  esac
done

case $WEBCAM_SIZE in
small | medium | large) ;;
*)
  echo "Invalid webcam size: $WEBCAM_SIZE (expected small, medium, or large)" >&2
  exit 1
  ;;
esac

process_start_time() {
  local stat fields
  IFS= read -r stat 2>/dev/null <"/proc/$1/stat" || return 1
  read -ra fields <<<"${stat#*) }"
  ((${#fields[@]} > 19)) || return 1
  printf '%s\n' "${fields[19]}"
}

keystroke_overlay_process_matches() {
  local pid=$1 started_at=$2 command_line
  [[ $pid =~ ^[0-9]+$ && $started_at =~ ^[0-9]+$ ]] || return 1
  [[ $(process_start_time "$pid") == "$started_at" ]] || return 1
  command_line=$(ps -p "$pid" -o args= 2>/dev/null) || return 1
  [[ $command_line =~ ^([^[:space:]]*/)?showmethekey-gtk([[:space:]]|$) ]]
}

terminate_keystroke_overlay() {
  local pid=$1 started_at=$2 count=0
  keystroke_overlay_process_matches "$pid" "$started_at" || return

  kill "$pid" 2>/dev/null
  while keystroke_overlay_process_matches "$pid" "$started_at" && ((count < 20)); do
    sleep 0.05
    ((count++))
  done
  if keystroke_overlay_process_matches "$pid" "$started_at"; then
    kill -9 "$pid" 2>/dev/null
  fi
}

cleanup_keystroke_overlay() {
  local state pid started_at
  [[ -f $KEYSTROKE_OVERLAY_STATE ]] || return
  state=$(<"$KEYSTROKE_OVERLAY_STATE")
  read -r pid started_at _ <<<"$state"
  terminate_keystroke_overlay "$pid" "$started_at"
  [[ -f $KEYSTROKE_OVERLAY_STATE && $(<"$KEYSTROKE_OVERLAY_STATE") == "$state" ]] &&
    rm -f "$KEYSTROKE_OVERLAY_STATE"
}

cleanup_starting_keystroke_overlay() {
  if [[ $KEYSTROKE_OVERLAY_STARTUP_OWNED == "true" ]]; then
    cleanup_keystroke_overlay
  fi
}

watch_keystroke_overlay() {
  local overlay_pid=$1 overlay_started_at=$2 recorder_pid=$3 recorder_started_at=$4
  [[ $overlay_pid =~ ^[0-9]+$ && $overlay_started_at =~ ^[0-9]+$ &&
    $recorder_pid =~ ^[0-9]+$ && $recorder_started_at =~ ^[0-9]+$ ]] || return 1
  local expected_state="$overlay_pid $overlay_started_at $recorder_pid $recorder_started_at"

  while [[ $(process_start_time "$recorder_pid") == "$recorder_started_at" ]]; do
    sleep 0.2
  done

  [[ -f $KEYSTROKE_OVERLAY_STATE ]] || return
  [[ $(<"$KEYSTROKE_OVERLAY_STATE") == "$expected_state" ]] || return
  terminate_keystroke_overlay "$overlay_pid" "$overlay_started_at"
  [[ -f $KEYSTROKE_OVERLAY_STATE && $(<"$KEYSTROKE_OVERLAY_STATE") == "$expected_state" ]] &&
    rm -f "$KEYSTROKE_OVERLAY_STATE"
}

handoff_keystroke_overlay() {
  local recorder_pid=$1 recorder_started_at overlay_pid overlay_started_at
  local next_state="${KEYSTROKE_OVERLAY_STATE}.tmp"
  read -r overlay_pid overlay_started_at _ <"$KEYSTROKE_OVERLAY_STATE"
  keystroke_overlay_process_matches "$overlay_pid" "$overlay_started_at" || return 1
  recorder_started_at=$(process_start_time "$recorder_pid") || return 1

  if ! printf '%s %s %s %s\n' "$overlay_pid" "$overlay_started_at" "$recorder_pid" "$recorder_started_at" >"$next_state" ||
    ! mv -f "$next_state" "$KEYSTROKE_OVERLAY_STATE"; then
    rm -f "$next_state"
    return 1
  fi
  setsid -f "$0" --keystroke-overlay-watchdog="$overlay_pid:$overlay_started_at:$recorder_pid:$recorder_started_at" </dev/null &>/dev/null || return 1

  KEYSTROKE_OVERLAY_STARTUP_OWNED="false"
  trap - EXIT HUP INT TERM
}

if [[ -n $KEYSTROKE_OVERLAY_WATCHDOG ]]; then
  IFS=: read -r overlay_pid overlay_started_at recorder_pid recorder_started_at <<<"$KEYSTROKE_OVERLAY_WATCHDOG"
  watch_keystroke_overlay "$overlay_pid" "$overlay_started_at" "$recorder_pid" "$recorder_started_at"
  exit 0
fi

start_keystroke_overlay() {
  cleanup_keystroke_overlay

  if omarchy-cmd-missing showmethekey-gtk; then
    omarchy-notification-send -u critical -t 5000 "Show Me The Key is not installed" "Install it with: omarchy pkg add showmethekey"
    return 1
  fi

  showmethekey-gtk -k -A -C &>/dev/null &
  local pid=$! started_at
  started_at=$(process_start_time "$pid") || {
    omarchy-notification-send -u critical -t 5000 "Keystroke overlay failed to start" "Screen recording was not started."
    kill "$pid" 2>/dev/null
    return 1
  }
  if ! printf '%s %s\n' "$pid" "$started_at" >"$KEYSTROKE_OVERLAY_STATE"; then
    omarchy-notification-send -u critical -t 5000 "Keystroke overlay state could not be saved" "Screen recording was not started."
    kill "$pid" 2>/dev/null
    return 1
  fi
  KEYSTROKE_OVERLAY_STARTUP_OWNED="true"
  trap cleanup_starting_keystroke_overlay EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  local waited=0
  while ((waited < 600)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      omarchy-notification-send -u critical -t 5000 "Keystroke overlay failed to start" "Screen recording was not started."
      cleanup_keystroke_overlay
      return 1
    fi

    if hyprctl clients -j | jq -e --argjson pid "$pid" \
      'any(.[]; .pid == $pid and (.class == "showmethekey-gtk" or .class == "one.alynx.showmethekey") and .title == "Floating Window - Show Me The Key")' >/dev/null 2>&1; then
      omarchy-notification-send -u critical -t 8000 "Visible keystrokes will be recorded" "Show Me The Key displays every key you type, including passwords. Quickly press Alt twice to pause it."
      return 0
    fi

    sleep 0.05
    ((waited++))
  done

  omarchy-notification-send -u critical -t 5000 "Keystroke overlay did not appear" "Screen recording was not started."
  cleanup_keystroke_overlay
  return 1
}

start_webcam_overlay() {
  cleanup_webcam

  # Auto-detect first available webcam if none specified
  if [[ -z $WEBCAM_DEVICE ]]; then
    WEBCAM_DEVICE=$(omarchy-capture-webcam-list | sed -n '1s/[[:space:]].*//p')
    if [[ -z $WEBCAM_DEVICE ]]; then
      omarchy-notification-send -u critical -t 3000 "No webcam devices found"
      return 1
    fi
  fi

  # Try preferred 16:9 resolutions in order, use first available
  local preferred_resolutions=("640x360" "1280x720" "1920x1080")
  local capture_options="framerate=30"
  local available_formats=$(v4l2-ctl --list-formats-ext -d "$WEBCAM_DEVICE" 2>/dev/null)

  for resolution in "${preferred_resolutions[@]}"; do
    if echo "$available_formats" | grep -q "$resolution"; then
      capture_options="video_size=$resolution,$capture_options"
      break
    fi
  done

  mpv "av://v4l2:$WEBCAM_DEVICE" \
    --profile=low-latency --untimed --no-cache \
    --demuxer-lavf-o="$capture_options" \
    '--vf=lavfi=[crop=ih*8/9:ih]' \
    --title="WebcamOverlay" --wayland-app-id="WebcamOverlay-$WEBCAM_SIZE" \
    --no-border --no-audio --no-osc --osd-level=0 \
    --really-quiet &>/dev/null &

  # The move has to settle before gpu-screen-recorder starts, or the camera is
  # recorded sliding into its corner. Waiting for the map is what the blind
  # second was partly guessing at, so the remainder is trimmed to hold the
  # pre-capture delay where it was: starting later costs the first words spoken.
  local waited=0
  while ((waited < 40)) && ! hyprctl clients -j | jq -e 'any(.[]; .title == "WebcamOverlay")' >/dev/null 2>&1; do
    sleep 0.05
    ((waited++))
  done

  [[ ${1:-} == region:* ]] && echo "${1#region:}" >"$REGION_FILE"
  omarchy-capture-webcam-resize "$WEBCAM_SIZE"

  sleep 0.6
}

cleanup_webcam() {
  pkill -f "WebcamOverlay" 2>/dev/null
  rm -f "$REGION_FILE"
}

default_resolution() {
  local width height
  read -r width height < <(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.width) \(.height)"')
  if ((width > 3840 || height > 2160)); then
    echo "3840x2160"
  else
    echo "0x0"
  fi
}

# Echoes "monitor:NAME" when the selection matches an entire monitor (prefer
# -w <monitor> over a region capture — same kms backend, but no scaling math
# and full native res), otherwise "region:WxH+X+Y". Returns non-zero if the
# user cancelled the picker.
select_capture_target() {
  local target
  target=$(omarchy-capture-region smart --match-monitor) || return 1

  if [[ $target == monitor:* ]]; then
    echo "$target"
    return
  fi

  [[ $target =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1

  # gpu-screen-recorder wants region geometry in the compositor's logical
  # coordinate space — same space slurp returns — so pass the values through
  # untouched. (gsr scales to physical pixels itself based on the monitor.)
  echo "region:${BASH_REMATCH[3]}x${BASH_REMATCH[4]}+${BASH_REMATCH[1]}+${BASH_REMATCH[2]}"
}

# wf-recorder records a single audio device. Map the desktop/mic flags onto one:
# desktop -> default sink monitor, mic -> default source. When both are requested,
# route them through a throwaway null sink so a single track carries both; the
# module ids are saved to PA_MODULES_FILE so stop can unload them.
wf_audio_device() {
  local sink source m
  if [[ $DESKTOP_AUDIO == "true" && $MICROPHONE_AUDIO == "true" ]]; then
    sink=$(pactl get-default-sink 2>/dev/null)
    source=$(pactl get-default-source 2>/dev/null)
    if [[ -n $sink && -n $source ]] &&
      m=$(pactl load-module module-null-sink sink_name=omarchy_screenrec sink_properties=device.description=omarchy_screenrec 2>/dev/null); then
      : >"$PA_MODULES_FILE"
      echo "$m" >>"$PA_MODULES_FILE"
      m=$(pactl load-module module-loopback source="${sink}.monitor" sink=omarchy_screenrec latency_msec=20 2>/dev/null) && echo "$m" >>"$PA_MODULES_FILE"
      m=$(pactl load-module module-loopback source="$source" sink=omarchy_screenrec latency_msec=20 2>/dev/null) && echo "$m" >>"$PA_MODULES_FILE"
      echo "omarchy_screenrec.monitor"
      return
    fi
    # Combined sink unavailable: fall back to desktop audio alone.
    [[ -n $sink ]] && echo "${sink}.monitor"
  elif [[ $DESKTOP_AUDIO == "true" ]]; then
    sink=$(pactl get-default-sink 2>/dev/null)
    [[ -n $sink ]] && echo "${sink}.monitor"
  elif [[ $MICROPHONE_AUDIO == "true" ]]; then
    pactl get-default-source 2>/dev/null
  fi
}

wf_audio_cleanup() {
  [[ -f $PA_MODULES_FILE ]] || return
  # Unload in reverse so the loopbacks drop before the null sink they feed.
  tac "$PA_MODULES_FILE" 2>/dev/null | while read -r m; do
    [[ -n $m ]] && pactl unload-module "$m" 2>/dev/null
  done
  rm -f "$PA_MODULES_FILE"
}

# Launches wf-recorder for the given picker target, backgrounded, with REC_PID set.
launch_wf_recorder() {
  local target=$1 filename=$2
  local geom_args=()

  case $target in
  monitor:*)
    geom_args=(-o "${target#monitor:}")
    ;;
  region:*)
    # region:WxH+X+Y (logical coords) -> wf-recorder -g "X,Y WxH" (same space).
    [[ ${target#region:} =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
    geom_args=(-g "${BASH_REMATCH[3]},${BASH_REMATCH[4]} ${BASH_REMATCH[1]}x${BASH_REMATCH[2]}")
    ;;
  *)
    return 1
    ;;
  esac

  local audio_args=() dev
  dev=$(wf_audio_device)
  [[ -n $dev ]] && audio_args=(--audio="$dev")

  # -r 60 caps the framerate: capturing a 120 Hz panel at its native rate makes
  # needlessly large files. wf-recorder's default libx264 is CPU-encoded, which
  # is the only option on Asahi (no supported hardware encoder).
  wf-recorder "${geom_args[@]}" -r 60 "${audio_args[@]}" -f "$filename" 2>>"$LOG_FILE" &
  REC_PID=$!
}

start_screenrecording() {
  local capture_args=()
  local target

  # Opt-in path for HDR, external-GPU monitors, and window capture (all things
  # the portal backend supports and the kms backend doesn't). Default flow uses
  # slurp + the kms backend, which avoids the EGL DMA-BUF modifier import
  # failures the portal path can hit on some configurations.
  if [[ $FULLSCREEN == "true" ]]; then
    target="monitor:$(omarchy-hyprland-monitor-focused)"
    capture_args=(-w "${target#monitor:}" -s "${RESOLUTION:-$(default_resolution)}")
  elif [[ $RECORDER_BACKEND == "gpu-screen-recorder" && ${OMARCHY_SCREENRECORD_USE_PORTAL:-false} == "true" ]]; then
    target="portal"
    capture_args=(-w portal -s "${RESOLUTION:-$(default_resolution)}")
  else
    target=$(select_capture_target) || return 1

    case $target in
    monitor:*)
      capture_args=(-w "${target#monitor:}" -s "${RESOLUTION:-$(default_resolution)}")
      ;;
    region:*)
      capture_args=(-w "${target#region:}")
      [[ -n $RESOLUTION ]] && capture_args+=(-s "$RESOLUTION")
      ;;
    esac
  fi

  if [[ $SHOW_KEYSTROKES == "true" && $target == "portal" ]]; then
    omarchy-notification-send -u critical -t 5000 "Keystroke overlay cannot be recorded through the portal" "Use monitor or region capture with --show-keystrokes."
    return 1
  fi

  [[ $WEBCAM == "true" ]] && start_webcam_overlay "$target"
  if [[ $SHOW_KEYSTROKES == "true" ]]; then
    start_keystroke_overlay || return 1
  fi

  local filename="$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"

  echo "===== $(date '+%F %T') args: $* backend: $RECORDER_BACKEND target: $target =====" >>"$LOG_FILE"

  local pid
  if [[ $RECORDER_BACKEND == "wf-recorder" ]]; then
    launch_wf_recorder "$target" "$filename" || return 1
    pid=$REC_PID
  else
    local audio_devices=""
    local audio_args=()

    [[ $DESKTOP_AUDIO == "true" ]] && audio_devices+="default_output"

    if [[ $MICROPHONE_AUDIO == "true" ]]; then
      # Merge audio tracks into one - separate tracks only play one at a time in most players
      [[ -n $audio_devices ]] && audio_devices+="|"
      audio_devices+="default_input"
    fi

    [[ -n $audio_devices ]] && audio_args+=(-a "$audio_devices" -ac aac)

    gpu-screen-recorder "${capture_args[@]}" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes -o "$filename" "${audio_args[@]}" 2>>"$LOG_FILE" &
    pid=$!
  fi

  while kill -0 $pid 2>/dev/null && [[ ! -f $filename ]]; do
    sleep 0.2
  done

  if kill -0 $pid 2>/dev/null; then
    if [[ $SHOW_KEYSTROKES == "true" ]] && ! handoff_keystroke_overlay "$pid"; then
      kill -SIGINT "$pid" 2>/dev/null
      return 1
    fi
    echo "$filename" >"$RECORDING_FILE"
    toggle_screenrecording_indicator
  elif [[ $SHOW_KEYSTROKES == "true" ]]; then
    return 1
  fi
}

stop_screenrecording() {
  pkill -SIGINT -f "$RECORDER_PROCESS_RE" # SIGINT required to save video properly

  # Wait a maximum of 5 seconds to finish before hard killing
  local count=0
  while pgrep -f "$RECORDER_PROCESS_RE" >/dev/null && ((count < 50)); do
    sleep 0.1
    count=$((count + 1))
  done

  toggle_screenrecording_indicator
  cleanup_webcam
  cleanup_keystroke_overlay
  wf_audio_cleanup

  if pgrep -f "$RECORDER_PROCESS_RE" >/dev/null; then
    pkill -9 -f "$RECORDER_PROCESS_RE"
    omarchy-notification-send -u critical -t 5000 "Screen recording error" "Recording process had to be force-killed. Video may be corrupted."
  else
    finalize_recording
    local filename=$(cat "$RECORDING_FILE" 2>/dev/null)
    echo "$filename"
    local preview="${filename%.mp4}-preview.png"

    # Generate a preview thumbnail from the first frame
    ffmpeg -y -i "$filename" -ss 00:00:00.1 -vframes 1 -q:v 2 "$preview" -loglevel quiet 2>/dev/null

    omarchy-notification-send "Screen recording saved" "Open with Super + Alt + , (or click this)" \
      -t 10000 --image "${preview:-$filename}" \
      --exec mpv -- "$filename"

    # The shell loads the thumbnail into memory when the toast appears and never
    # re-reads the file, so the preview only has to outlive that load -- not the
    # toast. Clear it out of the recordings directory a moment later.
    (
      sleep 2
      rm -f "$preview"
    ) &
  fi

  rm -f "$RECORDING_FILE"
}

toggle_screenrecording_indicator() {
  omarchy-shell -q omarchy.indicators refresh
}

screenrecording_active() {
  pgrep -f "$RECORDER_PROCESS_RE" >/dev/null
}

finalize_recording() {
  local latest
  latest=$(cat "$RECORDING_FILE" 2>/dev/null)
  [[ -f $latest ]] || return

  # Re-encode only when the first GOP contains discardable warmup packets — stream copy can't
  # trim those (it rewinds to the keyframe). Clean recordings stay on the fast stream-copy path.
  local video_codec=(-c:v copy)
  if ffprobe -v error -select_streams v:0 -read_intervals %+0.2 -show_entries packet=flags -of csv=p=0 "$latest" 2>/dev/null | grep -q D; then
    video_codec=(-c:v libx264 -preset veryfast -crf 20)
  fi

  # Trim the first frame, and normalize audio to -14 LUFS if present, in a single pass
  local args=(-y -ss 0.1 -i "$latest" "${video_codec[@]}")
  if ffprobe -v error -select_streams a -show_entries stream=codec_type -of csv=p=0 "$latest" 2>/dev/null | grep -q audio; then
    # Hard-mute the first 400ms to drop the PipeWire capture-open pop (a near-clipping
    # transient around 130-200ms that a gentle fade-in can't attenuate enough), then a
    # 50ms fade avoids a click at the boundary before loudnorm normalizes the rest.
    args+=(-af "volume=enable='lt(t,0.4)':volume=0,afade=t=in:st=0.4:d=0.05,loudnorm=I=-14:TP=-1.5:LRA=11")
  fi

  local processed="${latest%.mp4}-processed.mp4"
  if ffmpeg "${args[@]}" "$processed" -loglevel quiet 2>/dev/null; then
    mv "$processed" "$latest"
  else
    rm -f "$processed"
  fi
}

if screenrecording_active; then
  stop_screenrecording
elif [[ $STOP_RECORDING == "true" ]]; then
  cleanup_keystroke_overlay
  exit 1
else
  if ! start_screenrecording; then
    cleanup_webcam
    if [[ $SHOW_KEYSTROKES == "true" ]]; then
      cleanup_keystroke_overlay
      exit 1
    fi
  fi
fi
