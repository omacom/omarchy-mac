--- a/pkgbuilds/omarchy-settings/omarchy-settings.install
+++ b/pkgbuilds/omarchy-settings/omarchy-settings.install
@@ -16,13 +16,18 @@
   # Apple Silicon installs run on Arch Linux ARM's base with the Asahi
   # packages, and keep that system identity: /etc/os-release stays the
   # symlink to the distribution's /usr/lib/os-release, and the PAM, NSS,
-  # plymouth and skel overrides below are not applied there.
+  # plymouth overrides below are not applied there. The Mac profile still
+  # publishes the skel shell startup used by its installer.
   if _apple_silicon; then
     echo "Preserving Arch Linux ARM system configuration on Apple Silicon..."
     if [[ -f /usr/lib/os-release ]]; then
       rm -f /etc/os-release
       ln -s ../usr/lib/os-release /etc/os-release
     fi
+    # /etc/skel/.bashrc belongs to bash, so publish our shipped startup file
+    # through the scriptlet. The installer later copies skel to the new owner.
+    # Keep the Apple PAM/NSS/Plymouth policy above and existing users untouched.
+    install -Dm644 /usr/share/omarchy/etc-overrides/dot.bashrc /etc/skel/.bashrc
     return 0
   fi
 
