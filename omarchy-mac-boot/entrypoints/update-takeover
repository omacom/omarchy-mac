#!/bin/bash -p

# omarchy-lifecycle-dispatch update-takeover <path>..., run before an update
# moves aside files no package owns so an Omarchy package's upgrade can install
# its own. Read-only. The Mac's boot chain and pacman configuration are written
# by its image and this package, not Omarchy's packages, and moving one aside
# can leave the Mac unable to boot or update: any such path refuses the whole
# takeover (exit 1), so every file stays. So does an mkinitcpio file whose own
# HOOKS line carries the asahi or busybox encrypt hook: the HOOKS baseline sorts
# before it, so replacing it switches a legacy Mac's initramfs to the systemd
# line while GRUB still unlocks with cryptdevice=. Anything else may go,
# including the memory, USB and mkinitcpio drop-ins omarchy-settings ships on
# aarch64 too.

set -euo pipefail

# Unprivileged tests stage the files under a fixture root.
root=""
if (( EUID != 0 )); then
  root=${OMARCHY_MAC_BOOT_ROOT:-}
fi

# A top-level line only: an indented one sits in a branch, as in the HOOKS
# baseline itself, and doesn't say what this Mac boots. An unreadable file
# can't be checked, so it counts.
platform_hooks() {
  [[ -e $root$1 ]] || return 1
  [[ -r $root$1 ]] || return 0
  grep -Eq '^HOOKS\+?=\(([^)#]*[[:space:]])?(asahi|encrypt)([[:space:]][^)#]*)?\)' "$root$1"
}

for path in "$@"; do
  case $path in
    /boot | /boot/* | /etc/default/grub | /etc/grub | /etc/grub/* | /etc/limine | /etc/limine/* | \
      /etc/pacman.conf | /etc/pacman.d | /etc/pacman.d/* | /usr/lib/initcpio | /usr/lib/initcpio/*)
      echo "Refusing to replace Apple Silicon platform path: $path" >&2
      exit 1
      ;;
    /etc/mkinitcpio.conf)
      if platform_hooks "$path"; then
        echo "Refusing to replace $path: its HOOKS set how this Mac's initramfs unlocks and boots" >&2
        exit 1
      fi
      ;;
    /etc/mkinitcpio.conf.d/*)
      if platform_hooks "$path"; then
        echo "Refusing to replace $path: its HOOKS set how this Mac's initramfs unlocks and boots; move that HOOKS line into /etc/mkinitcpio.conf, then run omarchy update again" >&2
        exit 1
      fi
      ;;
  esac
done
