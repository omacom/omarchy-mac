#!/bin/bash -p

# omarchy-lifecycle-dispatch setup-boot [image-first-boot]. The platform setup
# leaf runs this at the end of hardware setup, before omarchy-mac's
# setup-system: the GRUB console settings, then the Limine activation on a Mac
# that opted in. On an image's first boot the Limine leaf asks for the boot
# rebuild the deferred setup does once after its last step, rather than
# building the UKI itself. Both leaves re-check the platform.

set -euo pipefail

if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != "image-first-boot" ]]; }; then
  echo "Usage: setup-boot [image-first-boot]" >&2
  exit 2
fi
setup=/usr/lib/omarchy-mac/boot/setup
if (( EUID == 0 )); then
  # Root takes nothing from its caller's environment.
  exec /usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/bin OMARCHY_PATH=/usr/share/omarchy \
    ${1:+OMARCHY_IMAGE_BOOT_REBUILD=/var/lib/omarchy/image/boot-rebuild} \
    /bin/bash -euo pipefail -c 'source "$1/grub-console.sh" || exit 1; source "$1/limine-boot.sh" || exit 1' setup-boot "$setup"
else
  # Unprivileged tests stage the package under a fixture root.
  root=${OMARCHY_MAC_BOOT_ROOT:-}
  export OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
  if (( $# == 1 )); then
    export OMARCHY_IMAGE_BOOT_REBUILD=$root/var/lib/omarchy/image/boot-rebuild
  fi
  source "$root$setup/grub-console.sh" || exit 1
  source "$root$setup/limine-boot.sh" || exit 1
fi
