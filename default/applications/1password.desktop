[Desktop Entry]
Name=1Password
# The launcher runs 1Password under XWayland at the display scale, so its
# fixed-size authorization prompt fits. It serves app launchers and the
# onepassword:// URL handler too.
Exec=omarchy-launch-1password %U
Terminal=false
Type=Application
Icon=1password
StartupWMClass=1Password
Comment=Password manager and secure wallet
MimeType=x-scheme-handler/onepassword;
Categories=Office;
